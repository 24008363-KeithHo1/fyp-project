<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Automated Invoicing & Payroll' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GASXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles.css">
</head>
<%
  const pageTitle = typeof title !== 'undefined' ? title : '';
  const isAuthPage = pageTitle === 'Login';
  const requestPath = typeof currentPath !== 'undefined' ? currentPath : '';
  const isFinancePage = requestPath.startsWith('/finance') ||
    requestPath === '/invoices' || requestPath.startsWith('/invoices/') ||
    requestPath === '/payroll' || requestPath === '/reports';
  const isHrPage = requestPath.startsWith('/hr') || requestPath === '/leave-requests';
  const isAdminPage = requestPath.startsWith('/admin') || requestPath === '/partner-customers';
  const financeLinks = [
    { label: 'Dashboard', href: '/finance/dashboard', icon: 'fa-chart-line', active: requestPath === '/finance/dashboard' },
    { label: 'Subscription Invoices', href: '/finance/subscription-invoices', icon: 'fa-file-contract', active: requestPath.startsWith('/finance/subscription-invoices') },
    { label: 'Invoices', href: '/invoices', icon: 'fa-file-invoice-dollar', active: requestPath.startsWith('/invoices') },
    { label: 'Supplier Payments', href: '/finance/payments', icon: 'fa-credit-card', active: requestPath === '/finance/payments' },
    { label: 'Bank Reconciliation', href: '/finance/bank-reconcile', icon: 'fa-building-columns', active: requestPath === '/finance/bank-reconcile' },
    { label: 'Payroll', href: '/payroll', icon: 'fa-money-check-dollar', active: requestPath === '/payroll' },
    { label: 'Approvals', href: '/finance/payroll-approvals', icon: 'fa-clipboard-check', active: requestPath.startsWith('/finance/payroll-approvals') },
    { label: 'Reports', href: '/reports', icon: 'fa-chart-column', active: requestPath === '/reports' },
    { label: 'Requests', href: '/finance/requests', icon: 'fa-inbox', active: requestPath === '/finance/requests' }
  ];
  const hrLinks = [
    { label: 'Dashboard', href: '/hr/dashboard', icon: 'fa-chart-line', active: requestPath === '/hr/dashboard' },
    { label: 'Employees', href: '/hr/employees', icon: 'fa-users', active: requestPath === '/hr/employees' },
    { label: 'Leave Requests', href: '/leave-requests', icon: 'fa-calendar-check', active: requestPath === '/leave-requests' },
    { label: 'Payroll Automation', href: '/hr/automation', icon: 'fa-gears', active: requestPath.startsWith('/hr/automation') },
    { label: 'Requests', href: '/hr/requests', icon: 'fa-inbox', active: requestPath === '/hr/requests' }
  ];
  const adminLinks = [
    { label: 'Dashboard', href: '/admin/dashboard', icon: 'fa-chart-line', active: requestPath === '/admin/dashboard' },
    { label: 'Partner Customers', href: '/partner-customers', icon: 'fa-handshake', active: requestPath === '/partner-customers' },
    { label: 'Manage Users', href: '/admin/users', icon: 'fa-users-gear', active: requestPath.startsWith('/admin/users') },
    { label: 'Create Account', href: '/admin/register', icon: 'fa-user-plus', active: requestPath === '/admin/register' },
    { label: 'Password Reset', href: '/admin/reset', icon: 'fa-key', active: requestPath === '/admin/reset' },
    { label: 'Audit Logs', href: '/admin/audit-logs', icon: 'fa-clock-rotate-left', active: requestPath.startsWith('/admin/audit-logs') },
    { label: 'Requests', href: '/admin/requests', icon: 'fa-inbox', active: requestPath === '/admin/requests' }
  ];
%>
<body class="<%= isAuthPage ? 'auth-body' : '' %>">
  <% if (!isAuthPage) { %>
    <header class="site-header <%= isFinancePage ? 'finance-site-header' : (isHrPage ? 'hr-site-header' : (isAdminPage ? 'admin-site-header' : 'py-3')) %>">
      <% if (isFinancePage) { %>
        <div class="container finance-brand-row">
          <a class="navbar-brand app-brand finance-brand mb-0" href="/finance/dashboard">
            <span class="app-brand-mark" aria-hidden="true"></span>
            <span class="app-brand-text">
              <span class="app-brand-name">Automated Invoicing &amp; Payroll System</span>
              <span class="app-brand-subtitle">Finance workspace</span>
            </span>
          </a>
        </div>
        <div class="container finance-nav-shell">
          <nav class="finance-nav" aria-label="Finance navigation">
            <ul class="finance-nav-list">
              <% financeLinks.forEach(link => { %>
                <li>
                  <a class="finance-nav-link <%= link.active ? 'active' : '' %>" href="<%= link.href %>" <% if (link.active) { %>aria-current="page"<% } %>>
                    <i class="fa-solid <%= link.icon %>" aria-hidden="true"></i>
                    <span><%= link.label %></span>
                  </a>
                </li>
              <% }); %>
            </ul>
          </nav>
          <div class="header-session-actions">
            <button id="backBtn-finance" class="btn btn-sm btn-outline-secondary" type="button" onclick="history.back()"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button id="logout" class="btn btn-sm btn-danger d-none">Logout</button>
          </div>
        </div>
      <% } else if (isHrPage) { %>
        <div class="container hr-brand-row">
          <a class="navbar-brand app-brand hr-brand mb-0" href="/hr/dashboard">
            <span class="app-brand-mark" aria-hidden="true"></span>
            <span class="app-brand-text">
              <span class="app-brand-name">Automated Invoicing &amp; Payroll System</span>
              <span class="app-brand-subtitle">HR workspace</span>
            </span>
          </a>
        </div>
        <div class="container hr-nav-shell">
          <nav class="hr-nav" aria-label="HR navigation">
            <ul class="hr-nav-list">
              <% hrLinks.forEach(link => { %>
                <li>
                  <a class="hr-nav-link <%= link.active ? 'active' : '' %>" href="<%= link.href %>" <% if (link.active) { %>aria-current="page"<% } %>>
                    <i class="fa-solid <%= link.icon %>" aria-hidden="true"></i>
                    <span><%= link.label %></span>
                  </a>
                </li>
              <% }); %>
            </ul>
          </nav>
          <div class="header-session-actions">
            <button id="backBtn-hr" class="btn btn-sm btn-outline-secondary" type="button" onclick="history.back()"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button id="logout" class="btn btn-sm btn-danger d-none">Logout</button>
          </div>
        </div>
      <% } else if (isAdminPage) { %>
        <div class="container admin-brand-row">
          <a class="navbar-brand app-brand admin-brand mb-0" href="/admin/dashboard">
            <span class="app-brand-mark" aria-hidden="true"></span>
            <span class="app-brand-text">
              <span class="app-brand-name">Automated Invoicing &amp; Payroll System</span>
              <span class="app-brand-subtitle">Admin workspace</span>
            </span>
          </a>
        </div>
        <div class="container admin-nav-shell">
          <nav class="admin-nav" aria-label="Admin navigation">
            <ul class="admin-nav-list">
              <% adminLinks.forEach(link => { %>
                <li>
                  <a class="admin-nav-link <%= link.active ? 'active' : '' %>" href="<%= link.href %>" <% if (link.active) { %>aria-current="page"<% } %>>
                    <i class="fa-solid <%= link.icon %>" aria-hidden="true"></i>
                    <span><%= link.label %></span>
                  </a>
                </li>
              <% }); %>
            </ul>
          </nav>
          <div class="header-session-actions">
            <button id="backBtn-admin" class="btn btn-sm btn-outline-secondary" type="button" onclick="history.back()"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button id="logout" class="btn btn-sm btn-danger d-none">Logout</button>
          </div>
        </div>
      <% } else { %>
        <div class="container d-flex justify-content-between align-items-center">
          <a class="navbar-brand app-brand mb-0 h4" href="/dashboard">
            <span class="app-brand-mark" aria-hidden="true"></span>
            <span class="app-brand-text">
              <span class="app-brand-name">Automated Invoicing & Payroll</span>
              <span class="app-brand-subtitle">Unified finance and HR workspace</span>
            </span>
          </a>
          <div class="header-session-actions">
            <button id="backBtn-generic" class="btn btn-sm btn-outline-secondary" type="button" onclick="history.back()"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back</button>
            <button id="logout" class="btn btn-sm btn-danger d-none">Logout</button>
          </div>
        </div>
      <% } %>
    </header>

    <script>
      // Toggle Login/Logout visibility based on token
      (function(){
        const logoutBtn = document.getElementById('logout');
        function updateAuthUI(){
          const hasToken = !!localStorage.getItem('token');
          if (hasToken) logoutBtn.classList.remove('d-none');
          else logoutBtn.classList.add('d-none');
        }
        updateAuthUI();
        logoutBtn?.addEventListener('click', ()=>{
          localStorage.removeItem('token');
          // Also clear the cookie copy — middlewares/auth.js falls back to
          // reading the token from the cookie when no Authorization header
          // is present (e.g. plain page navigation), so clearing only
          // localStorage left the old session usable via that cookie
          // until it naturally expired.
          document.cookie = 'token=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';
          updateAuthUI();
          location = '/login';
        });
        window.addEventListener('storage', (e)=>{ if (e.key === 'token') updateAuthUI(); });
      })();
    </script>
    <main class="app-container container my-4">
  <% } else { %>
    <main class="auth-main">
  <% } %>
