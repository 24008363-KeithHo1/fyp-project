      </a>
      <a href="/payroll" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-briefcase"></i></div>
        <div class="fd-action-label">Payroll</div>
        <div class="fd-action-desc">Manage payroll runs and settings.</div>
      </a>
      <a href="/finance/requests" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-envelope"></i></div>
        <div class="fd-action-label">Requests</div>
        <div class="fd-action-desc">Submit HR or finance requests.</div>
      </a>
    </div>
  </div>

</div><!-- /fd-page -->

<script>
let paymentPieChart, monthlyRevenueChart;

/* ── stripe callback alert ── */
const dashParams = new URLSearchParams(window.location.search);
if (dashParams.get('payment') === 'stripe') {
  const el = document.getElementById('paymentSuccessAlert');
  const status = dashParams.get('status');
  const ok = !status || status === 'paid' || status === 'complete';
  el.style.display = 'block';
  el.classList.add(ok ? 'alert-success' : 'alert-warning');
  el.innerHTML = ok
    ? '<i class="fa-solid fa-circle-check" style="margin-right:.5rem"></i>Stripe payment completed successfully — invoice marked Paid.'
    : '<i class="fa-solid fa-triangle-exclamation" style="margin-right:.5rem"></i>Stripe returned but the payment could not be auto-confirmed. Check invoice and payment history.';
}

/* ── helpers ── */
function money(v, cur) {
  return `${cur || 'SGD'} ${Number(v||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`;
}
function badgeClass(s) {
  if (s === 'Paid')    return 'fd-badge-paid';
  if (s === 'Failed')  return 'fd-badge-failed';
  if (s === 'Pending') return 'fd-badge-pending';
  return 'fd-badge-pending';
}

/* ── charts ── */
const chartDefaults = {
  color: '#636b80',
  font: { family: "'DM Sans', sans-serif" }
};
Chart.defaults.color = chartDefaults.color;
Chart.defaults.font.family = chartDefaults.font.family;

function renderPie(stripe, paypal) {
  if (paymentPieChart) paymentPieChart.destroy();
  paymentPieChart = new Chart(document.getElementById('paymentPieChart'), {
    type: 'doughnut',
    data: {
      labels: ['Stripe', 'PayPal'],
      datasets: [{
        data: [stripe, paypal],
        backgroundColor: ['#635bff', '#0070ba'],
        borderColor: '#13161e',
        borderWidth: 3,
        hoverOffset: 6
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '65%',
      plugins: {
        legend: {
          position: 'bottom',
          labels: { padding: 20, usePointStyle: true, pointStyleWidth: 8 }
        },
        tooltip: {
          callbacks: {
            label: ctx => {
              const total = stripe + paypal;
              const pct   = total ? Math.round((ctx.raw/total)*100) : 0;
              return `${ctx.label}: ${pct}% (${money(ctx.raw)})`;
            }
          }
        }
      }
    }
  });
}

function renderMonthly(monthlyRevenue) {
  const labels = Object.keys(monthlyRevenue || {});
  const values = Object.values(monthlyRevenue || {}).map(Number);
  if (monthlyRevenueChart) monthlyRevenueChart.destroy();
  monthlyRevenueChart = new Chart(document.getElementById('monthlyRevenueChart'), {
    type: 'bar',
    data: {
      labels: labels.map(lbl => {
        const p = String(lbl).split('-');
        if (p.length !== 2) return lbl;
        return new Date(+p[0], +p[1]-1, 1).toLocaleString(undefined, { month: 'short', year: '2-digit' });
      }),
      datasets: [{
        label: 'Revenue',
        data: values,
        backgroundColor: ctx => {
          const g = ctx.chart.ctx.createLinearGradient(0, 0, 0, 260);
          g.addColorStop(0, 'rgba(61,214,140,.85)');
          g.addColorStop(1, 'rgba(61,214,140,.15)');
          return g;
        },
        borderColor: '#3dd68c',
        borderWidth: 1,
        borderRadius: 6,
        borderSkipped: false
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { grid: { color: 'rgba(255,255,255,0.04)' }, ticks: { font: { size: 12 } } },
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(255,255,255,0.06)' },
          ticks: { callback: v => money(v), font: { size: 11 } }
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: { callbacks: { label: ctx => money(ctx.raw) } }
      }
    }
  });
}

function renderPayments(payments) {
  const tbody = document.getElementById('recentPaymentsBody');
  if (!payments || !payments.length) {
    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--fd-muted);padding:2rem">No payments recorded yet</td></tr>';
    return;
  }
  tbody.innerHTML = payments.map(p => `
    <tr>
      <td class="mono">${p.invoiceNumber || '—'}</td>
      <td>
        <span style="display:inline-flex;align-items:center;gap:.4rem">
          ${p.method === 'Stripe'  ? '<i class="fa-brands fa-stripe"  style="color:var(--fd-stripe)"></i>' : ''}
          ${p.method === 'PayPal'  ? '<i class="fa-brands fa-paypal"  style="color:var(--fd-paypal)"></i>' : ''}
          ${p.method || ''}
        </span>
      </td>
      <td class="amount">${money(p.amount, p.currency)}</td>
      <td><span class="fd-badge ${badgeClass(p.status)}">${p.status || ''}</span></td>
    </tr>
  `).join('');
}

function renderAlerts(totals) {
  const items = [];
  if ((totals.overdueInvoiceCount  || 0) > 0) items.push(`${totals.overdueInvoiceCount} overdue invoice${totals.overdueInvoiceCount===1?'':'s'}`);
  if ((totals.failedPayPalCount    || 0) > 0) items.push(`${totals.failedPayPalCount} failed PayPal transaction${totals.failedPayPalCount===1?'':'s'}`);
  if ((totals.payrollDueSoonCount  || 0) > 0) items.push(`${totals.payrollDueSoonCount} payroll run${totals.payrollDueSoonCount===1?'':'s'} due in 2 days`);
  const c = document.getElementById('financeAlerts');
  if (!items.length) {
    c.innerHTML = '<div class="fd-no-alerts"><i class="fa-solid fa-circle-check" style="color:var(--fd-accent);margin-right:.5rem"></i>No active finance alerts.</div>';
    return;
  }
  c.innerHTML = items.map(msg => `
    <div class="fd-alert-item">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span>${msg}</span>
    </div>
  `).join('');
}

/* ── data load ── */
async function loadFinanceDashboard() {
  try {
    const res = await fetch('/api/reports/summary', { headers: { authorization: 'Bearer ' + token } });
    if (!res.ok) return;
    const summary = await res.json();
    const totals  = summary.totals || {};
    const pr      = (summary.charts && summary.charts.paymentMethodRevenue) || {};
    const stripe  = Number(pr.Stripe  || 0);
    const paypal  = Number(pr.PayPal  || 0);

    document.getElementById('financeTotalRevenue').textContent   = money(totals.paidRevenue);
    document.getElementById('financePaidInvoices').textContent   = totals.paidInvoiceCount    || 0;
    document.getElementById('financePendingPayments').textContent= totals.pendingPaymentCount  || 0;
    document.getElementById('financeOverdueInvoices').textContent= totals.overdueInvoiceCount  || 0;
    document.getElementById('stripeRevenue').textContent         = money(stripe);
    document.getElementById('paypalRevenue').textContent         = money(paypal);

    renderPie(stripe, paypal);
    renderPayments(summary.recentTransactions || []);
    renderAlerts(totals);
    renderMonthly((summary.charts && summary.charts.monthlyRevenue) || {});
  } catch (e) {
    console.error('Finance dashboard error:', e);
  }
}

loadFinanceDashboard();
</script>

