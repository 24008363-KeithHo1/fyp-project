<%- include('../partials/header', { title: 'My Profile' }) %>
<%- include('../partials/navbar') %>

<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';

function setProfileImage(url) {
  const profileImg = document.getElementById('profileImage');
  const fallback = document.getElementById('avatarFallback');
  if (url) {
    profileImg.src = url;
    profileImg.classList.remove('d-none');
    fallback.classList.add('d-none');
  } else {
    profileImg.classList.add('d-none');
    fallback.classList.remove('d-none');
  }
}

async function loadProfile() {
  const res = await fetch('/api/auth/me', { headers: { authorization: 'Bearer ' + token } });
  if (!res.ok) return location = '/login';
  const data = await res.json();
  const user = data.user;
  document.getElementById('name').value = user.name || '';
  document.getElementById('email').value = user.email || '';
  document.getElementById('phone').value = user.phone || '';
  document.getElementById('title').value = user.title || '';
  document.getElementById('department').value = user.department || '';
  document.getElementById('address').value = user.address || '';
  document.getElementById('bio').value = user.bio || '';
  document.getElementById('profileName').textContent = user.name || 'Staff member';
  document.getElementById('profileTitle').textContent = user.title || 'Staff Member';
  document.getElementById('profileDepartment').textContent = user.department || 'General Office';
  document.getElementById('profileEmail').textContent = user.email || '-';
  document.getElementById('profilePhone').textContent = user.phone || '-';
  document.getElementById('profileAddress').textContent = user.address || '-';
  document.getElementById('profileBio').textContent = user.bio || 'Add a short summary about yourself so your team can know more about you.';
  setProfileImage(user.profileImage);
}

// legacy upload helper removed — profile image is uploaded together with the form

function previewImage() {
  const fileInput = document.getElementById('profileImageInput');
  const file = fileInput.files[0];
  if (file) {
    setProfileImage(URL.createObjectURL(file));
  }
}

async function saveProfile(event) {
  event.preventDefault();
  const statusEl = document.getElementById('statusMessage');
  const form = document.getElementById('profileForm');
  const submitBtn = form ? form.querySelector('button[type="submit"]') : null;
  const originalText = submitBtn ? submitBtn.textContent : null;
  if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Saving...'; }
  try {
    const fd = new FormData(form);
    const res = await fetch('/api/auth/profile', {
      method: 'POST',
      headers: { authorization: 'Bearer ' + token },
      body: fd
    });
    let data;
    try { data = await res.json(); } catch (e) { data = { error: 'Invalid server response' }; }
    if (!res.ok) {
      statusEl.textContent = data.error || 'Unable to update profile';
      statusEl.className = 'alert alert-danger';
      return;
    }
    statusEl.textContent = 'Profile updated successfully.';
    statusEl.className = 'alert alert-success';
    if (data.user && data.user.profileImage) setProfileImage(data.user.profileImage);
    loadProfile();
  } catch (err) {
    statusEl.textContent = err.message || 'Request failed';
    statusEl.className = 'alert alert-danger';
  } finally {
    if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = originalText || 'Save profile'; }
  }
}

window.addEventListener('DOMContentLoaded', () => {
  loadProfile();
  const imageInput = document.getElementById('profileImageInput');
  if (imageInput) imageInput.addEventListener('change', previewImage);
  const profileForm = document.getElementById('profileForm');
  if (profileForm) profileForm.addEventListener('submit', saveProfile);
});
</script>

<div class="profile-page">
  <div class="profile-banner">
    <div class="profile-banner-overlay"></div>
    <div class="profile-avatar" id="profileAvatar">
      <span id="avatarFallback">👤</span>
      <img id="profileImage" class="profile-image d-none rounded-circle" alt="Profile photo">
    </div>
  </div>

  <div class="profile-main row gx-4 gy-4">
    <div class="col-lg-4">
      <div class="profile-card shadow-sm">
        <div class="profile-header">
          <h1 id="profileName">Staff Member</h1>
          <p id="profileTitle" class="profile-subtitle">Staff Member</p>
        </div>
        <p id="profileBio" class="profile-bio">Add a short summary about yourself so your team can know more about you.</p>
        <div class="profile-details">
          <div><strong>Department</strong><span id="profileDepartment">General Office</span></div>
          <div><strong>Email</strong><span id="profileEmail">-</span></div>
          <div><strong>Phone</strong><span id="profilePhone">-</span></div>
          <div><strong>Location</strong><span id="profileAddress">-</span></div>
        </div>
      </div>
    </div>

    <div class="col-lg-8">
      <div class="profile-edit-card shadow-sm p-4">
        <div class="d-flex justify-content-between align-items-start mb-4">
          <div>
            <h2>Profile details</h2>
            <p class="text-muted">Keep your information up to date for better team collaboration.</p>
          </div>
        </div>
        <div id="statusMessage" role="status"></div>
        <form id="profileForm" enctype="multipart/form-data">
          <div class="mb-4 profile-photo-uploader">
            <label for="profileImageInput" class="form-label">Profile photo</label>
            <div class="d-flex flex-wrap gap-2 align-items-center">
              <input type="file" id="profileImageInput" name="profileImage" accept="image/*" class="form-control form-control-sm" style="max-width:260px;">
              <span class="text-muted">PNG, JPG, GIF, WEBP</span>
            </div>
            <div id="uploadStatus" class="mt-2"></div>
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label for="name" class="form-label">Full name</label>
              <input type="text" id="name" name="name" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label for="email" class="form-label">Email address</label>
              <input type="email" id="email" name="email" class="form-control" required>
            </div>
            <div class="col-md-6">
              <label for="phone" class="form-label">Phone</label>
              <input type="text" id="phone" name="phone" class="form-control">
            </div>
            <div class="col-md-6">
              <label for="title" class="form-label">Job title</label>
              <input type="text" id="title" name="title" class="form-control">
            </div>
            <div class="col-md-12">
              <label for="department" class="form-label">Department</label>
              <input type="text" id="department" name="department" class="form-control">
            </div>
            <div class="col-md-12">
              <label for="address" class="form-label">Address</label>
              <input type="text" id="address" name="address" class="form-control">
            </div>
            <div class="col-md-12">
              <label for="bio" class="form-label">About you</label><br>
              <input type="text" id="bio" class="form-control" placeholder="A short profile summary">
            </div>
          </div>
          <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">Save profile</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
