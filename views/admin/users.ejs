<%- include('../partials/header', { title: 'Manage Users' }) -%>
<%- include('../partials/navbar') -%>
<%- include('./_admin_nav') -%>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root { --au-text:#102033; --au-muted:#64748b; --au-border:rgba(148,163,184,.18); --au-radius:8px; --au-shadow:0 14px 30px rgba(15,23,42,.08); }
  body:has(.admin-users-workspace){background:linear-gradient(135deg,#f7faf8 0%,#e8f7ee 48%,#f8fbf9 100%)!important;color:var(--au-text);font-family:'Sora',sans-serif}
  .admin-users-workspace{max-width:1220px;margin:0 auto;padding:1.1rem;box-sizing:border-box;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(248,250,252,.94)),linear-gradient(90deg,rgba(6,182,212,.12),rgba(124,58,237,.12));animation:admin-users-in .4s cubic-bezier(.22,.8,.36,1) both}
  @keyframes admin-users-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .admin-users-hero{position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;padding:1.35rem;border:1px solid rgba(37,99,235,.18);border-radius:var(--au-radius);background:linear-gradient(135deg,rgba(15,23,42,.94),rgba(37,99,235,.86) 46%,rgba(11,143,62,.82));box-shadow:0 18px 38px rgba(15,23,42,.16)}
  .admin-users-hero::after{position:absolute;right:-56px;bottom:-84px;width:260px;height:150px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.03));content:'';transform:rotate(-18deg)}
  .admin-users-hero>*{position:relative;z-index:1}.admin-users-eyebrow{display:inline-flex;align-items:center;gap:.42rem;min-height:24px;margin:0 0 .3rem;padding:.25rem .58rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-size:.72rem;font-weight:700}.admin-users-title{margin:0;color:#fff;font-size:1.75rem;font-weight:700;line-height:1.2}.admin-users-subtitle{max-width:62ch;margin:.35rem 0 0;color:#fff;font-size:.875rem;line-height:1.5;opacity:.88}.admin-users-meta{display:inline-flex;align-items:center;gap:.45rem;padding:.52rem .78rem;border-radius:8px;background:rgba(255,255,255,.14);color:#fff;font-size:.78rem;font-weight:600}
  .admin-users-panel{overflow:hidden;border:1px solid var(--au-border);border-radius:var(--au-radius);background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(240,249,255,.78));box-shadow:var(--au-shadow);transition:border-color .16s ease,box-shadow .16s ease}.admin-users-panel:hover{border-color:rgba(6,182,212,.28);box-shadow:0 20px 36px rgba(15,23,42,.12)}.admin-users-panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.05rem 1.2rem;border-bottom:1px solid rgba(148,163,184,.16)}.admin-users-panel-title{display:flex;align-items:center;gap:.52rem;margin:0;color:var(--au-text);font-size:.95rem;font-weight:700}.admin-users-panel-title i{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#0f766e,#22c55e);color:#fff;font-size:.8rem}.admin-users-panel-count{color:var(--au-muted);font-size:.76rem}
  .admin-table-wrap{border:0;border-radius:0;box-shadow:none}.admin-users-table{margin:0;border-collapse:separate;border-spacing:0}.admin-users-table thead th{background:linear-gradient(135deg,#e0f2fe,#ecfdf3)!important;color:#0f172a;font-size:.76rem;font-weight:800;letter-spacing:0;text-transform:uppercase}.admin-users-table th,.admin-users-table td{padding:.78rem .8rem;border-color:rgba(148,163,184,.13);vertical-align:middle}.admin-users-table tbody tr{transition:background .14s ease,box-shadow .14s ease}.admin-users-table tbody tr:hover{box-shadow:inset 4px 0 0 #06b6d4}.admin-users-table tbody tr:hover>*{background:#f0f9ff}.admin-users-self-row>*{background:#f0fdf4}.admin-user-id{color:#1d4ed8;font-family:'DM Mono',monospace;font-size:.78rem}.admin-user-name{color:var(--au-text);font-weight:700}.admin-role{display:inline-flex;align-items:center;padding:.28rem .55rem;border-radius:999px;font-size:.72rem;font-weight:800}.admin-role-Admin{background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff}.admin-role-Finance{background:linear-gradient(135deg,#0369a1,#06b6d4);color:#fff}.admin-role-HR{background:linear-gradient(135deg,#0f766e,#22c55e);color:#fff}.admin-role-Staff{background:#e2e8f0;color:#475569}.admin-active{display:inline-flex;align-items:center;gap:.35rem;padding:.28rem .55rem;border-radius:999px;font-size:.72rem;font-weight:800}.admin-active::before{width:6px;height:6px;border-radius:50%;background:currentColor;content:''}.admin-active-yes{background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff}.admin-active-no{background:#e2e8f0;color:#475569}.admin-edit-btn{display:inline-flex;align-items:center;justify-content:center;gap:.36rem;min-height:32px;padding:.38rem .58rem;border:0;border-radius:7px;background:linear-gradient(135deg,#0b8f3e,#84cc16);box-shadow:0 8px 18px rgba(11,143,62,.18);color:#fff;font-size:.72rem;font-weight:800;text-decoration:none}.admin-edit-btn:hover{background:linear-gradient(135deg,#087a34,#65a30d);color:#fff;transform:translateY(-1px)}
  @media(max-width:720px){.admin-users-workspace{padding:.85rem}.admin-users-hero{padding:1rem;align-items:flex-start}.admin-users-panel-head{padding:1rem}}
</style>

<section class="admin-users-workspace">
  <header class="admin-users-hero">
    <div>
      <p class="admin-users-eyebrow"><i class="fa-solid fa-users-gear" aria-hidden="true"></i> Access administration</p>
      <h1 class="admin-users-title">Manage Users</h1>
      <p class="admin-users-subtitle">Review account access, assign operational roles, and keep user status current.</p>
    </div>
    <span class="admin-users-meta"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> <%= users.length %> accounts</span>
  </header>

  <section class="admin-users-panel" aria-labelledby="userRegisterTitle">
    <div class="admin-users-panel-head">
      <h2 class="admin-users-panel-title" id="userRegisterTitle"><i class="fa-solid fa-list-check" aria-hidden="true"></i> User Register</h2>
      <span class="admin-users-panel-count">Role and status controls</span>
    </div>
    <div class="table-responsive admin-table-wrap">
      <table class="table table-hover align-middle mb-0 admin-users-table">
      <thead>
        <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% users.forEach(function(u){ %>
          <tr class="<%= u.id === currentUserId ? 'admin-users-self-row' : '' %>">
            <td class="admin-user-id">#<%= u.id %></td>
            <td class="admin-user-name"><%= u.name %> <% if (u.id === currentUserId) { %><span class="badge bg-secondary">You</span><% } %></td>
            <td><%= u.email %></td>
            <td><span class="admin-role admin-role-<%= u.role %>"><%= u.role %></span></td>
            <td><span class="admin-active admin-active-<%= u.isActive ? 'yes' : 'no' %>"><%= u.isActive ? 'Active' : 'Inactive' %></span></td>
            <td><a class="admin-edit-btn" href="/admin/users/<%= u.id %>/edit"><i class="fa-solid fa-pen" aria-hidden="true"></i> Edit</a></td>
          </tr>
        <% }) %>
      </tbody>
      </table>
    </div>
  </section>
</section>

<%- include('../partials/footer') -%>
