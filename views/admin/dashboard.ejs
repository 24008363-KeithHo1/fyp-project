<%- include('../partials/header', { title: 'Admin Dashboard' }) %>
<%- include('../partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
try {
  const payload = JSON.parse(atob(token.split('.')[1]));
  if (payload.role !== 'Admin') location = '/dashboard';
} catch (e) { location = '/login'; }
</script>

<style>
:root {
  --ad-bg: #f0fdf4;
  --ad-surface: #ffffff;
  --ad-surface2: #f8fdf9;
  --ad-border: #d1fae5;
  --ad-border2: #bbf7d0;
  --ad-text: #0f1c14;
  --ad-muted: #6b8c78;
  --ad-accent: #16a34a;
  --ad-accent2: #22c55e;
  --ad-shadow-sm: 0 1px 3px rgba(6,78,39,.08), 0 1px 2px rgba(6,78,39,.04);
  --ad-shadow-md: 0 4px 16px rgba(6,78,39,.1), 0 2px 6px rgba(6,78,39,.06);
  --ad-radius: 18px;
}

body {
  background: var(--ad-bg) !important;
  color: var(--ad-text);
  font-family: 'Sora', sans-serif;
}

.admin-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
  animation: admin-in .45s cubic-bezier(.22,.8,.36,1) both;
}

@keyframes admin-in {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}

.admin-hero {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid var(--ad-border);
}

.admin-hero-left {
  display: flex;
  flex-direction: column;
  gap: .35rem;
}

.admin-kicker {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  width: fit-content;
  padding: .35rem .7rem;
  border-radius: 999px;
  background: #dcfce7;
  color: #15803d;
  border: 1px solid var(--ad-border2);
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.admin-title {
  font-size: 1.8rem;
  line-height: 1.15;
  margin: 0;
  color: var(--ad-text);
  font-weight: 700;
}

.admin-subtitle {
  margin: 0;
  font-size: .92rem;
  color: var(--ad-muted);
  max-width: 60ch;
}

.admin-meta {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .5rem .8rem;
  border-radius: 999px;
  border: 1px solid var(--ad-border);
  background: var(--ad-surface);
  color: var(--ad-muted);
  font-size: .8rem;
  font-weight: 500;
  box-shadow: var(--ad-shadow-sm);
}

.admin-kpis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.admin-kpi {
  background: var(--ad-surface);
  border: 1px solid var(--ad-border);
  border-radius: var(--ad-radius);
  padding: 1.15rem 1.25rem;
  box-shadow: var(--ad-shadow-sm);
  transition: transform .15s, box-shadow .2s;
}

.admin-kpi:hover {
  transform: translateY(-2px);
  box-shadow: var(--ad-shadow-md);
}

.admin-kpi-icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: .9rem;
  margin-bottom: .85rem;
  background: rgba(61,214,140,.12);
  color: var(--ad-accent);
}

.admin-kpi.kpi-overdue .admin-kpi-icon {
  background: rgba(240,82,82,.12);
  color: #dc2626;
}

.admin-kpi-label {
  font-size: .78rem;
  color: var(--ad-muted);
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-bottom: .35rem;
}

.admin-kpi-value {
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--ad-text);
  line-height: 1;
}

.admin-kpi-sub {
  font-size: .78rem;
  color: var(--ad-muted);
  margin-top: .35rem;
}

.dashboard-cards {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
}

.card-link {
  display: block;
  text-decoration: none;
  height: 100%;
}

.card-link .card {
  height: 100%;
  border: 1px solid var(--ad-border);
  border-radius: var(--ad-radius);
  background: var(--ad-surface);
  box-shadow: var(--ad-shadow-sm);
  overflow: hidden;
  transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease, background .16s ease;
}

.card-link .card::before {
  content: '';
  display: block;
  height: 3px;
  background: linear-gradient(90deg, var(--ad-accent), rgba(34,197,94,.2));
}

.card-link:hover .card {
  transform: translateY(-3px);
  box-shadow: var(--ad-shadow-md);
  border-color: var(--ad-border2);
  background: var(--ad-surface2);
}

.card-body {
  display: flex;
  align-items: flex-start;
  gap: .95rem;
  padding: 1.2rem;
  text-align: left;
}

.card-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.15rem;
  background: #dcfce7;
  color: #15803d;
  flex-shrink: 0;
  box-shadow: inset 0 0 0 1px rgba(21,128,61,.08);
}

.card-title {
  margin: 0 0 .35rem;
  color: var(--ad-text);
  font-size: .98rem;
  font-weight: 700;
}

.card-text {
  margin: 0;
  color: var(--ad-muted);
  font-size: .82rem;
  line-height: 1.45;
}

@media (max-width: 1100px) {
  .dashboard-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .admin-kpis { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 640px) {
  .admin-page { padding: 1.25rem 1rem 3rem; }
  .dashboard-cards { grid-template-columns: 1fr; }
  .admin-kpis { grid-template-columns: 1fr; }
  .admin-title { font-size: 1.45rem; }
}

:root {
  --ad-bg: #f8fafc;
  --ad-surface: #ffffff;
  --ad-surface2: #f8fafc;
  --ad-border: rgba(148, 163, 184, .18);
  --ad-border2: rgba(37, 99, 235, .28);
  --ad-text: #102033;
  --ad-muted: #64748b;
  --ad-accent: #0b8f3e;
  --ad-accent2: #84cc16;
  --ad-shadow-sm: 0 14px 30px rgba(15, 23, 42, .08);
  --ad-shadow-md: 0 22px 38px rgba(15, 23, 42, .16);
  --ad-radius: 8px;
}

body {
  background: linear-gradient(135deg, #f7faf8 0%, #e8f7ee 48%, #f8fbf9 100%) !important;
}

.admin-page {
  max-width: 1220px;
  padding: 1.1rem;
  box-sizing: border-box;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(248, 250, 252, .94)),
    linear-gradient(90deg, rgba(6, 182, 212, .12), rgba(124, 58, 237, .12));
}

.admin-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 1rem;
  padding: 1.35rem;
  border: 1px solid rgba(37, 99, 235, .18);
  border-radius: var(--ad-radius);
  background: linear-gradient(135deg, rgba(15, 23, 42, .94), rgba(37, 99, 235, .86) 46%, rgba(11, 143, 62, .82));
  box-shadow: 0 18px 38px rgba(15, 23, 42, .16);
}

.admin-hero::after {
  position: absolute;
  right: -56px;
  bottom: -84px;
  width: 260px;
  height: 150px;
  background: linear-gradient(135deg, rgba(255, 255, 255, .18), rgba(255, 255, 255, .03));
  content: '';
  transform: rotate(-18deg);
}

.admin-hero > * {
  position: relative;
  z-index: 1;
}

.admin-kicker {
  border-color: rgba(255, 255, 255, .28);
  background: rgba(255, 255, 255, .12);
  color: #ffffff;
  letter-spacing: 0;
}

.admin-title,
.admin-subtitle {
  color: #ffffff;
}

.admin-subtitle { opacity: .88; }

.admin-meta {
  border: 0;
  border-radius: 8px;
  background: rgba(255, 255, 255, .14);
  box-shadow: none;
  color: #ffffff;
}

.admin-kpis {
  margin-bottom: 1rem;
}

.admin-kpi {
  position: relative;
  min-height: 118px;
  padding: 1rem 1rem 1.1rem;
  overflow: hidden;
  border: 0;
  border-radius: 8px;
  color: #ffffff;
  box-shadow: 0 16px 30px rgba(15, 23, 42, .13);
  transition: transform .16s ease, box-shadow .16s ease, filter .16s ease;
}

.admin-kpi:hover {
  transform: translateY(-4px);
  filter: saturate(1.04);
  box-shadow: var(--ad-shadow-md);
}

.admin-kpi::after {
  position: absolute;
  right: -24px;
  bottom: -36px;
  width: 150px;
  height: 84px;
  background: linear-gradient(135deg, rgba(255, 255, 255, .18), rgba(255, 255, 255, .04));
  content: '';
  transform: rotate(-18deg);
}

.admin-kpi > * {
  position: relative;
  z-index: 1;
}

.admin-kpi.kpi-users { background: linear-gradient(135deg, #0f766e, #22c55e); }
.admin-kpi.kpi-invoices { background: linear-gradient(135deg, #4f46e5, #8b5cf6); }
.admin-kpi.kpi-paid { background: linear-gradient(135deg, #0369a1, #06b6d4); }
.admin-kpi.kpi-overdue { background: linear-gradient(135deg, #c2410c, #f59e0b); }

.admin-kpi-icon,
.admin-kpi.kpi-overdue .admin-kpi-icon {
  width: 34px;
  height: 34px;
  margin-bottom: .15rem;
  border-radius: 8px;
  background: rgba(255, 255, 255, .16);
  color: #ffffff;
}

.admin-kpi-label,
.admin-kpi-value,
.admin-kpi-sub {
  color: #ffffff;
}

.admin-kpi-label {
  font-size: .75rem;
  font-weight: 800;
  letter-spacing: 0;
  opacity: .82;
}

.admin-kpi-value { font-family: 'DM Mono', monospace; font-size: 1.45rem; }
.admin-kpi-sub { font-size: .74rem; opacity: .82; }

.admin-actions-panel {
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, .18);
  border-radius: 8px;
  background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(240, 249, 255, .78));
  box-shadow: var(--ad-shadow-sm);
  transition: border-color .16s ease, box-shadow .16s ease;
}

.admin-actions-panel:hover {
  border-color: rgba(6, 182, 212, .28);
  box-shadow: 0 20px 36px rgba(15, 23, 42, .12);
}

.admin-actions-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.15rem 1.25rem;
  border-bottom: 1px solid rgba(148, 163, 184, .16);
}

.admin-actions-title {
  display: flex;
  align-items: center;
  gap: .55rem;
  margin: 0;
  color: var(--ad-text);
  font-size: .95rem;
  font-weight: 700;
}

.admin-actions-title i {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 8px;
  background: linear-gradient(135deg, #0f766e, #22c55e);
  color: #ffffff;
  font-size: .8rem;
}

.admin-actions-caption { color: var(--ad-muted); font-size: .76rem; }

.dashboard-cards {
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 1rem;
  padding: 1.25rem;
}

.card-link .card {
  min-height: 148px;
  border: 1px solid rgba(148, 163, 184, .18);
  border-radius: 8px;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, .9);
}

.card-link .card::before { display: none; }

.card-link:hover .card {
  transform: translateY(-2px);
  border-color: rgba(37, 99, 235, .24);
  background: #ffffff;
  box-shadow: 0 14px 28px rgba(15, 23, 42, .09);
}

.dashboard-cards .card-body {
  align-items: center;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

.dashboard-cards .card-icon {
  width: 44px;
  height: 44px;
  border-radius: 8px;
  background: #dcfce7;
  color: #15803d;
  box-shadow: none;
}

.dashboard-cards .col:nth-child(2) .card-icon { background: #dbeafe; color: #1d4ed8; }
.dashboard-cards .col:nth-child(3) .card-icon { background: #fef3c7; color: #b45309; }
.dashboard-cards .col:nth-child(4) .card-icon { background: #ede9fe; color: #6d28d9; }
.dashboard-cards .col:nth-child(5) .card-icon { background: #fee2e2; color: #b91c1c; }

.card-link:hover .card-icon {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
}

.dashboard-cards .card-title { color: var(--ad-text); font-size: .82rem; }
.dashboard-cards .card-text { color: var(--ad-muted); font-size: .72rem; }

@media (max-width: 1100px) {
  .dashboard-cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}

@media (max-width: 720px) {
  .admin-page { padding: .85rem; }
  .admin-hero { padding: 1rem; }
  .dashboard-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); padding: 1rem; }
}

@media (max-width: 480px) {
  .admin-kpis,
  .dashboard-cards { grid-template-columns: 1fr; }
  .admin-actions-head { padding: 1rem; }
  .admin-actions-caption { display: none; }
}
</style>

<section class="admin-page">
  <div class="admin-hero">
    <div class="admin-hero-left">
      <span class="admin-kicker"><i class="fa-solid fa-shield-halved"></i> Administration</span>
      <h1 class="admin-title">Admin Dashboard</h1>
      <p class="admin-subtitle">Overview and quick actions for administrators.</p>
    </div>
    <div class="admin-meta"><i class="fa-solid fa-circle-check"></i> System control center</div>
  </div>

<% if (stats) { %>
  <div class="admin-kpis">
    <div class="admin-kpi kpi-users">
      <div class="admin-kpi-icon"><i class="fa-solid fa-users"></i></div>
      <div class="admin-kpi-label">Total Users</div>
      <div class="admin-kpi-value"><%= stats.totalUsers %></div>
      <div class="admin-kpi-sub"><%= stats.adminCount %> Admin · <%= stats.financeCount %> Finance · <%= stats.hrCount %> HR · <%= stats.staffCount %> Staff</div>
    </div>
    <div class="admin-kpi kpi-invoices">
      <div class="admin-kpi-icon"><i class="fa-solid fa-file-invoice"></i></div>
      <div class="admin-kpi-label">Total Invoices</div>
      <div class="admin-kpi-value"><%= stats.totalInvoices %></div>
      <div class="admin-kpi-sub">All records</div>
    </div>
    <div class="admin-kpi kpi-paid">
      <div class="admin-kpi-icon"><i class="fa-solid fa-file-circle-check"></i></div>
      <div class="admin-kpi-label">Paid</div>
      <div class="admin-kpi-value"><%= stats.paidInvoices %></div>
      <div class="admin-kpi-sub">Settled invoices</div>
    </div>
    <div class="admin-kpi kpi-overdue">
      <div class="admin-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <div class="admin-kpi-label">Overdue</div>
      <div class="admin-kpi-value"><%= stats.overdueInvoices %></div>
      <div class="admin-kpi-sub">SGD <%= stats.outstandingAmount.toFixed(2) %> outstanding</div>
    </div>
  </div>
  <% } %>

  <section class="admin-actions-panel" aria-labelledby="adminActionsTitle">
    <div class="admin-actions-head">
      <h2 class="admin-actions-title" id="adminActionsTitle"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Administration Actions</h2>
      <span class="admin-actions-caption">System management shortcuts</span>
    </div>
    <div class="dashboard-cards">
    <div class="col">
      <a href="/partner-customers" class="card-link">
        <div class="card h-100 text-center shadow-sm">
          <div class="card-body">
            <div class="card-icon" aria-hidden="true"><i class="fa-solid fa-store"></i></div>
            <div>
              <h5 class="card-title">Partner Customers</h5>
              <p class="card-text">Manage customer master data for the separate subscription billing module.</p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <div class="col">
      <a href="/admin/users" class="card-link">
        <div class="card h-100 text-center shadow-sm">
          <div class="card-body">
            <div class="card-icon" aria-hidden="true"><i class="fa-solid fa-users"></i></div>
            <div>
              <h5 class="card-title">Manage Users</h5>
              <p class="card-text">View, edit, and manage user accounts and roles.</p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <div class="col">
      <a href="/admin/audit-logs" class="card-link">
        <div class="card h-100 text-center shadow-sm">
          <div class="card-body">
            <div class="card-icon" aria-hidden="true"><i class="fa-solid fa-clipboard-list"></i></div>
            <div>
              <h5 class="card-title">Audit Logs</h5>
              <p class="card-text">Review recent administrative actions and changes.</p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <div class="col">
      <a href="/register" class="card-link">
        <div class="card h-100 text-center shadow-sm">
          <div class="card-body">
            <div class="card-icon" aria-hidden="true"><i class="fa-solid fa-user-plus"></i></div>
            <div>
              <h5 class="card-title">Open Registration Page</h5>
              <p class="card-text">New accounts are created as Staff by default. Assign Finance, HR, or Admin roles afterward from Manage Users.</p>
            </div>
          </div>
        </div>
      </a>
    </div>

    <div class="col">
      <a href="/reset" class="card-link">
        <div class="card h-100 text-center shadow-sm">
          <div class="card-body">
            <div class="card-icon" aria-hidden="true"><i class="fa-solid fa-lock"></i></div>
            <div>
              <h5 class="card-title">Reset Password</h5>
              <p class="card-text">Open the email-based password reset flow.</p>
            </div>
          </div>
        </div>
      </a>
    </div>
    </div>
  </section>
</section>

<%- include('../partials/footer') %>
