<%- include('partials/header', { title: 'My Payslips' }) %>
<%- include('partials/navbar') %>
  <script>const token = localStorage.getItem('token'); if (!token) location = '/login';</script>

  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title">My Payslips</h5>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Period</th>
              <th>Bank Number</th>
              <th class="text-end">Gross</th>
              <th class="text-end">Net</th>
              <th class="text-center">Download</th>
            </tr>
          </thead>
          <tbody>
            <% payrolls.forEach(p => { %>
              <tr>
                <td><%= p.period %></td>
                <td><%= p.bank_number || '-' %></td>
                <td class="text-end">$<%= p.gross %></td>
                <td class="text-end">$<%= p.net %></td>
                <td class="text-center">
                  <a href="/api/payroll/<%= p.id %>/payslip" target="_blank" class="btn btn-sm btn-outline-primary">PDF</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
