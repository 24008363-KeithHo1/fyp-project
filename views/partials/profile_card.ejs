<!--
  Shared profile summary card for the Admin, HR, and Finance dashboards.
  Self-contained (scoped class names + own <style>) so it drops into any
  of the three dashboards without colliding with their differing CSS
  variable systems (--ad-*, --hr-*, --g*). Fetches the current user via
  the existing /api/auth/me endpoint, same as views/staff/profile.ejs.
-->
<style>
  .pc-card {
    display: flex;
    align-items: center;
    gap: .9rem;
    padding: 1rem 1.15rem;
    border-radius: 10px;
    border: 1px solid rgba(148, 163, 184, .18);
    background: linear-gradient(180deg, #ffffff, #f8fafc);
    box-shadow: 0 14px 30px rgba(15, 23, 42, .06);
    margin-bottom: 1rem;
  }
  .pc-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.4rem;
    background: linear-gradient(135deg, #0f766e, #22c55e);
    color: #fff;
    overflow: hidden;
  }
  .pc-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pc-info {
    display: flex;
    flex-direction: column;
    gap: .15rem;
    min-width: 0;
  }
  .pc-name {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: #102033;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pc-meta {
    font-size: .8rem;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: .4rem;
    flex-wrap: wrap;
  }
  .pc-role-badge {
    display: inline-flex;
    align-items: center;
    padding: .1rem .55rem;
    border-radius: 999px;
    background: #dcfce7;
    color: #15803d;
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  .pc-link {
    margin-left: auto;
    flex-shrink: 0;
    font-size: .8rem;
    font-weight: 600;
    color: #0b8f3e;
    text-decoration: none;
    white-space: nowrap;
  }
  .pc-link:hover { color: #066a2c; text-decoration: underline; }
  @media (max-width: 560px) {
    .pc-card { flex-wrap: wrap; }
    .pc-link { margin-left: 0; width: 100%; text-align: right; }
  }
</style>

<div class="pc-card" id="profileCard">
  <div class="pc-avatar" id="pcAvatar">👤</div>
  <div class="pc-info">
    <span class="pc-name" id="pcName">Loading…</span>
    <span class="pc-meta">
      <span class="pc-role-badge" id="pcRole">—</span>
      <span id="pcDeptEmail"></span>
    </span>
  </div>
  <a href="/profile" class="pc-link">View profile <i class="fa-solid fa-arrow-right"></i></a>
</div>

<script>
  (function () {
    const token = localStorage.getItem('token');
    if (!token) return;
    fetch('/api/auth/me', { headers: { authorization: 'Bearer ' + token } })
      .then((res) => (res.ok ? res.json() : Promise.reject()))
      .then((data) => {
        const user = data.user || {};
        document.getElementById('pcName').textContent = user.name || 'Unknown user';
        document.getElementById('pcRole').textContent = user.role || 'Staff';
        const deptEmailParts = [user.department, user.email].filter(Boolean);
        document.getElementById('pcDeptEmail').textContent = deptEmailParts.join(' · ');
        const avatarEl = document.getElementById('pcAvatar');
        if (user.profileImage) {
          avatarEl.innerHTML = `<img src="${user.profileImage}" alt="">`;
        } else {
          avatarEl.textContent = (user.name || '?').trim().charAt(0).toUpperCase() || '?';
        }
      })
      .catch(() => {
        // Fails silently — the card just keeps its loading placeholder
        // rather than blocking the rest of the dashboard from rendering.
        document.getElementById('pcName').textContent = 'Unable to load profile';
      });
  })();
</script>