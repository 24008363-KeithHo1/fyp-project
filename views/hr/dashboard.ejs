<%- include('../partials/header', { title: 'HR Dashboard' }) %>
<%- include('../partials/navbar') %>

<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
try{
  const payload = JSON.parse(atob(token.split('.')[1]));
  if (payload.role !== 'HR' && payload.role !== 'Admin') location = '/dashboard';
}catch(e){ location = '/login'; }
</script>

<div class="container mt-4">
  <h2>HR Dashboard</h2>
  <p>Payroll, employees and HR actions.</p>
  <div class="row">
    <div class="col-md-6">
      <a class="btn btn-primary" href="/payroll">Payroll</a>
    </div>
    <div class="col-md-6">
      <a class="btn btn-secondary" href="/admin/users">Employees</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
