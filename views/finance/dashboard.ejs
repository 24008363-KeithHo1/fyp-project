<%- include('../partials/header', { title: 'Finance Dashboard' }) %>
<%- include('../partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
try {
  const payload = JSON.parse(atob(token.split('.')[1]));
  if (payload.role !== 'Finance' && payload.role !== 'Admin') location = '/dashboard';
} catch(e) { location = '/login'; }
</script>

<style>
:root {
  --g900: #052e16; --g800: #064e27; --g700: #065f32; --g600: #16a34a;
  --g500: #22c55e; --g400: #4ade80; --g100: #dcfce7; --g50: #f0fdf4;
  --white: #ffffff; --ink: #0f1c14; --ink2: #3a5040; --ink3: #6b8c78;
  --border: #d1fae5; --border2: #bbf7d0;
  --shadow-sm: 0 1px 3px rgba(6,78,39,.08),0 1px 2px rgba(6,78,39,.04);
  --shadow-md: 0 4px 16px rgba(6,78,39,.1),0 2px 6px rgba(6,78,39,.06);
  --radius: 16px; --radius-sm: 10px;
}
body { font-family: 'Sora', sans-serif; background: var(--g50); color: var(--ink); }
.fd-wrap { max-width: 1280px; width: 100%; margin: 0 auto; padding: 2rem 1.5rem 4rem; box-sizing: border-box; }
#paymentSuccessAlert { border-radius: var(--radius-sm); font-size: .875rem; font-weight: 500; margin-bottom: 1.5rem; }
.fd-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; margin-bottom: 2rem; flex-wrap: wrap; width: 100%; min-width: 0; }
.fd-header-left { min-width: 0; }
.fd-header-right { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; justify-content: flex-end; min-width: 0; }
.fd-greeting { font-size: .78rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--g600); margin-bottom: .3rem; }
.fd-title { font-size: 1.75rem; font-weight: 700; color: var(--ink); line-height: 1.2; margin: 0; }
.fd-subtitle { font-size: .875rem; color: var(--ink3); margin: .3rem 0 0; font-weight: 400; }
.fd-date { font-size: .8rem; color: var(--ink3); font-family: 'DM Mono', monospace; }
.btn-payments { display: inline-flex; align-items: center; gap: .45rem; padding: .55rem 1.2rem; background: var(--g800); color: #fff; border-radius: 100px; font-size: .83rem; font-weight: 600; text-decoration: none; border: none; transition: background .18s,transform .15s,box-shadow .18s; box-shadow: 0 4px 14px rgba(6,78,39,.28); letter-spacing: .01em; }
.btn-payments:hover { background: var(--g700); color: #fff; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(6,78,39,.32); }
.fd-kpis { display: grid; grid-template-columns: repeat(4,1fr); gap: 1rem; margin-bottom: 1.25rem; }
.fd-kpi { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.4rem 1.5rem; display: flex; flex-direction: column; gap: .5rem; box-shadow: var(--shadow-sm); position: relative; overflow: hidden; transition: box-shadow .2s,transform .15s; min-width: 0; width: 100%; box-sizing: border-box; }
.fd-kpi:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.fd-kpi::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: var(--radius) var(--radius) 0 0; }
.fd-kpi.kpi-revenue::before { background: linear-gradient(90deg,var(--g600),var(--g400)); }
.fd-kpi.kpi-paid::before { background: linear-gradient(90deg,#2563eb,#60a5fa); }
.fd-kpi.kpi-pending::before { background: linear-gradient(90deg,#d97706,#fbbf24); }
.fd-kpi.kpi-overdue::before { background: linear-gradient(90deg,#dc2626,#f87171); }
.fd-kpi-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: .9rem; margin-bottom: .15rem; }
.kpi-revenue .fd-kpi-icon { background: var(--g100); color: var(--g700); }
.kpi-paid .fd-kpi-icon { background: #dbeafe; color: #1d4ed8; }
.kpi-pending .fd-kpi-icon { background: #fef3c7; color: #b45309; }
.kpi-overdue .fd-kpi-icon { background: #fee2e2; color: #b91c1c; }
.fd-kpi-label { font-size: .75rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--ink3); }
.fd-kpi-value { font-size: 1.5rem; font-weight: 700; color: var(--ink); font-family: 'DM Mono', monospace; line-height: 1.1; }
.fd-kpi-sub { font-size: .72rem; color: var(--ink3); }
.fd-panel { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm); min-width: 0; width: 100%; box-sizing: border-box; overflow: hidden; }
.fd-panel-title { font-size: .95rem; font-weight: 700; color: var(--ink); margin: 0 0 1.25rem; display: flex; align-items: center; gap: .5rem; }
.fd-panel-title i { width: 28px; height: 28px; background: var(--g100); color: var(--g700); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: .8rem; flex-shrink: 0; }
.fd-row { display: grid; gap: 1rem; margin-bottom: 1.25rem; min-width: 0; width: 100%; }
.fd-row-2 { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
.fd-row-53 { grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); }
.fd-spacer { margin-bottom: 1.25rem; }
.payment-gateway-list { display: flex; flex-direction: column; gap: .75rem; }
.payment-gateway-item { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .85rem 1rem; background: var(--g50); border: 1px solid var(--border); border-radius: var(--radius-sm); flex-wrap: wrap; }
.gateway-left { display: flex; align-items: center; gap: .65rem; min-width: 0; }
.gateway-name { font-size: .85rem; font-weight: 600; color: var(--ink2); overflow-wrap: anywhere; }
.gateway-badge { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: .78rem; font-weight: 700; flex-shrink: 0; font-family: 'DM Mono', monospace; }
.gateway-stripe { background: #ede9fe; color: #5b21b6; }
.gateway-paypal { background: #dbeafe; color: #1e40af; }
.gateway-nets { background: #fef3c7; color: #b45309; }
.gateway-name { font-size: .85rem; font-weight: 600; color: var(--ink2); }
.gateway-amount { font-family: 'DM Mono', monospace; font-size: .9rem; font-weight: 600; color: var(--ink); }
.chart-wrap { position: relative; width: 100%; min-height: 220px; height: clamp(220px, 32vh, 280px); }
.chart-wrap-tall { position: relative; width: 100%; min-height: 240px; height: clamp(240px, 36vh, 320px); }
.fd-table-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
.btn-view-all { font-size: .78rem; font-weight: 600; color: var(--g700); text-decoration: none; padding: .35rem .8rem; border: 1px solid var(--border2); border-radius: 100px; transition: background .15s; }
.btn-view-all:hover { background: var(--g50); color: var(--g800); }
.fd-table { width: 100%; border-collapse: collapse; table-layout: auto; min-width: 420px; }
.fd-table thead tr { border-bottom: 2px solid var(--border); }
.fd-table th { font-size: .72rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--ink3); padding: .5rem .75rem; text-align: left; white-space: normal; overflow-wrap: anywhere; }
.fd-table th.text-end { text-align: right; }
.fd-table td { padding: .75rem .75rem; font-size: .875rem; color: var(--ink); border-bottom: 1px solid #f0fdf4; white-space: normal; overflow-wrap: anywhere; }
.fd-table td.text-end { text-align: right; font-family: 'DM Mono', monospace; }
.fd-table-scroll { width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
.fd-table tbody tr { transition: background .1s; }
.fd-table tbody tr:hover { background: var(--g50); }
.fd-table tbody tr:last-child td { border-bottom: none; }
.fd-table .inv-num { font-family: 'DM Mono', monospace; font-size: .82rem; color: var(--g700); }
.method-badge { display: inline-flex; align-items: center; gap: .35rem; padding: .2rem .55rem; border-radius: 100px; font-size: .75rem; font-weight: 600; }
.method-stripe { background: #ede9fe; color: #5b21b6; }
.method-paypal { background: #dbeafe; color: #1e40af; }
.method-nets { background: #fef3c7; color: #b45309; }
.method-other { background: var(--g100); color: var(--g700); }
.status-pill { display: inline-flex; align-items: center; gap: .3rem; padding: .22rem .65rem; border-radius: 100px; font-size: .75rem; font-weight: 600; }
.status-pill::before { content: ''; width: 6px; height: 6px; border-radius: 50%; display: inline-block; }
.status-paid { background: var(--g100); color: var(--g700); }
.status-paid::before { background: var(--g600); }
.status-pending { background: #fef3c7; color: #b45309; }
.status-pending::before { background: #f59e0b; }
.status-failed { background: #fee2e2; color: #b91c1c; }
.status-failed::before { background: #ef4444; }
.status-refunded { background: #cffafe; color: #0e7490; }
.status-refunded::before { background: #06b6d4; }
.fd-alerts-list { display: flex; flex-direction: column; gap: .6rem; }
.fd-alert-item { display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; background: #fff7ed; border: 1px solid #fed7aa; border-radius: var(--radius-sm); font-size: .875rem; color: #92400e; }
.fd-alert-item i { color: #f97316; font-size: .9rem; flex-shrink: 0; }
.fd-alerts-empty { font-size: .875rem; color: var(--ink3); display: flex; align-items: center; gap: .5rem; }
.fd-alerts-empty i { color: var(--g500); }
.fd-actions-grid { display: grid; grid-template-columns: repeat(6,1fr); gap: .85rem; }
.fd-action-card { text-decoration: none; display: flex; flex-direction: column; align-items: center; gap: .65rem; padding: 1.25rem .75rem 1rem; background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); text-align: center; transition: border-color .18s,box-shadow .18s,transform .15s,background .18s; box-shadow: var(--shadow-sm); }
.fd-action-card:hover { border-color: var(--g400); box-shadow: var(--shadow-md); transform: translateY(-3px); background: var(--g50); }
.fd-action-icon { width: 44px; height: 44px; background: var(--g100); border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: var(--g700); transition: background .18s,color .18s; flex-shrink: 0; }
.fd-action-card:hover .fd-action-icon { background: var(--g700); color: #fff; }
.fd-action-name { font-size: .8rem; font-weight: 700; color: var(--ink); line-height: 1.3; }
.fd-action-desc { font-size: .72rem; color: var(--ink3); font-weight: 400; line-height: 1.4; }
/* Refreshed Finance workspace styling, aligned with the current HR/Admin pages. */
body{background:linear-gradient(135deg,#f7faf8 0%,#e8f7ee 48%,#f8fbf9 100%)!important;color:#102033}
.fd-wrap{max-width:1220px;padding:1.1rem;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(248,250,252,.94)),linear-gradient(90deg,rgba(6,182,212,.12),rgba(124,58,237,.12));animation:fd-enter .45s cubic-bezier(.22,.8,.36,1) both}
@keyframes fd-enter{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.fd-header{position:relative;overflow:hidden;align-items:flex-end;margin-bottom:1rem;padding:1.35rem;border:1px solid rgba(37,99,235,.18);border-radius:8px;background:linear-gradient(135deg,rgba(15,23,42,.96),rgba(37,99,235,.88) 48%,rgba(11,143,62,.84));box-shadow:0 18px 38px rgba(15,23,42,.16)}
.fd-header::after{position:absolute;right:-56px;bottom:-84px;width:260px;height:150px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.03));content:'';transform:rotate(-18deg)}
.fd-header-left,.fd-header-right{position:relative;z-index:1}
.fd-greeting{display:inline-flex;align-items:center;gap:.4rem;width:fit-content;margin:0 0 .35rem;padding:.3rem .62rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;letter-spacing:0}
.fd-title{color:#fff;font-size:1.8rem}.fd-subtitle{color:#fff;opacity:.86}.fd-date{padding:.48rem .72rem;border-radius:999px;background:rgba(255,255,255,.14);color:#fff}
.btn-payments{border-radius:8px;background:#fff;color:#1d4ed8;box-shadow:0 14px 28px rgba(15,23,42,.24)}.btn-payments:hover{background:#e0f2fe;color:#075985;box-shadow:0 16px 30px rgba(15,23,42,.25)}
.fd-kpis{gap:1rem;margin-bottom:1rem}.fd-kpi{min-height:126px;padding:1rem 1rem 1.1rem;gap:.42rem;border:0;border-radius:8px;box-shadow:0 16px 30px rgba(15,23,42,.13)}
.fd-kpi::before{display:none}.fd-kpi::after{position:absolute;right:-24px;bottom:-36px;width:150px;height:84px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.04));content:'';transform:rotate(-18deg)}.fd-kpi>*{position:relative;z-index:1}
.fd-kpi.kpi-revenue{background:linear-gradient(135deg,#0f766e,#22c55e)}.fd-kpi.kpi-paid{background:linear-gradient(135deg,#1d4ed8,#06b6d4)}.fd-kpi.kpi-pending{background:linear-gradient(135deg,#c2410c,#f59e0b)}.fd-kpi.kpi-overdue{background:linear-gradient(135deg,#be123c,#f43f5e)}
.fd-kpi-icon,.kpi-revenue .fd-kpi-icon,.kpi-paid .fd-kpi-icon,.kpi-pending .fd-kpi-icon,.kpi-overdue .fd-kpi-icon{background:rgba(255,255,255,.16);color:#fff}.fd-kpi-label,.fd-kpi-value,.fd-kpi-sub{color:#fff}.fd-kpi-label{font-weight:800;letter-spacing:0;opacity:.82}.fd-kpi-sub{margin-top:auto;opacity:.82}.fd-kpi:hover{transform:translateY(-4px);box-shadow:0 22px 38px rgba(15,23,42,.16)}
.fd-row,.fd-spacer{margin-bottom:1rem}.fd-panel{padding:1.25rem;border:1px solid rgba(148,163,184,.18);border-radius:8px;background:linear-gradient(180deg,rgba(255,255,255,.99),rgba(240,249,255,.72));box-shadow:0 14px 30px rgba(15,23,42,.08);transition:border-color .16s ease,box-shadow .16s ease,transform .16s ease}.fd-panel:hover{border-color:rgba(6,182,212,.28);box-shadow:0 20px 36px rgba(15,23,42,.12)}
.fd-panel-title{color:#102033}.fd-panel-title i{background:linear-gradient(135deg,#0f766e,#22c55e);color:#fff}.payment-gateway-item{border-color:rgba(148,163,184,.18);border-radius:8px;background:rgba(248,250,252,.88)}
.fd-table thead tr{border-color:rgba(148,163,184,.2)}.fd-table th{background:#f8fafc;color:#475569}.fd-table td{border-color:rgba(148,163,184,.14)}
.fd-actions-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem}.fd-action-card{align-items:flex-start;flex-direction:row;padding:1rem;border:1px solid rgba(148,163,184,.18);border-radius:8px;text-align:left;background:#fff}.fd-action-card:hover{border-color:rgba(37,99,235,.3);background:#f0f9ff;transform:translateY(-3px)}
.fd-action-icon{width:40px;height:40px;border-radius:8px;background:linear-gradient(135deg,#dbeafe,#dcfce7);color:#1d4ed8}.fd-action-card:hover .fd-action-icon{background:linear-gradient(135deg,#2563eb,#0b8f3e)}.fd-alert-item,.btn-view-all{border-radius:8px}
@media (max-width:1024px) { .fd-kpis{grid-template-columns:repeat(2,1fr)} .fd-row-53{grid-template-columns:1fr} .fd-actions-grid{grid-template-columns:repeat(3,1fr)} }
@media (max-width:820px) { .fd-wrap{padding:1rem .8rem 2rem} .fd-header{align-items:flex-start} .fd-header-right{justify-content:flex-start; width:100%} .fd-panel{padding:1rem} .fd-kpi{padding:1rem 1rem 1.1rem} .fd-table th, .fd-table td{padding:.6rem .5rem;font-size:.8rem} }
@media (max-width:640px) { .fd-kpis{grid-template-columns:1fr 1fr} .fd-row-2{grid-template-columns:1fr} .fd-actions-grid{grid-template-columns:repeat(2,1fr)} .fd-title{font-size:1.4rem} .fd-panel-title{flex-wrap:wrap} .chart-wrap, .chart-wrap-tall{min-height:220px;height:clamp(220px, 45vh, 260px)} }
@media (max-width:480px) { .fd-wrap{padding:.8rem .6rem 1.5rem} .fd-kpis{grid-template-columns:1fr} .fd-actions-grid{grid-template-columns:1fr} .fd-table{min-width:360px} .fd-table th, .fd-table td{font-size:.75rem} }
</style>

<div class="fd-wrap">
  <div id="paymentSuccessAlert" class="alert d-none" role="alert"></div>

  <header class="fd-header">
    <div class="fd-header-left">
      <p class="fd-greeting"><i class="fa-solid fa-chart-line" aria-hidden="true"></i> Finance Overview</p>
      <h1 class="fd-title">Finance Dashboard</h1>
      <p class="fd-subtitle">Monitor revenue, payment activity, payroll releases, and finance priorities.</p>
    </div>
    <div class="fd-header-right">
      <span class="fd-date" id="fd-today"></span>
      <a href="/finance/payments" class="btn-payments">
        <i class="fa-solid fa-arrow-right-arrow-left"></i> Payments
      </a>
    </div>
  </header>

  <div class="fd-kpis fd-spacer">
    <div class="fd-kpi kpi-revenue">
      <div class="fd-kpi-icon"><i class="fa-solid fa-coins"></i></div>
      <div class="fd-kpi-label">Total Revenue</div>
      <div class="fd-kpi-value" id="financeTotalRevenue">SGD 0.00</div>
      <div class="fd-kpi-sub">Paid invoices only</div>
    </div>
    <div class="fd-kpi kpi-paid">
      <div class="fd-kpi-icon"><i class="fa-solid fa-check-circle"></i></div>
      <div class="fd-kpi-label">Paid Invoices</div>
      <div class="fd-kpi-value" id="financePaidInvoices">0</div>
      <div class="fd-kpi-sub">Successfully settled</div>
    </div>
    <div class="fd-kpi kpi-pending">
      <div class="fd-kpi-icon"><i class="fa-solid fa-clock"></i></div>
      <div class="fd-kpi-label">Pending Payments</div>
      <div class="fd-kpi-value" id="financePendingPayments">0</div>
      <div class="fd-kpi-sub">Awaiting settlement</div>
    </div>
    <div class="fd-kpi kpi-overdue">
      <div class="fd-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <div class="fd-kpi-label">Overdue Invoices</div>
      <div class="fd-kpi-value" id="financeOverdueInvoices">0</div>
      <div class="fd-kpi-sub">Requires follow-up</div>
    </div>
  </div>

  <!-- Added: payment analytics panel showing revenue split by Stripe, PayPal, and NETS. -->
  <div class="fd-row fd-row-53 fd-spacer">
    <div class="fd-panel">
      <h2 class="fd-panel-title"><i class="fa-solid fa-chart-pie"></i> Payment Analytics</h2>
      <div class="payment-gateway-list">
        <div class="payment-gateway-item">
          <div class="gateway-left">
            <div class="gateway-badge gateway-stripe">S</div>
            <span class="gateway-name">Stripe Revenue</span>
          </div>
          <span class="gateway-amount" id="stripeRevenue">SGD 0.00</span>
        </div>
        <div class="payment-gateway-item">
          <div class="gateway-left">
            <div class="gateway-badge gateway-paypal">P</div>
            <span class="gateway-name">PayPal Revenue</span>
          </div>
          <span class="gateway-amount" id="paypalRevenue">SGD 0.00</span>
        </div>
        <div class="payment-gateway-item">
          <div class="gateway-left">
            <div class="gateway-badge gateway-nets">N</div>
            <span class="gateway-name">NETS Revenue</span>
          </div>
          <span class="gateway-amount" id="netsRevenue">SGD 0.00</span>
        </div>
      </div>
    </div>
    <div class="fd-panel">
      <h2 class="fd-panel-title"><i class="fa-solid fa-chart-donut"></i> Gateway Share</h2>
      <div class="chart-wrap"><canvas id="paymentPieChart"></canvas></div>
    </div>
  </div>

  <div class="fd-panel fd-spacer">
    <div class="fd-table-header">
      <h2 class="fd-panel-title" style="margin:0"><i class="fa-solid fa-list-check"></i> Recent Payments</h2>
      <a href="/finance/payments" class="btn-view-all">View all →</a>
    </div>
    <div class="fd-table-scroll">
      <table class="fd-table">
        <thead>
          <tr>
            <th>Invoice</th><th>Method</th>
            <th class="text-end">Amount</th><th>Status</th>
          </tr>
        </thead>
        <tbody id="recentPaymentsBody">
          <tr><td colspan="4" style="text-align:center;color:var(--ink3);padding:1.5rem">Loading payments…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="fd-row fd-row-2 fd-spacer">
    <div class="fd-panel">
      <h2 class="fd-panel-title"><i class="fa-solid fa-bell"></i> Alerts</h2>
      <div id="financeAlerts">
        <div class="fd-alerts-empty"><i class="fa-solid fa-circle-check"></i> Loading alerts…</div>
      </div>
    </div>
    <div class="fd-panel">
      <h2 class="fd-panel-title"><i class="fa-solid fa-money-check-dollar"></i> Salary Release</h2>
      <div class="payment-gateway-list">
        <div class="payment-gateway-item">
          <span class="gateway-name">Total Payroll Paid</span>
          <span class="gateway-amount" id="totalPayrollPaid">SGD 0.00</span>
        </div>
        <div class="payment-gateway-item">
          <span class="gateway-name">Employees Paid</span>
          <span class="gateway-amount" id="employeesPaid">0</span>
        </div>
        <div class="payment-gateway-item">
          <span class="gateway-name">Pending Payrolls</span>
          <span class="gateway-amount" id="pendingPayrolls">0</span>
        </div>
      </div>
    </div>
  </div>

  <div class="fd-row fd-row-2 fd-spacer">
    <div class="fd-panel">
      <h2 class="fd-panel-title"><i class="fa-solid fa-chart-column"></i> Monthly Revenue</h2>
      <div class="chart-wrap-tall"><canvas id="monthlyRevenueChart"></canvas></div>
    </div>
    <div class="fd-panel">
      <h2 class="fd-panel-title"><i class="fa-solid fa-chart-column"></i> Payroll by Period</h2>
      <div class="chart-wrap-tall"><canvas id="payrollReleaseChart"></canvas></div>
    </div>
  </div>

  <div class="fd-panel">
    <h2 class="fd-panel-title"><i class="fa-solid fa-bolt"></i> Quick Actions</h2>
    <div class="fd-actions-grid">
      <a href="/invoices" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-file-invoice"></i></div>
        <div><div class="fd-action-name">Invoices</div><div class="fd-action-desc">Create &amp; manage invoices</div></div>
      </a>
      <a href="/reports" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-chart-column"></i></div>
        <div><div class="fd-action-name">Reports</div><div class="fd-action-desc">Summaries &amp; exports</div></div>
      </a>
      <a href="/finance/payments" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-credit-card"></i></div>
        <div><div class="fd-action-name">Payments</div><div class="fd-action-desc">Record &amp; reconcile</div></div>
      </a>
      <a href="/finance/bank-reconcile" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-building-columns"></i></div>
        <div><div class="fd-action-name">Bank Reconciliation</div><div class="fd-action-desc">Import &amp; reconcile</div></div>
      </a>
      <a href="/payroll" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-briefcase"></i></div>
        <div><div class="fd-action-name">Payroll</div><div class="fd-action-desc">Runs &amp; settings</div></div>
      </a>
      <a href="/finance/payroll-approvals" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-clipboard-check"></i></div>
        <div><div class="fd-action-name">Payroll Approvals</div><div class="fd-action-desc">Review HR submissions</div></div>
      </a>
      <a href="/finance/requests" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-envelope"></i></div>
        <div><div class="fd-action-name">Requests</div><div class="fd-action-desc">HR or finance requests</div></div>
      </a>
    </div>
  </div>
</div>

<script>
document.getElementById('fd-today').textContent = new Date().toLocaleDateString(undefined,{weekday:'short',year:'numeric',month:'short',day:'numeric'});

const dashboardParams = new URLSearchParams(window.location.search);
if (dashboardParams.get('payment') === 'stripe') {
  const alertEl = document.getElementById('paymentSuccessAlert');
  const status = dashboardParams.get('status');
  const isPaid = !status || status === 'paid' || status === 'complete';
  alertEl.classList.remove('d-none');
  alertEl.classList.add(isPaid ? 'alert-success' : 'alert-warning');
  alertEl.textContent = isPaid ? 'Stripe payment completed successfully and the invoice was marked Paid.' : 'Stripe returned but the payment could not be confirmed automatically. Check the invoice and payment history.';
}

let paymentPieChart, monthlyRevenueChart, payrollReleaseChart;

function refreshCharts() {
  if (paymentPieChart) paymentPieChart.resize();
  if (monthlyRevenueChart) monthlyRevenueChart.resize();
}

function financeMoney(value, currency) {
  return `${currency||'SGD'} ${Number(value||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2})}`;
}
function statusClass(s) {
  if (s==='Paid') return 'status-paid';
  if (s==='Failed') return 'status-failed';
  if (s==='Refunded') return 'status-refunded';
  return 'status-pending';
}
// Added: styles each payment method badge in the recent payments table.
function methodClass(m) {
  if (!m) return 'method-other';
  const ml = m.toLowerCase();
  if (ml.includes('stripe')) return 'method-stripe';
  if (ml.includes('paypal')) return 'method-paypal';
  if (ml.includes('nets')) return 'method-nets';
  return 'method-other';
}

// Added: renders payment method share for Stripe, PayPal, and NETS.
function renderPaymentPie(stripeRevenue, paypalRevenue, netsRevenue) {
  const canvas = document.getElementById('paymentPieChart');
  const values = [stripeRevenue, paypalRevenue, netsRevenue];
  if (paymentPieChart) paymentPieChart.destroy();
  paymentPieChart = new Chart(canvas, {
    type: 'doughnut',
    data: { labels: ['Stripe','PayPal','NETS'], datasets: [{ data: values, backgroundColor: ['#8b5cf6','#3b82f6','#f59e0b'], borderColor: '#fff', borderWidth: 3, hoverOffset: 6 }] },
    options: { responsive:true, maintainAspectRatio:false, animation:{duration:500}, cutout:'62%',
      layout:{padding:{top:6,bottom:6,left:6,right:6}},
      plugins: { legend: { position:'bottom', labels:{font:{family:'Sora',size:12},padding:16,boxWidth:12,usePointStyle:false} },
        tooltip: { callbacks: { label: ctx => { const t=values.reduce((sum,value)=>sum+value,0); const p=t?Math.round((ctx.raw/t)*100):0; return ` ${ctx.label}: ${p}% (${financeMoney(ctx.raw)})`; } } } } }
  });
  requestAnimationFrame(refreshCharts);
}

function renderMonthlyRevenue(mr) {
  const labels = calendarMonths;
  const values = Array(12).fill(0);
  Object.entries(mr||{}).forEach(([period, amount]) => {
    const monthIndex = monthIndexFromPeriod(period);
    if (monthIndex >= 0) values[monthIndex] += Number(amount || 0);
  });
  const canvas = document.getElementById('monthlyRevenueChart');
  if (monthlyRevenueChart) monthlyRevenueChart.destroy();
  monthlyRevenueChart = new Chart(canvas, {
    type: 'bar',
    data: { labels,
      datasets: [{ label:'Revenue', data:values, backgroundColor:'rgba(22,163,74,0.18)', borderColor:'#16a34a', borderWidth:2, borderRadius:8, borderSkipped:false, hoverBackgroundColor:'rgba(22,163,74,0.35)' }] },
    options: { responsive:true, maintainAspectRatio:false, animation:{duration:500},
      layout:{padding:{top:6,bottom:0,left:0,right:0}},
      scales: { x:{grid:{display:false},ticks:{font:{family:'Sora',size:11},maxRotation:0,autoSkip:true}}, y:{beginAtZero:true, grid:{color:'rgba(0,0,0,.05)'}, ticks:{callback:v=>'SGD '+v.toLocaleString(),font:{family:'DM Mono',size:10}}} },
      plugins: { legend:{display:false}, tooltip:{callbacks:{label:ctx=>' '+financeMoney(ctx.raw)}} } }
  });
  requestAnimationFrame(refreshCharts);
}

const calendarMonths = [
  'January','February','March','April','May','June',
  'July','August','September','October','November','December'
];

function monthIndexFromPeriod(period) {
  const text = String(period || '').toLowerCase();
  if (/^\d{4}-\d{2}$/.test(text)) return Math.max(0, Math.min(11, Number(text.split('-')[1]) - 1));
  let matchedIndex = -1;
  calendarMonths.forEach((month, index) => {
    if (text.includes(month.toLowerCase()) || text.includes(month.slice(0, 3).toLowerCase())) {
      matchedIndex = index;
    }
  });
  return matchedIndex;
}

function renderPayrollReleaseChart(payrollByPeriod) {
  const labels = calendarMonths;
  const values = Array(12).fill(0);
  Object.entries(payrollByPeriod||{}).forEach(([period, amount]) => {
    const monthIndex = monthIndexFromPeriod(period);
    if (monthIndex >= 0) values[monthIndex] += Number(amount || 0);
  });
  const canvas = document.getElementById('payrollReleaseChart');
  if (payrollReleaseChart) payrollReleaseChart.destroy();
  payrollReleaseChart = new Chart(canvas, {
    type: 'line',
    data: { labels, datasets: [{ label:'Payroll', data:values, backgroundColor:'rgba(37,99,235,0.12)', borderColor:'#2563eb', borderWidth:3, pointBackgroundColor:'#2563eb', pointBorderColor:'#fff', pointBorderWidth:2, pointRadius:4, pointHoverRadius:6, tension:.35, fill:true }] },
    options: { responsive:true, maintainAspectRatio:false,
      scales: { x:{grid:{display:false},ticks:{font:{family:'Sora',size:10}}}, y:{beginAtZero:true, grid:{color:'rgba(0,0,0,.05)'}, ticks:{callback:v=>'SGD '+v.toLocaleString(),font:{family:'DM Mono',size:10}}} },
      plugins: { legend:{display:false}, tooltip:{callbacks:{label:ctx=>' '+financeMoney(ctx.raw)}} } }
  });
}

// Added: displays the latest payment transactions on the finance dashboard.
function renderRecentPayments(payments) {
  const tbody = document.getElementById('recentPaymentsBody');
  if (!payments||!payments.length) { tbody.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--ink3);padding:1.5rem">No payments recorded yet</td></tr>'; return; }
  tbody.innerHTML = payments.map(p => `<tr>
    <td><span class="inv-num">${p.invoiceNumber||'—'}</span></td>
    <td><span class="method-badge ${methodClass(p.method)}">${p.method||'—'}</span></td>
    <td class="text-end">${financeMoney(p.amount,p.currency)}</td>
    <td><span class="status-pill ${statusClass(p.status)}">${p.status||'—'}</span></td>
  </tr>`).join('');
}

function renderAlerts(totals) {
  const items = [];
  if ((totals.overdueInvoiceCount||0)>0) items.push(`${totals.overdueInvoiceCount} overdue invoice${totals.overdueInvoiceCount===1?'':'s'}`);
  if ((totals.failedPayPalCount||0)>0) items.push(`${totals.failedPayPalCount} failed PayPal transaction${totals.failedPayPalCount===1?'':'s'}`);
  if ((totals.refundedPaymentCount||0)>0) items.push(`${totals.refundedPaymentCount} refunded payment${totals.refundedPaymentCount===1?'':'s'} totalling ${financeMoney(totals.refundedPaymentAmount)}`);
  if ((totals.payrollDueSoonCount||0)>0) items.push(`${totals.payrollDueSoonCount} payroll run${totals.payrollDueSoonCount===1?'':'s'} due in 2 days`);
  const container = document.getElementById('financeAlerts');
  if (!items.length) { container.innerHTML='<div class="fd-alerts-empty"><i class="fa-solid fa-circle-check"></i> No active finance alerts.</div>'; return; }
  container.innerHTML = '<div class="fd-alerts-list">'+items.map(msg=>`<div class="fd-alert-item"><i class="fa-solid fa-triangle-exclamation"></i><span>${msg}</span></div>`).join('')+'</div>';
}

// Added: loads finance summary data and updates payment KPIs, charts, alerts, and recent payments.
async function loadFinanceDashboard() {
  try {
    const res = await fetch('/api/reports/summary', { headers: { authorization: 'Bearer ' + token } });
    if (!res.ok) return;
    const summary = await res.json();
    const totals = summary.totals||{};
    const pr = (summary.charts&&summary.charts.paymentMethodRevenue)||{};
    const sr = Number(pr.Stripe||0), paypalR = Number(pr.PayPal||0), netsR = Number(pr.NETS||0);
    document.getElementById('financeTotalRevenue').textContent = financeMoney(totals.paidRevenue);
    document.getElementById('financePaidInvoices').textContent = totals.paidInvoiceCount||0;
    document.getElementById('financePendingPayments').textContent = totals.pendingPaymentCount||0;
    document.getElementById('financeOverdueInvoices').textContent = totals.overdueInvoiceCount||0;
    document.getElementById('totalPayrollPaid').textContent = financeMoney(totals.totalPayrollPaid);
    document.getElementById('employeesPaid').textContent = totals.employeesPaid||0;
    document.getElementById('pendingPayrolls').textContent = totals.pendingPayrolls||0;
    document.getElementById('stripeRevenue').textContent = financeMoney(sr);
    document.getElementById('paypalRevenue').textContent = financeMoney(paypalR);
    document.getElementById('netsRevenue').textContent = financeMoney(netsR);
    renderPaymentPie(sr, paypalR, netsR);
    renderRecentPayments(summary.recentTransactions||[]);
    renderAlerts(totals);
    renderMonthlyRevenue((summary.charts&&summary.charts.monthlyRevenue)||{});
    renderPayrollReleaseChart((summary.charts&&summary.charts.payrollByPeriod)||{});
  } catch(e) { console.error('Finance dashboard load error:',e); }
}

window.addEventListener('resize', refreshCharts);
if ('ResizeObserver' in window) {
  const chartContainers = [document.getElementById('paymentPieChart')?.parentElement, document.getElementById('monthlyRevenueChart')?.parentElement];
  const resizeObserver = new ResizeObserver(() => refreshCharts());
  chartContainers.filter(Boolean).forEach(container => resizeObserver.observe(container));
}

loadFinanceDashboard();
</script>

