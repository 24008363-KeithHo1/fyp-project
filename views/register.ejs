<%- include('partials/header', { title: 'Register' }) %>
<%- include('partials/navbar') %>

<main>
  <h2>Create account</h2>
  <form id="register">
    <input type="hidden" id="inviteToken" value="<%= token %>">
    <label>Email: <input type="email" id="email" value="<%= email %>" required></label><br>
    <label>Name: <input id="name"></label><br>
    <label>Password: <input type="password" id="password" required></label><br>
    <label>Role: <select id="role"><option>Staff</option><option>Finance</option><option>HR</option><option>Admin</option></select></label><br>
    <button>Create account</button>
  </form>
</main>

<script>
document.getElementById('register').addEventListener('submit', async e=>{
  e.preventDefault();
  const body = { name: document.getElementById('name').value, email: document.getElementById('email').value, password: document.getElementById('password').value, role: document.getElementById('role').value };
  const token = document.getElementById('inviteToken').value; if (token) body.inviteToken = token;
  const res = await fetch('/api/auth/register',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});
  const j = await res.json();
  if (j.id) { alert('Registered. Please login.'); location='/login'; }
  else alert(j.error || 'Registration failed');
});
</script>

<%- include('partials/footer') %>
