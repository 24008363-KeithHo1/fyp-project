<%- include('../partials/header', { title: 'Finance Dashboard' }) %>
<%- include('../partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,300&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
try {
  const payload = JSON.parse(atob(token.split('.')[1]));
  if (payload.role !== 'Finance' && payload.role !== 'Admin') location = '/dashboard';
} catch(e) { location = '/login'; }
</script>

<style>
/* ── tokens ── */
:root {
  --fd-bg:        #0d0f14;
  --fd-surface:   #13161e;
  --fd-surface2:  #1a1e2a;
  --fd-border:    rgba(255,255,255,0.07);
  --fd-border2:   rgba(255,255,255,0.12);
  --fd-text:      #e8eaf0;
  --fd-muted:     #636b80;
  --fd-accent:    #3dd68c;
  --fd-accent2:   #2fb87a;
  --fd-blue:      #4f8ef7;
  --fd-amber:     #f59e0b;
  --fd-red:       #f05252;
  --fd-stripe:    #635bff;
  --fd-paypal:    #0070ba;
  --fd-radius:    14px;
  --fd-radius-sm: 8px;
}

/* ── page shell ── */
body { background: var(--fd-bg) !important; color: var(--fd-text); font-family: 'DM Sans', sans-serif; }

.fd-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
  animation: fd-in .45s cubic-bezier(.22,.8,.36,1) both;
}
@keyframes fd-in { from { opacity:0; transform:translateY(16px) } to { opacity:1; transform:none } }

/* ── header strip ── */
.fd-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--fd-border);
}
.fd-header-left { display: flex; align-items: center; gap: 1.25rem; }
.fd-header-icon {
  width: 48px; height: 48px;
  border-radius: 12px;
  background: linear-gradient(135deg, #1a2e20 0%, #1e3828 100%);
  border: 1px solid rgba(61,214,140,.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 1.2rem; color: var(--fd-accent);
}
.fd-page-title {
  font-family: 'Syne', sans-serif;
  font-size: 1.6rem;
  font-weight: 700;
  color: #fff;
  margin: 0;
  line-height: 1;
}
.fd-page-sub { font-size: .875rem; color: var(--fd-muted); margin: .3rem 0 0; }
.fd-header-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
.fd-btn {
  display: inline-flex; align-items: center; gap: .4rem;
  padding: .5rem 1.1rem;
  border-radius: var(--fd-radius-sm);
  font-family: 'DM Sans', sans-serif;
  font-size: .85rem; font-weight: 500;
  cursor: pointer; text-decoration: none;
  transition: all .15s;
  border: 1.5px solid var(--fd-border2);
  background: var(--fd-surface2);
  color: var(--fd-text);
}
.fd-btn:hover { background: var(--fd-surface); border-color: var(--fd-accent); color: var(--fd-accent); }
.fd-btn-primary {
  background: var(--fd-accent);
  border-color: var(--fd-accent);
  color: #061a10;
  font-weight: 600;
}
.fd-btn-primary:hover { background: var(--fd-accent2); border-color: var(--fd-accent2); color: #061a10; }

/* ── stripe alert ── */
#paymentSuccessAlert {
  display: none;
  padding: .85rem 1.25rem;
  border-radius: var(--fd-radius-sm);
  font-size: .9rem;
  margin-bottom: 1.5rem;
  border-left: 4px solid;
}
#paymentSuccessAlert.alert-success { background: rgba(61,214,140,.1); border-color: var(--fd-accent); color: #8df5be; }
#paymentSuccessAlert.alert-warning { background: rgba(245,158,11,.1); border-color: var(--fd-amber); color: #fcd97a; }

/* ── KPI row ── */
.fd-kpis {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: 1.5rem;
}
@media (max-width: 900px)  { .fd-kpis { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 500px)  { .fd-kpis { grid-template-columns: 1fr; } }

.fd-kpi {
  background: var(--fd-surface);
  border: 1px solid var(--fd-border);
  border-radius: var(--fd-radius);
  padding: 1.35rem 1.5rem;
  position: relative;
  overflow: hidden;
  transition: border-color .2s, transform .15s;
}
.fd-kpi:hover { border-color: var(--fd-border2); transform: translateY(-2px); }
.fd-kpi::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
}
.fd-kpi.kpi-revenue::before { background: linear-gradient(90deg, var(--fd-accent), transparent); }
.fd-kpi.kpi-paid::before    { background: linear-gradient(90deg, var(--fd-blue), transparent); }
.fd-kpi.kpi-pending::before { background: linear-gradient(90deg, var(--fd-amber), transparent); }
.fd-kpi.kpi-overdue::before { background: linear-gradient(90deg, var(--fd-red), transparent); }

.fd-kpi-icon {
  width: 34px; height: 34px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: .9rem;
  margin-bottom: .9rem;
}
.kpi-revenue .fd-kpi-icon { background: rgba(61,214,140,.12); color: var(--fd-accent); }
.kpi-paid    .fd-kpi-icon { background: rgba(79,142,247,.12); color: var(--fd-blue); }
.kpi-pending .fd-kpi-icon { background: rgba(245,158,11,.12); color: var(--fd-amber); }
.kpi-overdue .fd-kpi-icon { background: rgba(240,82,82,.12);  color: var(--fd-red); }

.fd-kpi-label { font-size: .78rem; color: var(--fd-muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: .4rem; }
.fd-kpi-value {
  font-family: 'Syne', sans-serif;
  font-size: 1.65rem; font-weight: 700; color: #fff;
  line-height: 1;
}
.fd-kpi-sub { font-size: .78rem; color: var(--fd-muted); margin-top: .35rem; }

/* ── panel / card ── */
.fd-panel {
  background: var(--fd-surface);
  border: 1px solid var(--fd-border);
  border-radius: var(--fd-radius);
  padding: 1.5rem;
}
.fd-panel-title {
  font-family: 'Syne', sans-serif;
  font-size: 1rem; font-weight: 600; color: #fff;
  margin: 0 0 1.25rem;
  display: flex; align-items: center; justify-content: space-between; gap: .5rem;
}
.fd-panel-title a { font-family: 'DM Sans', sans-serif; font-size: .8rem; font-weight: 400; color: var(--fd-muted); text-decoration: none; }
.fd-panel-title a:hover { color: var(--fd-accent); }

/* ── 2-col grid ── */
.fd-grid-2 { display: grid; grid-template-columns: 1fr 1.35fr; gap: 1rem; margin-bottom: 1rem; }
@media (max-width: 860px) { .fd-grid-2 { grid-template-columns: 1fr; } }

/* ── payment analytics ── */
.fd-gateway-list { display: flex; flex-direction: column; gap: .75rem; }
.fd-gateway-row {
  display: flex; align-items: center; gap: .9rem;
  padding: .85rem 1rem;
  background: var(--fd-surface2);
  border-radius: var(--fd-radius-sm);
  border: 1px solid var(--fd-border);
}
.fd-gateway-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.fd-gateway-name { font-size: .875rem; color: var(--fd-muted); flex: 1; }
.fd-gateway-amount { font-family: 'JetBrains Mono', monospace; font-size: .9rem; color: var(--fd-text); font-weight: 500; }

/* ── chart containers ── */
.fd-chart-wrap { position: relative; height: 220px; }
.fd-chart-wrap-tall { position: relative; height: 260px; }

/* ── table ── */
.fd-table-wrap { overflow-x: auto; }
table.fd-table { width: 100%; border-collapse: collapse; }
.fd-table th {
  font-size: .75rem; text-transform: uppercase; letter-spacing: .08em;
  color: var(--fd-muted); font-weight: 500;
  padding: .6rem 1rem;
  border-bottom: 1px solid var(--fd-border);
  white-space: nowrap;
}
.fd-table td { padding: .85rem 1rem; border-bottom: 1px solid var(--fd-border); font-size: .9rem; color: var(--fd-text); }
.fd-table tbody tr:last-child td { border-bottom: none; }
.fd-table tbody tr:hover td { background: var(--fd-surface2); }
.fd-table .mono { font-family: 'JetBrains Mono', monospace; font-size: .85rem; }
.fd-table .amount { text-align: right; font-family: 'JetBrains Mono', monospace; font-size: .88rem; }

/* badges */
.fd-badge {
  display: inline-flex; align-items: center; gap: .35rem;
  padding: .22rem .65rem;
  border-radius: 100px; font-size: .75rem; font-weight: 500;
}
.fd-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.fd-badge-paid    { background: rgba(61,214,140,.12); color: #6debb0; }
.fd-badge-paid::before { background: var(--fd-accent); }
.fd-badge-pending { background: rgba(245,158,11,.12); color: #fbd068; }
.fd-badge-pending::before { background: var(--fd-amber); }
.fd-badge-failed  { background: rgba(240,82,82,.12);  color: #f8908a; }
.fd-badge-failed::before  { background: var(--fd-red); }

/* ── alerts ── */
.fd-alerts { display: flex; flex-direction: column; gap: .6rem; }
.fd-alert-item {
  display: flex; align-items: center; gap: .85rem;
  padding: .8rem 1rem;
  background: rgba(240,82,82,.08);
  border: 1px solid rgba(240,82,82,.2);
  border-radius: var(--fd-radius-sm);
  font-size: .875rem; color: #f8908a;
}
.fd-alert-item i { font-size: .9rem; flex-shrink: 0; color: var(--fd-red); }
.fd-no-alerts { font-size: .875rem; color: var(--fd-muted); }

/* ── quick actions ── */
.fd-actions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: .85rem;
}
@media (max-width: 700px) { .fd-actions-grid { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 420px) { .fd-actions-grid { grid-template-columns: 1fr; } }

.fd-action-card {
  display: flex; flex-direction: column; align-items: flex-start;
  padding: 1.2rem;
  background: var(--fd-surface2);
  border: 1px solid var(--fd-border);
  border-radius: var(--fd-radius);
  text-decoration: none;
  transition: border-color .2s, background .2s, transform .15s;
  gap: .65rem;
}
.fd-action-card:hover {
  border-color: var(--fd-accent);
  background: rgba(61,214,140,.05);
  transform: translateY(-2px);
}
.fd-action-icon {
  width: 38px; height: 38px;
  border-radius: 9px;
  display: flex; align-items: center; justify-content: center;
  font-size: .95rem;
  background: var(--fd-surface);
  border: 1px solid var(--fd-border);
  color: var(--fd-accent);
  transition: background .2s, color .2s;
}
.fd-action-card:hover .fd-action-icon { background: rgba(61,214,140,.15); }
.fd-action-label { font-size: .9rem; font-weight: 600; color: var(--fd-text); line-height: 1; }
.fd-action-desc  { font-size: .78rem; color: var(--fd-muted); line-height: 1.45; }

/* ── section spacing ── */
.fd-section { margin-bottom: 1rem; }
</style>

<!-- ═══════════ PAGE ═══════════ -->
<div class="fd-page">

  <!-- Alert -->
  <div id="paymentSuccessAlert" role="alert"></div>

  <!-- Header -->
  <div class="fd-header">
    <div class="fd-header-left">
      <div class="fd-header-icon"><i class="fa-solid fa-chart-line"></i></div>
      <div>
        <h1 class="fd-page-title">Finance Dashboard</h1>
        <p class="fd-page-sub">Payment performance, invoice status &amp; finance alerts</p>
      </div>
    </div>
    <div class="fd-header-actions">
      <a href="/reports" class="fd-btn"><i class="fa-solid fa-download"></i> Export</a>
      <a href="/finance/payments" class="fd-btn fd-btn-primary"><i class="fa-solid fa-credit-card"></i> Payments</a>
    </div>
  </div>

  <!-- KPIs -->
  <div class="fd-kpis fd-section">
    <div class="fd-kpi kpi-revenue">
      <div class="fd-kpi-icon"><i class="fa-solid fa-circle-dollar-to-slot"></i></div>
      <div class="fd-kpi-label">Total Revenue</div>
      <div class="fd-kpi-value" id="financeTotalRevenue">SGD 0.00</div>
      <div class="fd-kpi-sub">Paid invoices</div>
    </div>
    <div class="fd-kpi kpi-paid">
      <div class="fd-kpi-icon"><i class="fa-solid fa-file-circle-check"></i></div>
      <div class="fd-kpi-label">Paid Invoices</div>
      <div class="fd-kpi-value" id="financePaidInvoices">0</div>
      <div class="fd-kpi-sub">Fully settled</div>
    </div>
    <div class="fd-kpi kpi-pending">
      <div class="fd-kpi-icon"><i class="fa-solid fa-hourglass-half"></i></div>
      <div class="fd-kpi-label">Pending Payments</div>
      <div class="fd-kpi-value" id="financePendingPayments">0</div>
      <div class="fd-kpi-sub">Awaiting settlement</div>
    </div>
    <div class="fd-kpi kpi-overdue">
      <div class="fd-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
      <div class="fd-kpi-label">Overdue Invoices</div>
      <div class="fd-kpi-value" id="financeOverdueInvoices">0</div>
      <div class="fd-kpi-sub">Requires action</div>
    </div>
  </div>

  <!-- Analytics row -->
  <div class="fd-grid-2 fd-section">
    <!-- Payment breakdown -->
    <div class="fd-panel">
      <div class="fd-panel-title">Payment Analytics</div>
      <div class="fd-gateway-list">
        <div class="fd-gateway-row">
          <span class="fd-gateway-dot" style="background:var(--fd-stripe)"></span>
          <span class="fd-gateway-name"><i class="fa-brands fa-stripe" style="margin-right:.4rem"></i>Stripe Revenue</span>
          <span class="fd-gateway-amount" id="stripeRevenue">SGD 0.00</span>
        </div>
        <div class="fd-gateway-row">
          <span class="fd-gateway-dot" style="background:var(--fd-paypal)"></span>
          <span class="fd-gateway-name"><i class="fa-brands fa-paypal" style="margin-right:.4rem"></i>PayPal Revenue</span>
          <span class="fd-gateway-amount" id="paypalRevenue">SGD 0.00</span>
        </div>
      </div>
    </div>
    <!-- Pie chart -->
    <div class="fd-panel">
      <div class="fd-panel-title">Gateway Share</div>
      <div class="fd-chart-wrap">
        <canvas id="paymentPieChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Recent payments -->
  <div class="fd-panel fd-section">
    <div class="fd-panel-title">
      Recent Payments
      <a href="/finance/payments">View all <i class="fa-solid fa-arrow-right" style="font-size:.7rem"></i></a>
    </div>
    <div class="fd-table-wrap">
      <table class="fd-table">
        <thead>
          <tr>
            <th>Invoice</th>
            <th>Method</th>
            <th class="amount">Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="recentPaymentsBody">
          <tr><td colspan="4" style="text-align:center;color:var(--fd-muted);padding:2rem">Loading payments…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Alerts -->
  <div class="fd-panel fd-section">
    <div class="fd-panel-title">Finance Alerts</div>
    <div id="financeAlerts" class="fd-alerts">
      <div class="fd-no-alerts">Loading alerts…</div>
    </div>
  </div>

  <!-- Monthly revenue -->
  <div class="fd-panel fd-section">
    <div class="fd-panel-title">Monthly Revenue</div>
    <div class="fd-chart-wrap-tall">
      <canvas id="monthlyRevenueChart"></canvas>
    </div>
  </div>

  <!-- Quick actions -->
  <div class="fd-panel fd-section">
    <div class="fd-panel-title">Quick Actions</div>
    <div class="fd-actions-grid">
      <a href="/invoices" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-file-invoice"></i></div>
        <div class="fd-action-label">Invoices</div>
        <div class="fd-action-desc">Create, view and manage invoices.</div>
      </a>
      <a href="/reports" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-chart-column"></i></div>
        <div class="fd-action-label">Reports</div>
        <div class="fd-action-desc">Financial summaries and exports.</div>
      </a>
      <a href="/finance/payments" class="fd-action-card">
