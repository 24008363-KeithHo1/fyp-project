<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Automated Invoicing & Payroll' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-ENjdO4Dr2bkBIFxQpeoA6VZbM0QF4Ykz1Z6q0Y5n3zV9zzTtmI3UksdQRVvoxMfoo" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles.css">
</head>
<%
  const pageTitle = typeof title !== 'undefined' ? title : '';
  const isAuthPage = pageTitle === 'Login';
%>
<body class="<%= isAuthPage ? 'auth-body' : '' %>">
  <% if (!isAuthPage) { %>
    <header class="site-header py-3">
      <div class="container d-flex justify-content-between align-items-center">
        <a class="navbar-brand app-brand mb-0 h4" href="/dashboard">
          <span class="app-brand-mark" aria-hidden="true"></span>
          <span class="app-brand-text">
            <span class="app-brand-name">Automated Invoicing & Payroll</span>
            <span class="app-brand-subtitle">Unified finance and HR workspace</span>
          </span>
        </a>
        <div>
          <button id="logout" class="btn btn-sm btn-danger d-none">Logout</button>
        </div>
      </div>
    </header>

    <script>
      // Toggle Login/Logout visibility based on token
      (function(){
        const logoutBtn = document.getElementById('logout');
        function updateAuthUI(){
          const hasToken = !!localStorage.getItem('token');
          if (hasToken) logoutBtn.classList.remove('d-none');
          else logoutBtn.classList.add('d-none');
        }
        updateAuthUI();
        logoutBtn?.addEventListener('click', ()=>{ localStorage.removeItem('token'); updateAuthUI(); location = '/login'; });
        window.addEventListener('storage', (e)=>{ if (e.key === 'token') updateAuthUI(); });
      })();
    </script>
    <main class="app-container container my-4">
  <% } else { %>
    <main class="auth-main">
  <% } %>
