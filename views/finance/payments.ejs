<script>
let allInvoices = [];
let allPayments = [];
let paypalSdkPromise;
let netsStatusPoller;

const paymentTabs = Array.from(document.querySelectorAll('#paymentMethodTabs .nav-link'));
const paymentPanels = Array.from(document.querySelectorAll('.payment-workspace-panel .payment-tab-panel'));

function activatePaymentTab(tab){
  const targetId = tab.dataset.paymentTarget;
  if (!targetId) return;

  paymentTabs.forEach(item => {
    const isActive = item === tab;
    item.classList.toggle('active', isActive);
    item.setAttribute('aria-selected', String(isActive));
    item.tabIndex = isActive ? 0 : -1;
  });

  paymentPanels.forEach(panel => {
    const isActive = panel.id === targetId;
    panel.classList.toggle('active', isActive);
    panel.classList.toggle('show', isActive);
    panel.hidden = !isActive;
  });
}

paymentTabs.forEach((tab, index) => {
  tab.addEventListener('click', () => activatePaymentTab(tab));
  tab.addEventListener('keydown', event => {
    const isPrevious = event.key === 'ArrowLeft' || event.key === 'ArrowUp';
    const isNext = event.key === 'ArrowRight' || event.key === 'ArrowDown';
    const isBoundary = event.key === 'Home' || event.key === 'End';
    if (!isPrevious && !isNext && !isBoundary) return;

    event.preventDefault();
    const nextIndex = event.key === 'Home'
      ? 0
      : event.key === 'End'
        ? paymentTabs.length - 1
        : (index + (isNext ? 1 : -1) + paymentTabs.length) % paymentTabs.length;
    const nextTab = paymentTabs[nextIndex];
    nextTab.focus();
    activatePaymentTab(nextTab);
  });
});

function money(value, currency){
  return `${currency || 'SGD'} ${Number(value || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}

function normalizeStatus(status){
  if (status === 'refunded') return 'Refunded';
  if (status === 'COMPLETED' || status === 'paid') return 'Paid';
  return status || 'Paid';
}

function statusBadge(status, method){
  const cleanStatus = normalizeStatus(status);
  if (cleanStatus === 'Paid') return '<span class="badge bg-success">Paid</span>';
  if (cleanStatus === 'Pending') return '<span class="badge bg-warning text-dark">Pending</span>';
  if (cleanStatus === 'Failed') return '<span class="badge bg-danger">Failed</span>';
  if (cleanStatus === 'Refunded') {
    return '<span class="badge payment-status-reversed" title="Payment reversal / Supplier refund">Reversed</span>';
  }
  return `<span class="badge bg-secondary">${cleanStatus}</span>`;
}

function showAlert(message, type){
  const container = document.getElementById('paymentAlerts');
  container.innerHTML = `
    <div class="finance-alert ${type === 'success' ? 'finance-alert-success' : ''}">
      <i class="fa-solid ${type === 'success' ? 'fa-circle-check' : 'fa-triangle-exclamation'}" aria-hidden="true"></i>
      <span>${message}</span>
    </div>
  `;
}

function clearAlerts(){
  document.getElementById('paymentAlerts').innerHTML = '';
}

async function fetchJson(url, options){
  const res = await fetch(url, {
    ...(options || {}),
    headers: {
      authorization: 'Bearer ' + token,
      ...((options && options.headers) || {})
    }
  });
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || 'Request failed');
  return data;
}

async function loadPayPalSdk(){
  if (window.paypal) return window.paypal;
  if (!paypalSdkPromise) {
    paypalSdkPromise = fetch('/payment/paypal/config', {
      headers: { authorization: 'Bearer ' + token }
    }).then(async res => {
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Unable to load PayPal configuration');
      return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(data.clientId)}&currency=${encodeURIComponent(data.currency)}`;
        script.onload = () => resolve(window.paypal);
        script.onerror = () => reject(new Error('Unable to load PayPal SDK'));
        document.head.appendChild(script);
      });
    });
  }
  return paypalSdkPromise;
}

function populateInvoiceSelect(selectId, invoices){
  const select = document.getElementById(selectId);
  if (!select) return;
  const unpaid = invoices.filter(inv => inv.status !== 'Paid');
  select.innerHTML = '';

  if (!unpaid.length) {
    select.innerHTML = '<option value="">No unpaid invoices</option>';
    select.disabled = true;
    return;
  }

  select.disabled = false;
  unpaid.forEach(inv => {
    const option = document.createElement('option');
    option.value = inv.id;
    option.textContent = `${inv.number} - ${inv.customer_name} - ${money(inv.amount, inv.currency || 'SGD')}`;
    option.dataset.invoiceNumber = inv.number;
    select.appendChild(option);
  });
}

// Added: loads unpaid invoices into each payment method dropdown.
async function loadInvoices(){
  allInvoices = await fetchJson('/api/invoices');
  populateInvoiceSelect('stripeInvoiceId', allInvoices);
  populateInvoiceSelect('paypalInvoiceId', allInvoices);
  populateInvoiceSelect('netsInvoiceId', allInvoices);
}

function paymentDate(payment){
  return payment.paidAt ? new Date(payment.paidAt) : null;
}

function isToday(date){
  if (!date) return false;
  const now = new Date();
  return date.getFullYear() === now.getFullYear() && date.getMonth() === now.getMonth() && date.getDate() === now.getDate();
}

// Added: calculates payment totals shown in the finance KPI cards.
function updateSummaryCards(payments){
  const totalPaidToday = payments
    .filter(payment => normalizeStatus(payment.status) === 'Paid' && isToday(paymentDate(payment)))
    .reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
  const stripeTotal = payments
    .filter(payment => payment.method === 'Stripe' && normalizeStatus(payment.status) === 'Paid')
    .reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
  const paypalTotal = payments
    .filter(payment => payment.method === 'PayPal' && normalizeStatus(payment.status) === 'Paid')
    .reduce((sum, payment) => sum + Number(payment.amount || 0), 0);
  const unpaidInvoices = allInvoices.filter(invoice => invoice.status !== 'Paid').length;

  document.getElementById('totalPaidToday').textContent = money(totalPaidToday);
  document.getElementById('stripePayments').textContent = money(stripeTotal);
  document.getElementById('paypalPayments').textContent = money(paypalTotal);
  document.getElementById('pendingTransfers').textContent = unpaidInvoices;
}

function filteredPayments(){
  const search = document.getElementById('paymentSearch').value.trim().toLowerCase();
  const method = document.getElementById('methodFilter').value;
  const status = document.getElementById('statusFilter').value;
  const dateFrom = document.getElementById('dateFrom').value ? new Date(document.getElementById('dateFrom').value) : null;
  const dateTo = document.getElementById('dateTo').value ? new Date(document.getElementById('dateTo').value + 'T23:59:59') : null;

  return allPayments.filter(payment => {
    const haystack = `${payment.invoiceNumber || ''} ${payment.providerReference || ''} ${payment.customerName || ''}`.toLowerCase();
    const paidDate = paymentDate(payment);
    if (search && !haystack.includes(search)) return false;
    if (method && payment.method !== method) return false;
    if (status && normalizeStatus(payment.status) !== status) return false;
    if (dateFrom && (!paidDate || paidDate < dateFrom)) return false;
    if (dateTo && (!paidDate || paidDate > dateTo)) return false;
    return true;
  });
}

// Added: renders the searchable payment history table.
function renderPayments(){
  const payments = filteredPayments();
  const tbody = document.getElementById('historyBody');
  document.getElementById('paymentCount').textContent = `${payments.length} payment${payments.length === 1 ? '' : 's'}`;
  tbody.innerHTML = '';

  if (!payments.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="text-muted text-center">No payments match your filters</td></tr>';
    return;
  }

  payments.forEach(payment => {
    const date = paymentDate(payment);
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${date ? date.toLocaleString() : ''}</td>
      <td>${payment.invoiceNumber || ''}</td>
      <td>${payment.customerName || ''}</td>
      <td><span class="method-pill method-${payment.method}">${payment.method || ''}</span></td>
      <td class="text-end">${money(payment.amount, payment.currency)}</td>
      <td>${statusBadge(payment.status, payment.method)}</td>
      <td class="text-break">${paymentReferenceDetails(payment)}</td>
      <td class="payment-action-cell">
        <div class="payment-action-group" aria-label="Payment actions for ${payment.invoiceNumber || 'invoice'}">
          <a class="payment-history-btn invoice-btn" href="/api/invoices/${payment.invoiceId}/pdf" target="_blank" rel="noopener">Supplier invoice</a>
          <a class="payment-history-btn receipt-btn" href="/api/invoices/${payment.invoiceId}/pdf" target="_blank" rel="noopener" download>Receipt</a>
          ${normalizeStatus(payment.status) === 'Paid' ? `<button class="payment-history-btn refund-btn refund-payment-btn" type="button" data-payment-id="${payment.id}">Payment reversal</button>` : ''}
          ${normalizeStatus(payment.status) !== 'Paid' ? `<button class="payment-history-btn delete-payment-btn" type="button" data-payment-id="${payment.id}">Delete</button>` : ''}
        </div>
      </td>
    `;
    tbody.appendChild(tr);
  });
}

// Added: shows the latest payment activity in a short readable feed.
function renderRecentActivity(){
  const container = document.getElementById('recentActivity');
  if (!allPayments.length) {
    container.innerHTML = '<div class="text-muted">No payment activity yet.</div>';
    return;
  }

  container.innerHTML = allPayments.slice(0, 5).map(payment => {
    const status = normalizeStatus(payment.status);
  const action = status === 'Refunded'
      ? `${payment.invoiceNumber} reversed via ${payment.method}`
      : status === 'Failed'
      ? `${payment.method} payment failed for ${payment.invoiceNumber}`
      : payment.method === 'NETS'
          ? `${payment.invoiceNumber} recorded as NETS ${payment.data && payment.data.confirmationType === 'manual_finance_confirmation' ? 'manual finance confirmation' : 'payment'}`
        : `${payment.invoiceNumber} paid via ${payment.method}`;
    return `<div class="activity-item">${statusBadge(status, payment.method)} <span>${action}</span></div>`;
  }).join('');
}

function paymentReferenceDetails(payment){
  const refund = payment.data && payment.data.refund;
  if (normalizeStatus(payment.status) === 'Refunded' && refund) {
    return `
      <div>${refund.refundReference || payment.providerReference || ''}</div>
      <small class="text-muted d-block">Supplier bank account: ${refund.testBankAccountNumber || '-'}</small>
      <small class="text-muted d-block">Bank ref: ${refund.testBankReference || '-'}</small>
    `;
  }
  if (payment.method === 'NETS' && payment.data && payment.data.confirmationType === 'manual_finance_confirmation') {
    return `
      <div>${payment.providerReference || ''}</div>
      <small class="text-muted d-block">Manual finance confirmation for demonstration or reconciliation purposes.</small>
      <small class="text-muted d-block">Does not independently prove NETS settlement.</small>
    `;
  }
  return payment.providerReference || '';
}

// Added: deletes a payment history record and refreshes the finance payments page.
async function deletePayment(paymentId, button){
  const payment = allPayments.find(item => Number(item.id) === Number(paymentId));
  if (!payment) return showAlert('Payment not found');
  if (normalizeStatus(payment.status) === 'Paid') return showAlert('Paid supplier payment records cannot be deleted. Record a payment reversal first.');
  if (!confirm(`Delete supplier payment history for ${payment.invoiceNumber || 'this supplier invoice'}? This cannot be undone.`)) return;

  try {
    if (button) {
      button.disabled = true;
      button.textContent = 'Deleting...';
    }
    await fetchJson(`/payment/history/${paymentId}`, { method: 'DELETE' });
    showAlert('Payment history record deleted.', 'success');
    await refreshPayments();
  } catch (err) {
    showAlert(err.message);
  } finally {
    if (button) {
      button.disabled = false;
      button.textContent = 'Delete';
    }
  }
}

// Added: lets finance record a payment reversal and reopens the supplier invoice for repayment.
async function refundPayment(paymentId, button){
  const payment = allPayments.find(item => Number(item.id) === Number(paymentId));
  if (!payment) return showAlert('Payment not found');

  try {
    showAlert(`Recording payment reversal for ${payment.invoiceNumber || 'supplier payment'}...`);
    if (button) {
      button.disabled = true;
      button.textContent = 'Reversing...';
    }
    await fetchJson(`/payment/${paymentId}/refund`, {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ reason: 'Payment reversal recorded by finance' })
    });
    showAlert('Payment reversal recorded and supplier invoice reopened.', 'success');
    await refreshPayments();
  } catch (err) {
    showAlert(err.message);
  } finally {
    if (button) {
      button.disabled = false;
      button.textContent = 'Payment reversal';
    }
  }
}

async function loadPayments(){
  allPayments = await fetchJson('/payment/history');
  updateSummaryCards(allPayments);
  renderPayments();
  renderRecentActivity();
}

async function refreshPayments(){
  const btn = document.getElementById('paymentsRefreshBtn');
  btn?.classList.add('pmt-spinning');
  clearAlerts();
  try {
    await Promise.all([loadInvoices(), loadPayments()]);
    const lastUpdatedEl = document.getElementById('pmtLastUpdated');
    if (lastUpdatedEl) lastUpdatedEl.textContent = `Updated ${new Date().toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })}`;
  } catch (err) {
    const lastUpdatedEl = document.getElementById('pmtLastUpdated');
    if (lastUpdatedEl) lastUpdatedEl.textContent = 'Update failed — retry';
  } finally {
    setTimeout(() => btn?.classList.remove('pmt-spinning'), 600);
  }
}

// Scroll-spy for the sticky section nav — same pattern as the Finance Dashboard.
(function () {
  const navLinks = Array.from(document.querySelectorAll('.pmt-section-nav a'));
  if (!navLinks.length || !('IntersectionObserver' in window)) return;
  const sections = navLinks.map(a => document.getElementById(a.getAttribute('href').slice(1))).filter(Boolean);
  const setActive = (id) => {
    navLinks.forEach(a => a.classList.toggle('pmt-section-active', a.getAttribute('href') === `#${id}`));
  };
  const observer = new IntersectionObserver((entries) => {
    const visible = entries.filter(e => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio);
    if (visible.length) setActive(visible[0].target.id);
  }, { rootMargin: '-72px 0px -60% 0px', threshold: [0, .25, .5, .75, 1] });
  sections.forEach(section => observer.observe(section));
})();

// Added: starts Stripe Checkout for the selected unpaid invoice.
async function startStripePayment(){
  const invoiceId = document.getElementById('stripeInvoiceId').value;
  if (!invoiceId) return showAlert('Select an unpaid invoice first');
  try {
    const data = await fetchJson(`/payment/checkout/${invoiceId}`, { method: 'POST' });
    if (data.url) location = data.url;
  } catch (err) {
    showAlert(err.message);
  }
}

// Added: renders PayPal buttons and records payment after PayPal capture succeeds.
async function renderPayPalButtons(){
  const invoiceId = document.getElementById('paypalInvoiceId').value;
  const container = document.getElementById('paypalButtons');
  container.innerHTML = '';
  if (!invoiceId) return showAlert('Select an unpaid invoice first');

  try {
    const paypal = await loadPayPalSdk();
    paypal.Buttons({
      createOrder: async () => {
        const data = await fetchJson(`/payment/paypal/orders/${invoiceId}`, { method: 'POST' });
        return data.id;
      },
      onApprove: async data => {
        await fetchJson(`/payment/paypal/orders/${data.orderID}/capture`, { method: 'POST' });
        showAlert('PayPal payment recorded successfully', 'success');
        await refreshPayments();
      },
      onError: err => showAlert(err.message || 'PayPal payment failed')
    }).render(container);
  } catch (err) {
    showAlert(err.message || 'Unable to load PayPal');
  }
}

// Added: opens the dedicated NETS scan-to-pay page for the selected unpaid invoice.
async function loadNETSQr(){
  const invoiceId = document.getElementById('netsInvoiceId').value;
  if (netsStatusPoller) clearInterval(netsStatusPoller);
  if (!invoiceId) return showAlert('Select an unpaid invoice first');
  window.location.href = `/payment/nets/${invoiceId}/page?return=${encodeURIComponent('/finance/payments')}`;
}

function pollNETSPaymentStatus(invoiceId, txnRetrievalRef){
  const statusEl = document.getElementById('netsLiveStatus');
  let attempts = 0;

  netsStatusPoller = setInterval(async () => {
    attempts += 1;
    try {
      const status = await fetchJson(`/payment/nets/${invoiceId}/status/${encodeURIComponent(txnRetrievalRef)}${attempts >= 60 ? '?timeout=1' : ''}`);
      if (statusEl) statusEl.textContent = status.paid ? 'NETS payment received.' : 'Waiting for NETS sandbox payment...';
      if (status.paid) {
        clearInterval(netsStatusPoller);
        await completeNETSPayment(invoiceId, txnRetrievalRef);
      } else if (status.failed || attempts >= 60) {
        clearInterval(netsStatusPoller);
        if (statusEl) statusEl.textContent = 'NETS payment was not completed.';
      }
    } catch (err) {
      if (statusEl) statusEl.textContent = err.message || 'Unable to check NETS payment status.';
      clearInterval(netsStatusPoller);
    }
  }, 5000);
}

async function completeNETSPayment(invoiceId, reference){
  await fetchJson(`/payment/nets/${invoiceId}/complete`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ reference })
  });
  showAlert('NETS payment recorded from sandbox status query', 'success');
  document.getElementById('netsQrBox').innerHTML = '';
  await refreshPayments();
}

async function recordNETSPayment(invoiceId, reference, note){
  const data = await fetchJson(`/payment/nets/${invoiceId}/confirm`, {
    method: 'POST',
    headers: { 'content-type': 'application/json' },
    body: JSON.stringify({
      method: 'NETS',
      reference,
      paidAt: new Date().toISOString(),
      note
    })
  });
  showAlert(data.notice || 'Manual finance confirmation recorded for demonstration or reconciliation purposes', 'success');
  document.getElementById('netsQrBox').innerHTML = '';
  await refreshPayments();
}

// Added: lets finance manually record a NETS reference for demo/reconciliation.
async function confirmNETSPayment(invoiceId, reference){
  const confirmedReference = prompt('Manual finance confirmation for demonstration or reconciliation purposes. Enter NETS transaction/reference:', reference || '');
  if (!confirmedReference) return showAlert('NETS reference is required');

  try {
    if (netsStatusPoller) clearInterval(netsStatusPoller);
    await recordNETSPayment(invoiceId, confirmedReference, 'Manual finance confirmation for demonstration or reconciliation purposes');
  } catch (err) {
    showAlert(err.message);
  }
}

document.getElementById('historyBody').addEventListener('click', event => {
  const deleteButton = event.target.closest('.delete-payment-btn');
  if (deleteButton) {
    if (deleteButton.disabled) return;
    deletePayment(deleteButton.dataset.paymentId, deleteButton);
    return;
  }

  const button = event.target.closest('.refund-payment-btn');
  if (!button) return;
  if (button.disabled) return;
  refundPayment(button.dataset.paymentId, button);
});
['paymentSearch','methodFilter','statusFilter','dateFrom','dateTo'].forEach(id => {
  document.getElementById(id).addEventListener('input', renderPayments);
});

refreshPayments().catch(err => {
  document.getElementById('historyBody').innerHTML = `<tr><td colspan="8" class="text-danger">${err.message}</td></tr>`;
});
</script>

