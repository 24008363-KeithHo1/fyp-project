<%- include('../partials/header', { title: 'HR Leave Requests' }) %>
<%- include('../partials/navbar') %>

<div class="container mt-4">
  <h2>HR Leave Requests</h2>
  <div class="content-card requests-card mt-3">
    <% if (!requests || !requests.length) { %>
      <div class="alert alert-info">No leave requests.</div>
    <% } else { %>
      <div class="table-responsive mt-2">
        <table class="table table-striped table-hover table-bordered align-middle table-sm">
          <thead>
            <tr>
              <th>#</th>
              <th>From</th>
              <th>Title</th>
              <th>Message</th>
              <th>Leave Dates</th>
              <th>Status</th>
              <th>Attachments</th>
              <th>Created</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(r => { %>
              <tr>
                <td><%= r.id %></td>
                <td><%= r.senderName || r.senderId %></td>
                <td><a href="/requests/<%= r.id %>/view"><%= r.title %></a></td>
                <td><%= r.message && r.message.length > 120 ? (r.message.substring(0,120) + '...') : r.message %></td>
                <td>
                  <% if (r.data && r.data.startDate) { %>
                    <div><strong><%= r.data.startDate %></strong> - <%= r.data.endDate %></div>
                    <% if (r.data.halfDay && r.data.halfDay !== 'none') { %>
                      <div><small>Half day: <%= r.data.halfDay %></small></div>
                    <% } %>
                  <% } %>
                </td>
                <td id="status-<%= r.id %>">
                  <span class="badge <%= r.status === 'Pending' ? 'bg-warning text-dark' : (r.status === 'Completed' || r.status === 'Approved' ? 'bg-success' : (r.status === 'Denied' ? 'bg-danger' : 'bg-secondary')) %>"><%= r.status %></span>
                </td>
                <td>
                  <% if (r.data && Array.isArray(r.data.attachments) && r.data.attachments.length) { %>
                    <% r.data.attachments.forEach(a => { %>
                      <div><a href="<%= a.path %>" target="_blank" rel="noopener noreferrer"><%= a.originalname %></a></div>
                    <% }) %>
                  <% } %>
                </td>
                <td><%= new Date(r.createdAt).toLocaleString() %></td>
                <td>
                  <select id="sel-<%= r.id %>" class="form-select form-select-sm">
                    <option value="Pending" <%= r.status==='Pending' ? 'selected' : '' %>>Pending</option>
                    <option value="Approved" <%= r.status==='Approved' ? 'selected' : '' %>>Approved</option>
                    <option value="Denied" <%= r.status==='Denied' ? 'selected' : '' %>>Denied</option>
                    
                  </select>
                  <button class="btn btn-sm btn-primary mt-1 update-btn" data-id="<%= r.id %>">Update</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
async function updateStatus(id){
  const sel = document.getElementById('sel-'+id);
  const status = sel.value;
  const token = localStorage.getItem('token');
  const res = await fetch('/api/requests/'+id+'/status', { method: 'PUT', headers: { 'Content-Type':'application/json', Authorization: `Bearer ${token}` }, body: JSON.stringify({ status }) });
  if (res.ok) {
      const badgeClass = (s) => {
        if (s === 'Pending') return 'bg-warning text-dark';
        if (s === 'Completed' || s === 'Approved') return 'bg-success';
        if (s === 'Denied') return 'bg-danger';
        return 'bg-secondary';
      };
      document.getElementById('status-'+id).innerHTML = `<span class="badge ${badgeClass(status)}">${status}</span>`;
  } else alert('Failed to update');
}

document.querySelectorAll('.update-btn').forEach(b => b.addEventListener('click', (e) => {
  const id = e.currentTarget.dataset.id;
  updateStatus(id);
}));
</script>

<%- include('../partials/footer') %>
