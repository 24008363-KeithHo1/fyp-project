<%- include('../partials/header', { title: 'Edit User' }) -%>
<%- include('../partials/navbar') -%>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root{--ae-text:#102033;--ae-muted:#64748b;--ae-border:rgba(148,163,184,.18);--ae-radius:8px;--ae-shadow:0 14px 30px rgba(15,23,42,.08)}
  body:has(.admin-edit-workspace){background:linear-gradient(135deg,#f7faf8 0%,#e8f7ee 48%,#f8fbf9 100%)!important;color:var(--ae-text);font-family:'Sora',sans-serif}.admin-edit-workspace{max-width:900px;margin:0 auto;padding:1.1rem;box-sizing:border-box;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(248,250,252,.94)),linear-gradient(90deg,rgba(6,182,212,.12),rgba(124,58,237,.12));animation:admin-edit-in .4s cubic-bezier(.22,.8,.36,1) both}@keyframes admin-edit-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .admin-edit-hero{position:relative;overflow:hidden;display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;padding:1.35rem;border:1px solid rgba(37,99,235,.18);border-radius:var(--ae-radius);background:linear-gradient(135deg,rgba(15,23,42,.94),rgba(37,99,235,.86) 46%,rgba(11,143,62,.82));box-shadow:0 18px 38px rgba(15,23,42,.16)}.admin-edit-hero::after{position:absolute;right:-56px;bottom:-84px;width:260px;height:150px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.03));content:'';transform:rotate(-18deg)}.admin-edit-hero>*{position:relative;z-index:1}.admin-edit-eyebrow{display:inline-flex;align-items:center;gap:.42rem;min-height:24px;margin:0 0 .3rem;padding:.25rem .58rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-size:.72rem;font-weight:700}.admin-edit-title{margin:0;color:#fff;font-size:1.75rem;font-weight:700}.admin-edit-subtitle{margin:.35rem 0 0;color:#fff;font-size:.875rem;opacity:.88}
  .admin-edit-panel{border:1px solid var(--ae-border);border-radius:var(--ae-radius);background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(240,249,255,.78));box-shadow:var(--ae-shadow);padding:1.25rem}.admin-edit-panel-title{display:flex;align-items:center;gap:.52rem;margin:0 0 1rem;color:var(--ae-text);font-size:.95rem;font-weight:700}.admin-edit-panel-title i{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#0f766e,#22c55e);color:#fff;font-size:.8rem}.admin-edit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.admin-edit-field{display:grid;gap:.35rem}.admin-edit-field-wide{grid-column:1/-1}.admin-edit-field label{color:var(--ae-muted);font-size:.78rem;font-weight:700}.admin-edit-field .form-control,.admin-edit-field .form-select{min-height:42px;margin:0;border-color:rgba(148,163,184,.28);border-radius:8px;background:#fff}.admin-edit-field .form-control:focus,.admin-edit-field .form-select:focus{border-color:#06b6d4;box-shadow:0 0 0 .2rem rgba(6,182,212,.16)}.admin-edit-field .form-control:disabled{background:#f1f5f9;color:#64748b}.admin-edit-alert{margin:0;border:0;border-radius:8px;box-shadow:0 10px 20px rgba(245,158,11,.12);font-size:.82rem}.admin-edit-check{display:flex;align-items:center;gap:.55rem;margin-top:.15rem}.admin-edit-check .form-check-input{margin:0;border-color:rgba(148,163,184,.4)}.admin-edit-actions{display:flex;justify-content:flex-end;gap:.6rem;margin-top:1.25rem}.admin-edit-save{border:0!important;border-radius:8px!important;background:linear-gradient(135deg,#0b8f3e,#84cc16)!important;box-shadow:0 10px 20px rgba(11,143,62,.2);font-size:.8rem;font-weight:800}.admin-edit-cancel{border:1px solid rgba(148,163,184,.32)!important;border-radius:8px!important;background:#fff!important;color:#475569!important;font-size:.8rem;font-weight:800}@media(max-width:600px){.admin-edit-workspace{padding:.85rem}.admin-edit-hero{padding:1rem;align-items:flex-start}.admin-edit-panel{padding:1rem}.admin-edit-grid{grid-template-columns:1fr}.admin-edit-actions .btn{flex:1 1 0}}
</style>

<section class="admin-edit-workspace">
  <header class="admin-edit-hero">
    <div>
      <p class="admin-edit-eyebrow"><i class="fa-solid fa-user-gear" aria-hidden="true"></i> Access administration</p>
      <h1 class="admin-edit-title">Edit User</h1>
      <p class="admin-edit-subtitle">Review the account role and access status before saving changes.</p>
    </div>
  </header>

  <section class="admin-edit-panel" aria-labelledby="accountSettingsTitle">
    <h2 class="admin-edit-panel-title" id="accountSettingsTitle"><i class="fa-solid fa-sliders" aria-hidden="true"></i> Account Settings</h2>
    <form method="post" action="/admin/users/<%= user.id %>">
      <div class="admin-edit-grid">
        <div class="admin-edit-field">
          <label for="userName">Name</label>
          <input id="userName" class="form-control" value="<%= user.name %>" disabled>
        </div>
        <div class="admin-edit-field">
          <label for="userEmail">Email</label>
          <input id="userEmail" class="form-control" value="<%= user.email %>" disabled>
        </div>
        <% const isSelf = user.id === currentUserId; %>
        <% if (isSelf) { %>
          <div class="alert alert-warning admin-edit-alert admin-edit-field-wide" role="alert">You are editing your own account. To prevent accidental lockout, you cannot change your own role away from Admin or deactivate yourself here.</div>
        <% } %>
        <div class="admin-edit-field">
          <label for="userRole">Role</label>
          <select id="userRole" name="role" class="form-select" <%= isSelf ? 'disabled' : '' %>>
            <option value="Admin" <%= user.role === 'Admin' ? 'selected' : '' %>>Admin</option>
            <option value="Finance" <%= user.role === 'Finance' ? 'selected' : '' %>>Finance</option>
            <option value="HR" <%= user.role === 'HR' ? 'selected' : '' %>>HR</option>
            <option value="Staff" <%= user.role === 'Staff' ? 'selected' : '' %>>Staff</option>
          </select>
          <% if (isSelf) { %><input type="hidden" name="role" value="<%= user.role %>"><% } %>
        </div>
        <div class="admin-edit-field">
          <label>Account Status</label>
          <div class="admin-edit-check">
            <input class="form-check-input" type="checkbox" name="isActive" id="isActive" <%= user.isActive ? 'checked' : '' %> <%= isSelf ? 'disabled' : '' %>>
            <label class="form-check-label" for="isActive">Active account</label>
          </div>
          <% if (isSelf) { %><input type="hidden" name="isActive" value="on"><% } %>
        </div>
        <div class="admin-edit-field admin-edit-field-wide">
          <label>Two-Factor Authentication</label>
          <% if (user.mfaEnabled) { %>
            <div class="admin-edit-check" style="justify-content: space-between;">
              <span style="color: #15803d; font-weight: 700; font-size: .85rem;">
                <i class="fa-solid fa-shield-halved"></i> Enabled
              </span>
              <form method="post" action="/admin/users/<%= user.id %>/reset-mfa" onsubmit="return confirm('Reset MFA for this user? They will be logged in without MFA until they set it up again on a new device. Use this only if the user has lost access to their authenticator app.');">
                <button type="submit" class="btn btn-sm btn-outline-danger">Reset MFA</button>
              </form>
            </div>
            <p class="text-muted" style="font-size: .78rem; margin: .35rem 0 0;">
              Use "Reset MFA" only if this user has lost access to their authenticator device — it disables MFA immediately so they can log back in, then set it up again themselves from their profile.
            </p>
          <% } else { %>
            <span class="text-muted" style="font-size: .85rem;">Not enabled</span>
          <% } %>
        </div>
      </div>
      <div class="admin-edit-actions">
        <a class="btn admin-edit-cancel" href="/admin/users">Cancel</a>
        <button class="btn admin-edit-save" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> Save Changes</button>
      </div>
    </form>
  </section>
</section>

<%- include('../partials/footer') -%>
