<%- include('partials/header', { title: 'Invoices' }) %>
<%- include('partials/navbar') %>
  <script>const token = localStorage.getItem('token'); if (!token) location = '/login';</script>

  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

  <style>
  :root {
    --inv-bg: #f0fdf4;
    --inv-surface: #ffffff;
    --inv-surface2: #f8fdf9;
    --inv-border: #d1fae5;
    --inv-border2: #bbf7d0;
    --inv-text: #0f1c14;
    --inv-muted: #6b8c78;
    --inv-accent: #16a34a;
    --inv-accent2: #22c55e;
    --inv-blue: #2563eb;
    --inv-amber: #d97706;
    --inv-red: #dc2626;
    --inv-radius: 16px;
    --inv-radius-sm: 10px;
    --inv-shadow-sm: 0 1px 3px rgba(6,78,39,.08), 0 1px 2px rgba(6,78,39,.04);
    --inv-shadow-md: 0 4px 16px rgba(6,78,39,.1), 0 2px 6px rgba(6,78,39,.06);
  }

  body {
    background: var(--inv-bg) !important;
    color: var(--inv-text);
    font-family: 'Sora', sans-serif;
  }

  .invoice-page {
    max-width: 1280px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
    animation: invoice-in .45s cubic-bezier(.22,.8,.36,1) both;
  }

  @keyframes invoice-in {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  .invoice-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--inv-border);
  }

  .invoice-header-left {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .invoice-header-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
    border: 1px solid var(--inv-border2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    color: var(--inv-accent);
  }

  .invoice-title {
    font-family: 'Sora', sans-serif;
    font-size: 1.65rem;
    font-weight: 700;
    color: var(--inv-text);
    margin: 0;
    line-height: 1;
  }

  .invoice-subtitle {
    font-size: .875rem;
    color: var(--inv-muted);
    margin: .35rem 0 0;
  }

  .invoice-header-actions {
    display: flex;
    gap: .6rem;
    flex-wrap: wrap;
  }

  .invoice-btn {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .5rem 1.05rem;
    border-radius: var(--inv-radius-sm);
    font-family: 'Sora', sans-serif;
    font-size: .85rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: all .15s;
    border: 1.5px solid var(--inv-border2);
    background: var(--inv-surface);
    color: var(--inv-text);
    box-shadow: var(--inv-shadow-sm);
  }

  .invoice-btn:hover {
    background: var(--inv-surface2);
    border-color: var(--inv-accent);
    color: var(--inv-accent);
    transform: translateY(-1px);
  }

  .invoice-btn-primary {
    background: var(--inv-accent);
    border-color: var(--inv-accent);
    color: #fff;
    font-weight: 600;
  }

  .invoice-btn-primary:hover {
    background: var(--inv-accent2);
    border-color: var(--inv-accent2);
    color: #fff;
  }

  .invoice-kpis {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .invoice-kpi {
    background: var(--inv-surface);
    border: 1px solid var(--inv-border);
    border-radius: var(--inv-radius);
    padding: 1.15rem 1.25rem;
    position: relative;
    overflow: hidden;
    transition: border-color .2s, transform .15s, box-shadow .2s;
    box-shadow: var(--inv-shadow-sm);
  }

  .invoice-kpi:hover {
    border-color: var(--inv-border2);
    transform: translateY(-2px);
    box-shadow: var(--inv-shadow-md);
  }

  .invoice-kpi::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
  }

  .invoice-kpi.kpi-count::before { background: linear-gradient(90deg, var(--inv-accent), transparent); }
  .invoice-kpi.kpi-paid::before { background: linear-gradient(90deg, var(--inv-blue), transparent); }
  .invoice-kpi.kpi-pending::before { background: linear-gradient(90deg, var(--inv-amber), transparent); }
  .invoice-kpi.kpi-overdue::before { background: linear-gradient(90deg, var(--inv-red), transparent); }

  .invoice-kpi-icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .9rem;
    margin-bottom: .85rem;
  }

  .kpi-count .invoice-kpi-icon { background: rgba(61,214,140,.12); color: var(--inv-accent); }
  .kpi-paid .invoice-kpi-icon { background: rgba(79,142,247,.12); color: var(--inv-blue); }
  .kpi-pending .invoice-kpi-icon { background: rgba(245,158,11,.12); color: var(--inv-amber); }
  .kpi-overdue .invoice-kpi-icon { background: rgba(240,82,82,.12); color: var(--inv-red); }

  .invoice-kpi-label {
    font-size: .78rem;
    color: var(--inv-muted);
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: .35rem;
  }

  .invoice-kpi-value {
    font-family: 'Sora', sans-serif;
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--inv-text);
    line-height: 1;
  }

  .invoice-kpi-sub {
    font-size: .78rem;
    color: var(--inv-muted);
    margin-top: .35rem;
  }

  .invoice-grid {
    display: grid;
    grid-template-columns: 1.15fr 1.3fr;
    gap: 1rem;
  }

  @media (max-width: 980px) {
    .invoice-grid { grid-template-columns: 1fr; }
    .invoice-kpis { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .invoice-page { padding: 1.25rem 1rem 3rem; }
    .invoice-kpis { grid-template-columns: 1fr; }
  }

  .invoice-panel {
    background: var(--inv-surface);
    border: 1px solid var(--inv-border);
    border-radius: var(--inv-radius);
    padding: 1.35rem;
    box-shadow: var(--inv-shadow-sm);
  }

  .invoice-panel-title {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--inv-text);
    margin: 0 0 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .5rem;
  }

  .invoice-panel-subtitle {
    font-family: 'Sora', sans-serif;
    font-size: .8rem;
    font-weight: 400;
    color: var(--inv-muted);
  }

  .invoice-field label {
    color: var(--inv-muted);
    font-size: .85rem;
    font-weight: 500;
  }

  .invoice-field .form-control {
    background: var(--inv-surface2);
    color: var(--inv-text);
    border: 1px solid var(--inv-border);
    border-radius: var(--inv-radius-sm);
    box-shadow: none;
    min-height: 42px;
  }

  .invoice-field .form-control::placeholder {
    color: #8aa394;
  }

  .invoice-field .form-control:focus {
    border-color: var(--inv-accent);
    box-shadow: 0 0 0 .15rem rgba(61,214,140,.12);
    background: var(--inv-surface2);
    color: var(--inv-text);
  }

  .invoice-summary {
    border: 1px solid var(--inv-border);
    background: linear-gradient(180deg, #ffffff 0%, #f8fdf9 100%);
    border-radius: var(--inv-radius-sm);
    padding: .95rem 1rem;
    margin-bottom: 1rem;
  }

  .invoice-summary-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--inv-muted);
    font-size: .9rem;
    margin-bottom: .45rem;
  }

  .invoice-summary-row:last-child { margin-bottom: 0; }
  .invoice-summary-row strong {
    color: var(--inv-text);
    font-family: 'DM Mono', monospace;
    font-size: .9rem;
  }

  .invoice-table-wrap {
    overflow-x: auto;
  }

  table.invoice-table {
    width: 100%;
    border-collapse: collapse;
  }

  .invoice-table th {
    font-size: .75rem;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: var(--inv-muted);
    font-weight: 500;
    padding: .6rem .85rem;
    border-bottom: 1px solid var(--inv-border);
    white-space: nowrap;
  }

  .invoice-table td {
    padding: .9rem .85rem;
    border-bottom: 1px solid var(--inv-border);
    font-size: .9rem;
    color: var(--inv-text);
    vertical-align: middle;
  }

  .invoice-table tbody tr:last-child td { border-bottom: none; }
  .invoice-table tbody tr:hover td { background: var(--inv-surface2); }
  .invoice-table .amount { text-align: right; font-family: 'DM Mono', monospace; font-size: .88rem; }
  .invoice-table .mono { font-family: 'DM Mono', monospace; font-size: .85rem; }

  .invoice-badge {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: .22rem .65rem;
    border-radius: 100px;
    font-size: .75rem;
    font-weight: 500;
  }

  .invoice-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .invoice-badge-paid { background: rgba(61,214,140,.12); color: #6debb0; }
  .invoice-badge-paid::before { background: var(--inv-accent); }
  .invoice-badge-pending { background: rgba(245,158,11,.12); color: #fbd068; }
  .invoice-badge-pending::before { background: var(--inv-amber); }
  .invoice-badge-overdue { background: rgba(240,82,82,.12); color: #f8908a; }
  .invoice-badge-overdue::before { background: var(--inv-red); }

  .invoice-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    justify-content: flex-end;
  }

  .invoice-action-btn {
    border-radius: 999px;
    border: 1px solid var(--inv-border2);
    background: var(--inv-surface);
    color: var(--inv-text);
    padding: .32rem .72rem;
    font-size: .78rem;
    font-weight: 500;
    text-decoration: none;
    transition: all .15s ease;
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    box-shadow: var(--inv-shadow-sm);
  }

  .invoice-action-btn:hover {
    border-color: var(--inv-accent);
    color: var(--inv-accent);
    transform: translateY(-1px);
  }

  .invoice-action-btn-primary {
    background: var(--inv-accent);
    border-color: var(--inv-accent);
    color: #fff;
  }

  .invoice-action-btn-primary:hover {
    background: var(--inv-accent2);
    border-color: var(--inv-accent2);
    color: #fff;
  }

  .invoice-action-btn-success {
    border-color: rgba(22,163,74,.25);
    color: #15803d;
  }

  .invoice-action-btn-warning {
    border-color: rgba(217,119,6,.25);
    color: #b45309;
  }

  .invoice-action-btn-dark {
    border-color: rgba(15,23,42,.22);
    color: #334155;
  }

  .invoice-action-btn-info {
    border-color: rgba(37,99,235,.25);
    color: #1d4ed8;
  }

  .invoice-empty {
    text-align: center;
    color: var(--inv-muted);
    padding: 2rem 1rem !important;
  }

  .invoice-empty i {
    display: block;
    font-size: 1.4rem;
    margin-bottom: .55rem;
    color: var(--inv-accent);
  }

  .item-remove {
    color: var(--inv-red) !important;
  }

  .item-remove:hover {
    color: #ff7d7d !important;
  }

  .table-light {
    --bs-table-bg: transparent;
    --bs-table-border-color: var(--inv-border);
    color: var(--inv-muted);
  }

  .invoice-grid > .invoice-panel,
  .invoice-kpi,
  .invoice-action-btn,
  .invoice-btn {
    backdrop-filter: blur(4px);
  }
  </style>

  <div class="invoice-page">
    <div class="invoice-header">
      <div class="invoice-header-left">
        <div class="invoice-header-icon"><i class="fa-solid fa-file-invoice-dollar"></i></div>
        <div>
          <h1 class="invoice-title">Invoices</h1>
          <p class="invoice-subtitle">Create invoices and track payment status in one workspace</p>
        </div>
      </div>
      <div class="invoice-header-actions">
        <a href="/finance/dashboard" class="invoice-btn"><i class="fa-solid fa-chart-line"></i> Finance Dashboard</a>
        <a href="/reports" class="invoice-btn invoice-btn-primary"><i class="fa-solid fa-download"></i> Reports</a>
      </div>
    </div>

    <div class="invoice-kpis">
      <div class="invoice-kpi kpi-count">
        <div class="invoice-kpi-icon"><i class="fa-solid fa-file-invoice"></i></div>
        <div class="invoice-kpi-label">Invoices</div>
        <div class="invoice-kpi-value" id="invoiceTotalCount">0</div>
        <div class="invoice-kpi-sub">All records</div>
      </div>
      <div class="invoice-kpi kpi-paid">
        <div class="invoice-kpi-icon"><i class="fa-solid fa-file-circle-check"></i></div>
        <div class="invoice-kpi-label">Paid</div>
        <div class="invoice-kpi-value" id="invoicePaidCount">0</div>
        <div class="invoice-kpi-sub">Settled invoices</div>
      </div>
      <div class="invoice-kpi kpi-pending">
        <div class="invoice-kpi-icon"><i class="fa-solid fa-hourglass-half"></i></div>
        <div class="invoice-kpi-label">Pending</div>
        <div class="invoice-kpi-value" id="invoicePendingCount">0</div>
        <div class="invoice-kpi-sub">Awaiting payment</div>
      </div>
      <div class="invoice-kpi kpi-overdue">
        <div class="invoice-kpi-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="invoice-kpi-label">Overdue</div>
        <div class="invoice-kpi-value" id="invoiceOverdueCount">0</div>
        <div class="invoice-kpi-sub">Needs attention</div>
      </div>
    </div>

    <div class="invoice-grid">
      <div class="invoice-panel">
        <div class="invoice-panel-title">
          Create Invoice
          <span class="invoice-panel-subtitle">Build line items and preview totals live</span>
        </div>
        <form id="create">
          <div class="mb-3 invoice-field">
            <label for="customer" class="form-label">Customer name</label>
            <input id="customer" class="form-control" placeholder="Customer name" required>
          </div>
          <div class="mb-3 invoice-field">
            <label for="currency" class="form-label">Currency</label>
            <select id="currency" class="form-control">
              <option value="SGD" selected>SGD — Singapore Dollar</option>
              <option value="USD">USD — US Dollar</option>
              <option value="MYR">MYR — Malaysian Ringgit</option>
              <option value="EUR">EUR — Euro</option>
              <option value="GBP">GBP — British Pound</option>
              <option value="AUD">AUD — Australian Dollar</option>
            </select>
            <small class="text-muted">Card, PayPal, and NETS payment methods currently assume SGD regardless of this setting.</small>
          </div>
          <div class="mb-3 invoice-field">
            <label class="form-label">Line items</label>
            <div class="invoice-table-wrap">
              <table class="invoice-table" id="itemTable">
                <thead>
                  <tr>
                    <th>Description</th>
                    <th style="width: 80px;">Qty</th>
                    <th style="width: 120px;">Unit</th>
                    <th style="width: 90px;">Disc %</th>
                    <th style="width: 90px;">Tax %</th>
                    <th class="text-end" style="width: 120px;">Line total</th>
                    <th style="width: 40px;"></th>
                  </tr>
                </thead>
                <tbody id="itemBody"></tbody>
              </table>
            </div>
            <button type="button" id="addItem" class="invoice-btn mt-3"><i class="fa-solid fa-plus"></i> Add line item</button>
          </div>
          <div class="mb-3 invoice-field">
            <label for="due" class="form-label">Due date</label>
            <input type="date" id="due" class="form-control">
            <small class="text-muted" id="dueDateHint">A due date in the past will mark the invoice Overdue immediately.</small>
          </div>
          <div class="invoice-summary">
            <div class="invoice-summary-row"><span>Subtotal</span><strong id="subtotal">0.00</strong></div>
            <div class="invoice-summary-row"><span>Discount</span><strong id="discount">0.00</strong></div>
            <div class="invoice-summary-row"><span>Tax</span><strong id="tax">0.00</strong></div>
            <div class="invoice-summary-row"><span>Total</span><strong id="total">0.00</strong></div>
          </div>
          <div class="d-grid gap-2">
            <button class="invoice-btn invoice-btn-primary" type="submit"><i class="fa-solid fa-circle-plus"></i> Create Invoice</button>
          </div>
        </form>

        <hr class="my-4">

        <div class="invoice-panel-title" style="font-size: .95rem;">
          Bulk Upload
          <span class="invoice-panel-subtitle">Import multiple invoices from an Excel/CSV file</span>
        </div>
        <p class="text-muted small mb-3">
          <strong>Format:</strong> Column B: customer_name | Column C: email (optional) | Column D: amount | Column E: currency (optional) | Column F: due_date (optional)
        </p>
        <form id="bulkUpload" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
          <input type="file" id="bulkFile" accept=".xlsx,.xls,.csv" required class="form-control form-control-sm">
          <button type="submit" class="invoice-btn invoice-btn-primary"><i class="fa-solid fa-upload"></i> Upload</button>
        </form>
      </div>

      <div class="invoice-panel">
        <div class="invoice-panel-title">
          Invoice Register
          <span class="invoice-panel-subtitle">Download, send, or collect payment from each record</span>
        </div>
        <div class="invoice-table-wrap">
          <table class="invoice-table">
            <thead>
              <tr>
                <th>Number</th>
                <th>Customer</th>
                <th class="text-end">Amount</th>
                <th>Due</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="list"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
  function toNum(value){
    const num = Number(value);
    return Number.isFinite(num) ? num : 0;
  }

  function money(value){
    return toNum(value).toFixed(2);
  }

  // SECURITY: shared escaping helper used whenever database-sourced text
  // (customer_name, invoice number, line item description, etc.) is
  // interpolated into innerHTML. Declared once at top-level scope so it's
  // available to every function below (addItemRow, load, etc.) regardless
  // of call order — do not redeclare this inside individual functions.
  function escapeHtml(str){
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function statusClass(status, dueDate){
    if (status === 'Paid') return 'invoice-badge-paid';
    if (status === 'Failed') return 'invoice-badge-overdue';
    if (status === 'Pending') {
      const due = dueDate ? new Date(dueDate) : null;
      const overdue = due && !Number.isNaN(due.getTime()) && due.getTime() < new Date().setHours(0, 0, 0, 0);
      return overdue ? 'invoice-badge-overdue' : 'invoice-badge-pending';
    }
    return 'invoice-badge-pending';
  }

  function statusLabel(status, dueDate){
    if (status === 'Paid') return 'Paid';
    if (status === 'Failed') return 'Failed';
    if (status === 'Pending') {
      const due = dueDate ? new Date(dueDate) : null;
      const overdue = due && !Number.isNaN(due.getTime()) && due.getTime() < new Date().setHours(0, 0, 0, 0);
      return overdue ? 'Overdue' : 'Pending';
    }
    return status || 'Pending';
  }

  function isOverdueInvoice(invoice){
    if (!invoice || invoice.status === 'Paid') return false;
    const due = invoice.due_date ? new Date(invoice.due_date) : null;
    return !!(due && !Number.isNaN(due.getTime()) && due.getTime() < new Date().setHours(0, 0, 0, 0));
  }

  function updateInvoiceSummary(items){
    const paid = items.filter((item) => item.status === 'Paid');
    const pending = items.filter((item) => item.status === 'Pending');
    const overdue = items.filter((item) => isOverdueInvoice(item));
    document.getElementById('invoiceTotalCount').textContent = items.length;
    document.getElementById('invoicePaidCount').textContent = paid.length;
    document.getElementById('invoicePendingCount').textContent = pending.length;
    document.getElementById('invoiceOverdueCount').textContent = overdue.length;
  }

  function addItemRow(item){
    const row = document.createElement('tr');
    row.innerHTML = `
      <td><input class="form-control form-control-sm item-description" placeholder="Service or product" value="${escapeHtml(item && item.description ? item.description : '')}" required></td>
      <td><input class="form-control form-control-sm item-qty" type="number" min="0.01" step="0.01" value="${item && item.qty ? item.qty : 1}" required></td>
      <td><input class="form-control form-control-sm item-unit" type="number" min="0" step="0.01" value="${item && item.unit_price ? item.unit_price : 0}" required></td>
      <td><input class="form-control form-control-sm item-discount" type="number" min="0" max="100" step="0.01" value="${item && item.discount_rate ? item.discount_rate : 0}"></td>
      <td><input class="form-control form-control-sm item-tax" type="number" min="0" max="100" step="0.01" value="${item && item.tax_rate ? item.tax_rate : 0}"></td>
      <td class="text-end item-line-total">0.00</td>
      <td><button type="button" class="btn btn-sm btn-link text-danger item-remove">x</button></td>
    `;
    document.getElementById('itemBody').appendChild(row);
    row.querySelectorAll('input').forEach((input) => input.addEventListener('input', computeTotals));
    row.querySelector('.item-remove').addEventListener('click', () => {
      row.remove();
      if (!document.querySelectorAll('#itemBody tr').length) addItemRow();
      computeTotals();
    });
    computeTotals();
  }

  function collectItems(){
    return Array.from(document.querySelectorAll('#itemBody tr')).map((row) => {
      const description = row.querySelector('.item-description').value.trim();
      const qty = toNum(row.querySelector('.item-qty').value);
      const unit_price = toNum(row.querySelector('.item-unit').value);
      const discount_rate = toNum(row.querySelector('.item-discount').value);
      const tax_rate = toNum(row.querySelector('.item-tax').value);
      const lineSubtotal = qty * unit_price;
      const lineDiscount = lineSubtotal * (discount_rate / 100);
      const taxable = lineSubtotal - lineDiscount;
      const lineTax = taxable * (tax_rate / 100);
      const lineTotal = taxable + lineTax;
      row.querySelector('.item-line-total').textContent = money(lineTotal);
      return { description, qty, unit_price, discount_rate, tax_rate, line_subtotal: lineSubtotal, line_discount: lineDiscount, line_tax: lineTax, line_total: lineTotal };
    }).filter((item) => item.description || item.qty || item.unit_price);
  }

  function computeTotals(){
    const items = collectItems();
    const subtotal = items.reduce((sum, item) => sum + item.line_subtotal, 0);
    const discount = items.reduce((sum, item) => sum + item.line_discount, 0);
    const tax = items.reduce((sum, item) => sum + item.line_tax, 0);
    const total = subtotal - discount + tax;
    document.getElementById('subtotal').textContent = money(subtotal);
    document.getElementById('discount').textContent = money(discount);
    document.getElementById('tax').textContent = money(tax);
    document.getElementById('total').textContent = money(total);
    return { items, subtotal, discount, tax, total };
  }

  document.getElementById('addItem').addEventListener('click', () => addItemRow());
  addItemRow();

  let paypalSdkPromise;

  async function loadPayPalSdk(){
    if (window.paypal) return window.paypal;
    if (!paypalSdkPromise) {
      paypalSdkPromise = fetch('/payment/paypal/config')
        .then(async res => {
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Unable to load PayPal configuration');
          return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(data.clientId)}&currency=${encodeURIComponent(data.currency)}`;
            script.onload = () => resolve(window.paypal);
            script.onerror = () => reject(new Error('Unable to load PayPal SDK'));
            document.head.appendChild(script);
          });
        });
    }
    return paypalSdkPromise;
  }

  async function load(){
    const res = await fetch('/api/invoices',{headers:{authorization:'Bearer '+token}});
    if (!res.ok) return;
    const items = await res.json();
    updateInvoiceSummary(items || []);
    const tbody = document.getElementById('list'); tbody.innerHTML='';
    if (!items || !items.length) tbody.innerHTML = '<tr><td colspan="6" class="invoice-empty"><i class="fa-solid fa-receipt"></i>No invoices yet</td></tr>';
    items.forEach(i=>{
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="mono">${escapeHtml(i.number || '')}</td>
        <td>${escapeHtml(i.customer_name || '')}</td>
        <td class="text-end">${i.currency || (i.data && i.data.currency) || 'SGD'} ${parseFloat(i.amount||0).toFixed(2)}</td>
        <td>${i.due_date ? new Date(i.due_date).toLocaleDateString() : ''}</td>
        <td><span class="invoice-badge ${statusClass(i.status, i.due_date)}">${statusLabel(i.status, i.due_date)}</span></td>
        <td class="text-end">
          <div class="invoice-actions">
            <a class="invoice-action-btn" href="/api/invoices/${i.id}/pdf" target="_blank"><i class="fa-solid fa-file-pdf"></i> PDF</a>
            <a class="invoice-action-btn" href="/api/invoices/${i.id}/excel" target="_blank"><i class="fa-solid fa-file-excel"></i> Excel</a>
            ${i.status !== 'Paid' ? `<button class="invoice-action-btn invoice-action-btn-success" onclick="payByCard(${i.id})"><i class="fa-solid fa-credit-card"></i> Card</button>` : ''}
            ${i.status !== 'Paid' ? `<button class="invoice-action-btn invoice-action-btn-warning" onclick="payByPayPal(${i.id})"><i class="fa-brands fa-paypal"></i> PayPal</button>` : ''}
            ${i.status !== 'Paid' ? `<button class="invoice-action-btn invoice-action-btn-dark" onclick="showNETS(${i.id})"><i class="fa-solid fa-qrcode"></i> NETS</button>` : ''}
            ${i.status !== 'Paid' ? `<button class="invoice-action-btn invoice-action-btn-info" onclick="showBankTransfer(${i.id})"><i class="fa-solid fa-building-columns"></i> Bank</button>` : ''}
            <button class="invoice-action-btn invoice-action-btn-primary" onclick="sendInvoice(${i.id}, '${escapeHtml((i.data && i.data.email) || '').replace(/'/g, "\\'")}')"><i class="fa-solid fa-paper-plane"></i> Send</button>
          </div>
          <div id="paypal-buttons-${i.id}" class="mt-2"></div>
          <div id="nets-qr-${i.id}" class="mt-2"></div>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

  document.getElementById('create').addEventListener('submit', async e=>{
    e.preventDefault();
    const totals = computeTotals();
    if (!totals.items.length) {
      alert('Add at least one line item');
      return;
    }
    const dueValue = document.getElementById('due').value;
    if (dueValue) {
      const dueDate = new Date(dueValue);
      const today = new Date(); today.setHours(0, 0, 0, 0);
      if (dueDate < today) {
        const proceed = confirm('This due date is in the past — the invoice will show as Overdue immediately. Continue anyway?');
        if (!proceed) return;
      }
    }
    const payload = {
      customer_name: document.getElementById('customer').value,
      amount: totals.total,
      due_date: document.getElementById('due').value,
      currency: document.getElementById('currency').value,
      items: totals.items.map((item) => ({
        description: item.description,
        qty: item.qty,
        unit_price: item.unit_price,
        discount_rate: item.discount_rate,
        tax_rate: item.tax_rate
      })),
      data: {
        summary: {
          subtotal: Number(totals.subtotal.toFixed(2)),
          discount_total: Number(totals.discount.toFixed(2)),
          tax_total: Number(totals.tax.toFixed(2)),
          total: Number(totals.total.toFixed(2))
        }
      }
    };
    const res = await fetch('/api/invoices',{method:'POST',headers:{authorization:'Bearer '+token,'content-type':'application/json'},body:JSON.stringify(payload)});
    if (res.ok){
      document.getElementById('create').reset();
      document.getElementById('itemBody').innerHTML = '';
      addItemRow();
      load();
    } else {
      const err = await res.json(); alert(err.error || 'Failed to create invoice');
    }
  });
  load();

  document.getElementById('bulkUpload').addEventListener('submit', async e => {
    e.preventDefault();
    const file = document.getElementById('bulkFile').files[0];
    if (!file) {
      alert('Please select a file');
      return;
    }
    const fd = new FormData();
    fd.append('file', file);
    try {
      const res = await fetch('/api/invoices/bulk-upload', { method: 'POST', headers: { authorization: 'Bearer ' + token }, body: fd });
      const data = await res.json();

      if (!res.ok) {
        alert(`Error: ${data.error}\n${data.details ? data.details.join('\n') : ''}`);
        return;
      }

      let msg = `✓ Imported ${data.imported || 0} invoice(s)`;
      if (data.failed) msg += `, ${data.failed} failed`;
      if (data.warnings) msg += `\n⚠ ${data.warnings}`;
      if (data.errorDetails && data.errorDetails.length) msg += `\n${data.errorDetails.join('\n')}`;
      alert(msg);
      document.getElementById('bulkFile').value = '';
      load();
    } catch (err) {
      alert('Upload failed: ' + err.message);
    }
  });

  async function sendInvoice(id, defaultEmail){
    const email = prompt('Recipient email', defaultEmail || '');
    if (!email) return;
    const res = await fetch(`/api/invoices/${id}/send`, { method: 'POST', headers: { authorization:'Bearer '+token, 'content-type':'application/json' }, body: JSON.stringify({ email }) });
    if (res.ok) { alert('Invoice sent'); load(); } else { const err = await res.json(); alert(err.error || 'Failed to send'); }
  }

  async function payByCard(id){
    const res = await fetch(`/payment/checkout/${id}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.url) location = data.url;
    else alert(data.error || 'Unable to start card payment');
  }

  async function payByPayPal(id){
    const container = document.getElementById(`paypal-buttons-${id}`);
    container.innerHTML = '';

    try {
      const paypal = await loadPayPalSdk();
      paypal.Buttons({
        createOrder: async () => {
          const res = await fetch(`/payment/paypal/orders/${id}`, { method: 'POST' });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Unable to create PayPal order');
          return data.id;
        },
        onApprove: async data => {
          const res = await fetch(`/payment/paypal/orders/${data.orderID}/capture`, { method: 'POST' });
          const result = await res.json();
          if (!res.ok) throw new Error(result.error || 'Unable to capture PayPal payment');
          alert('PayPal payment successful');
          load();
        },
        onError: err => {
          alert(err.message || 'PayPal payment failed');
        }
      }).render(container);
    } catch (err) {
      alert(err.message || 'Unable to start PayPal payment');
    }
  }

  async function showNETS(id){
    const box = document.getElementById(`nets-qr-${id}`);
    box.innerHTML = '';
    try {
      const res = await fetch(`/payment/nets/${id}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Unable to generate NETS QR');
      box.innerHTML = `
        <div class="nets-box text-start">
          <h6>NETS QR</h6>
          <img src="${data.qrDataUrl}" alt="NETS QR for ${data.invoice}" width="180" height="180">
          <p class="mb-1"><strong>Amount:</strong> ${data.currency} ${Number(data.amount).toFixed(2)}</p>
          <p class="mb-1"><strong>Reference:</strong> ${data.reference}</p>
          <p class="mb-0 text-muted">Finance must verify receipt before marking this invoice paid.</p>
        </div>
      `;
    } catch (err) {
      alert(err.message || 'Unable to generate NETS QR');
    }
  }

  async function showBankTransfer(id){
    const res = await fetch(`/payment/bank-transfer/${id}`);
    const data = await res.json();
    if (!res.ok) return alert(data.error || 'Unable to load bank transfer instructions');
    alert(
      `Bank Transfer Instructions\n\n` +
      `Invoice: ${data.invoice}\n` +
      `Bank: ${data.bankName}\n` +
      `Account name: ${data.accountName}\n` +
      `Account number: ${data.accountNumber}\n` +
      `Amount: ${data.currency} ${Number(data.amount).toFixed(2)}\n` +
      `Reference: ${data.reference}`
    );
  }
  </script>

 

