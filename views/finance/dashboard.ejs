<%- include('../partials/header', { title: 'Finance Dashboard' }) %>
<%- include('../partials/navbar') %>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
try{
  const payload = JSON.parse(atob(token.split('.')[1]));
  if (payload.role !== 'Finance' && payload.role !== 'Admin') location = '/dashboard';
}catch(e){ location = '/login'; }
</script>

<div class="container mt-4 finance-dashboard">
  <div id="paymentSuccessAlert" class="alert d-none" role="alert">
    Stripe payment completed successfully.
  </div>

  <div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
      <h2>Finance Dashboard</h2>
      <p class="text-muted mb-0">Payment performance, invoice status, and finance alerts.</p>
    </div>
    <a href="/finance/payments" class="btn btn-sm btn-outline-primary">Payments</a>
  </div>

  <section class="report-kpis finance-row">
    <div class="report-kpi finance-kpi">
      <span>Revenue</span>
      <strong id="financeTotalRevenue">SGD 0.00</strong>
    </div>
    <div class="report-kpi finance-kpi">
      <span>Paid Inv.</span>
      <strong id="financePaidInvoices">0</strong>
    </div>
    <div class="report-kpi finance-kpi">
      <span>Pending Pay</span>
      <strong id="financePendingPayments">0</strong>
    </div>
    <div class="report-kpi finance-kpi">
      <span>Overdue Inv.</span>
      <strong id="financeOverdueInvoices">0</strong>
    </div>
  </section>

  <section class="row g-3 finance-row">
    <div class="col-lg-5">
      <div class="report-panel h-100">
        <h5>Payment Analytics</h5>
        <div class="payment-breakdown">
          <div>
            <span>Stripe Revenue</span>
            <strong id="stripeRevenue">SGD 0.00</strong>
          </div>
          <div>
            <span>PayPal Revenue</span>
            <strong id="paypalRevenue">SGD 0.00</strong>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="report-panel h-100">
        <h5>Gateway Share</h5>
        <div class="chart-box">
          <canvas id="paymentPieChart"></canvas>
        </div>
      </div>
    </div>
  </section>

  <section class="report-panel finance-row">
    <div class="d-flex align-items-center justify-content-between gap-2 mb-2">
      <h5 class="mb-0">Recent Payments</h5>
      <a href="/finance/payments" class="btn btn-sm btn-outline-secondary">View all</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Invoice</th>
            <th>Method</th>
            <th class="text-end">Amount</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody id="recentPaymentsBody">
          <tr><td colspan="4" class="text-center text-muted">Loading payments...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="report-panel finance-row">
    <h5>Alerts</h5>
    <div id="financeAlerts" class="finance-alerts">
      <div class="text-muted">Loading alerts...</div>
    </div>
  </section>

  <section class="report-panel finance-row">
    <h5>Monthly Revenue</h5>
    <div class="chart-box chart-box-tall">
      <canvas id="monthlyRevenueChart"></canvas>
    </div>
  </section>

  <section class="report-panel finance-row">
    <h5 class="mb-3">Quick Actions</h5>
    <div class="dashboard-cards">
      <div class="col">
        <a href="/invoices" class="card-link">
          <div class="card h-100 text-center shadow-sm">
            <div class="card-body">
              <div class="card-icon mb-3" aria-hidden="true"><i class="fa-solid fa-file-invoice"></i></div>
              <div>
                <h5 class="card-title">Invoices</h5>
                <p class="card-text">Create, view and manage invoices.</p>
              </div>
            </div>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="/reports" class="card-link">
          <div class="card h-100 text-center shadow-sm">
            <div class="card-body">
              <div class="card-icon mb-3" aria-hidden="true"><i class="fa-solid fa-chart-column"></i></div>
              <div>
                <h5 class="card-title">Reports</h5>
                <p class="card-text">Financial summaries and exports.</p>
              </div>
            </div>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="/finance/payments" class="card-link">
          <div class="card h-100 text-center shadow-sm">
            <div class="card-body">
              <div class="card-icon mb-3" aria-hidden="true"><i class="fa-solid fa-credit-card"></i></div>
              <div>
                <h5 class="card-title">Payments</h5>
                <p class="card-text">Record and reconcile payments.</p>
              </div>
            </div>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="/finance/bank-reconcile" class="card-link">
          <div class="card h-100 text-center shadow-sm">
            <div class="card-body">
              <div class="card-icon mb-3" aria-hidden="true"><i class="fa-solid fa-building-columns"></i></div>
              <div>
                <h5 class="card-title">Bank Reconciliation</h5>
                <p class="card-text">Import statements and reconcile accounts.</p>
              </div>
            </div>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="/payroll" class="card-link">
          <div class="card h-100 text-center shadow-sm">
            <div class="card-body">
              <div class="card-icon mb-3" aria-hidden="true"><i class="fa-solid fa-briefcase"></i></div>
              <div>
                <h5 class="card-title">Payroll</h5>
                <p class="card-text">Manage payroll runs and settings.</p>
              </div>
            </div>
          </div>
        </a>
      </div>
      <div class="col">
        <a href="/finance/requests" class="card-link">
          <div class="card h-100 text-center shadow-sm">
            <div class="card-body">
              <div class="card-icon mb-3" aria-hidden="true"><i class="fa-solid fa-envelope"></i></div>
              <div>
                <h5 class="card-title">Requests</h5>
                <p class="card-text">Submit HR or finance requests.</p>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>
</div>

<script>
let paymentPieChart;
let monthlyRevenueChart;

const dashboardParams = new URLSearchParams(window.location.search);
if (dashboardParams.get('payment') === 'stripe') {
  const alert = document.getElementById('paymentSuccessAlert');
  const status = dashboardParams.get('status');
  const isPaid = !status || status === 'paid' || status === 'complete';
  alert.classList.remove('d-none');
  alert.classList.add(isPaid ? 'alert-success' : 'alert-warning');
  alert.textContent = isPaid
    ? 'Stripe payment completed successfully and the invoice was marked Paid.'
    : 'Stripe returned to the dashboard, but the payment could not be confirmed automatically. Check the invoice and payment history.';
}

function financeMoney(value, currency){
  return `${currency || 'SGD'} ${Number(value || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
}

function statusClass(status){
  if (status === 'Paid') return 'success';
  if (status === 'Failed') return 'danger';
  if (status === 'Pending') return 'warning text-dark';
  return 'secondary';
}

function renderPaymentPie(stripeRevenue, paypalRevenue){
  const canvas = document.getElementById('paymentPieChart');
  const values = [stripeRevenue, paypalRevenue];
  if (paymentPieChart) paymentPieChart.destroy();
  paymentPieChart = new Chart(canvas, {
    type: 'pie',
    data: {
      labels: ['Stripe', 'PayPal'],
      datasets: [{
        data: values,
        backgroundColor: ['#635bff', '#0070ba'],
        borderColor: '#fff',
        borderWidth: 2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { position: 'bottom' },
        tooltip: {
          callbacks: {
            label: context => {
              const total = values.reduce((sum, value) => sum + value, 0);
              const percent = total ? Math.round((context.raw / total) * 100) : 0;
              return `${context.label}: ${percent}% (${financeMoney(context.raw)})`;
            }
          }
        }
      }
    }
  });
}

function renderMonthlyRevenue(monthlyRevenue){
  const labels = Object.keys(monthlyRevenue || {});
  const values = Object.values(monthlyRevenue || {}).map(Number);
  const canvas = document.getElementById('monthlyRevenueChart');
  if (monthlyRevenueChart) monthlyRevenueChart.destroy();
  monthlyRevenueChart = new Chart(canvas, {
    type: 'bar',
    data: {
      labels: labels.map(label => {
        const parts = String(label).split('-');
        if (parts.length !== 2) return label;
        const date = new Date(Number(parts[0]), Number(parts[1]) - 1, 1);
        return date.toLocaleString(undefined, { month: 'short' });
      }),
      datasets: [{
        label: 'Revenue',
        data: values,
        backgroundColor: '#0b63a4',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          ticks: { callback: value => financeMoney(value) }
        }
      },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: { label: context => financeMoney(context.raw) }
        }
      }
    }
  });
}

function renderRecentPayments(payments){
  const tbody = document.getElementById('recentPaymentsBody');
  if (!payments || !payments.length) {
    tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No payments recorded yet</td></tr>';
    return;
  }

  tbody.innerHTML = payments.map(payment => `
    <tr>
      <td>${payment.invoiceNumber || ''}</td>
      <td>${payment.method || ''}</td>
      <td class="text-end">${financeMoney(payment.amount, payment.currency)}</td>
      <td><span class="badge bg-${statusClass(payment.status)}">${payment.status || ''}</span></td>
    </tr>
  `).join('');
}

function renderAlerts(totals){
  const alerts = [];
  if ((totals.overdueInvoiceCount || 0) > 0) {
    alerts.push(`${totals.overdueInvoiceCount} overdue invoice${totals.overdueInvoiceCount === 1 ? '' : 's'}`);
  }
  if ((totals.failedPayPalCount || 0) > 0) {
    alerts.push(`${totals.failedPayPalCount} failed PayPal transaction${totals.failedPayPalCount === 1 ? '' : 's'}`);
  }
  if ((totals.payrollDueSoonCount || 0) > 0) {
    alerts.push(`${totals.payrollDueSoonCount} payroll run${totals.payrollDueSoonCount === 1 ? '' : 's'} due in 2 days`);
  }

  const container = document.getElementById('financeAlerts');
  if (!alerts.length) {
    container.innerHTML = '<div class="text-muted">No active finance alerts.</div>';
    return;
  }

  container.innerHTML = alerts.map(alert => `
    <div class="finance-alert">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      <span>${alert}</span>
    </div>
  `).join('');
}

async function loadFinanceDashboard(){
  const summaryRes = await fetch('/api/reports/summary', { headers: { authorization: 'Bearer ' + token } });
  if (!summaryRes.ok) return;
  const summary = await summaryRes.json();
  const totals = summary.totals || {};
  const paymentRevenue = (summary.charts && summary.charts.paymentMethodRevenue) || {};
  const stripeRevenue = Number(paymentRevenue.Stripe || 0);
  const paypalRevenue = Number(paymentRevenue.PayPal || 0);

  document.getElementById('financeTotalRevenue').textContent = financeMoney(totals.paidRevenue);
  document.getElementById('financePaidInvoices').textContent = totals.paidInvoiceCount || 0;
  document.getElementById('financePendingPayments').textContent = totals.pendingPaymentCount || 0;
  document.getElementById('financeOverdueInvoices').textContent = totals.overdueInvoiceCount || 0;
  document.getElementById('stripeRevenue').textContent = financeMoney(stripeRevenue);
  document.getElementById('paypalRevenue').textContent = financeMoney(paypalRevenue);

  renderPaymentPie(stripeRevenue, paypalRevenue);
  renderRecentPayments(summary.recentTransactions || []);
  renderAlerts(totals);
  renderMonthlyRevenue((summary.charts && summary.charts.monthlyRevenue) || {});
}

loadFinanceDashboard();
</script>

<%- include('../partials/footer') %>
