<%- include('../partials/header', { title: 'Automation Settings' }) %>
<%- include('../partials/navbar') %>
<% if (automationBasePath === '/admin/automation') { %>
  <%- include('./_admin_nav') %>
<% } else { %>
  <nav class="admin-nav" aria-label="HR navigation">
    <a href="/hr/dashboard">HR Dashboard</a>
    <a href="/hr/employees">Employees</a>
    <a href="/hr/requests">Requests</a>
  </nav>
<% } %>

<div class="container py-4 payroll-automation-page">
  <div class="automation-hero">
    <div>
      <span class="automation-eyebrow"><i class="fa-solid fa-bell"></i> Payroll automation</span>
      <h2>Payroll Reminder Settings</h2>
      <p>Configure important payroll dates and notify the right teams at the right time.</p>
    </div>
    <a class="automation-btn automation-btn-secondary" href="<%= automationBasePath %>/history">
      <i class="fa-solid fa-clock-rotate-left"></i> View Delivery History
    </a>
  </div>

  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>

  <form method="post" action="<%= automationBasePath %>/settings" class="automation-card automation-settings-card">
    <div class="automation-card-heading">
      <span class="automation-icon"><i class="fa-solid fa-calendar-days"></i></span>
      <div><h3>Reminder schedule</h3><p>Choose when each payroll milestone is due.</p></div>
    </div>
    <div class="automation-form-grid">
    <div class="automation-field automation-field-wide">
      <label class="form-label">Reminder lead window (days)</label>
      <input class="form-control" type="number" min="0" name="payrollUploadReminderOffsetDays" value="<%= settings.payrollUploadReminderOffsetDays %>">
      <small>Reminders are included when a deadline falls within this window.</small>
    </div>

    <div class="automation-field">
      <label class="form-label">Payroll upload deadline</label>
      <input class="form-control" type="date" name="payrollUploadDeadline" value="<%= settings.payrollUploadDeadline %>">
      <small>Sent to active HR accounts.</small>
    </div>

    <div class="automation-field">
      <label class="form-label">Finance approval deadline</label>
      <input class="form-control" type="date" name="financeApprovalDeadline" value="<%= settings.financeApprovalDeadline %>">
      <small>Sent to active Finance accounts.</small>
    </div>

    <div class="automation-field automation-field-wide">
      <label class="form-label">Salary release date</label>
      <input class="form-control" type="date" name="salaryReleaseDate" value="<%= settings.salaryReleaseDate %>">
      <small>Sent to every active account.</small>
    </div>
    </div>

    <button class="automation-btn automation-btn-primary" type="submit"><i class="fa-solid fa-check"></i> Save Settings</button>
  </form>

  <form method="post" action="<%= automationBasePath %>/run" class="automation-card automation-run-card">
    <div class="automation-card-heading mb-0">
      <span class="automation-icon"><i class="fa-solid fa-paper-plane"></i></span>
      <div><h3>Run Reminder Scheduler</h3><p>Trigger the daily reminder process now. Duplicate deliveries will be skipped.</p></div>
    </div>
    <button class="automation-btn automation-btn-primary" type="submit"><i class="fa-solid fa-play"></i> Run Scheduler</button>
  </form>

  <div class="automation-card automation-preview-card">
    <div class="automation-card-heading">
      <span class="automation-icon"><i class="fa-solid fa-eye"></i></span>
      <div><h3>Reminder Preview</h3><p>Deadlines currently inside the lead window.</p></div>
    </div>
    <% if (reminderPreview.length) { %>
      <ul>
        <% reminderPreview.forEach((item) => { %>
          <li><strong><%= item.label %></strong>: <%= item.value %> (<%= item.daysUntil %> day(s) away)</li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="automation-empty"><i class="fa-regular fa-calendar-check"></i><p>No reminders are due in the current lead window.</p></div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
