<%- include('../partials/header', { title: 'Invoice ' + (invoice.number || '') }) %>
  <div class="card">
    <div class="card-body">
      <h3>Invoice <%= invoice.number %></h3>
      <p><strong>Customer:</strong> <%= invoice.customer_name %></p>
      <p><strong>Amount:</strong> <%= invoice.currency || (invoice.data && invoice.data.currency) || 'SGD' %> <%= parseFloat(invoice.amount).toFixed(2) %></p>
      <p><strong>Status:</strong> <%= invoice.status %></p>
      <p><strong>Due:</strong> <%= invoice.due_date ? new Date(invoice.due_date).toLocaleDateString() : '' %></p>
      <% if (invoice.data && invoice.data.line_items && invoice.data.line_items.length) { %>
        <div class="table-responsive mt-3">
          <table class="table table-sm table-bordered align-middle">
            <thead class="table-light">
              <tr>
                <th>Description</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Unit Price</th>
                <th class="text-end">Discount %</th>
                <th class="text-end">Tax %</th>
                <th class="text-end">Line Total</th>
              </tr>
            </thead>
            <tbody>
              <% invoice.data.line_items.forEach(function(item){ %>
                <tr>
                  <td><%= item.description %></td>
                  <td class="text-end"><%= Number(item.qty || 0).toFixed(2) %></td>
                  <td class="text-end"><%= Number(item.unit_price || 0).toFixed(2) %></td>
                  <td class="text-end"><%= Number(item.discount_rate || 0).toFixed(2) %></td>
                  <td class="text-end"><%= Number(item.tax_rate || 0).toFixed(2) %></td>
                  <td class="text-end"><%= Number(item.line_total || 0).toFixed(2) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="mt-2">
          <p class="mb-1"><strong>Subtotal:</strong> <%= invoice.currency || (invoice.data && invoice.data.currency) || 'SGD' %> <%= Number((invoice.data.summary && invoice.data.summary.subtotal) || 0).toFixed(2) %></p>
          <p class="mb-1"><strong>Discount:</strong> <%= invoice.currency || (invoice.data && invoice.data.currency) || 'SGD' %> <%= Number((invoice.data.summary && invoice.data.summary.discount_total) || 0).toFixed(2) %></p>
          <p class="mb-1"><strong>Tax:</strong> <%= invoice.currency || (invoice.data && invoice.data.currency) || 'SGD' %> <%= Number((invoice.data.summary && invoice.data.summary.tax_total) || 0).toFixed(2) %></p>
          <p class="mb-1"><strong>Total:</strong> <%= invoice.currency || (invoice.data && invoice.data.currency) || 'SGD' %> <%= Number((invoice.data.summary && invoice.data.summary.total) || invoice.amount || 0).toFixed(2) %></p>
        </div>
      <% } %>
      <% if (invoice.status !== 'Paid') { %>
        <div class="payment-actions mt-3">
          <button class="btn btn-success" type="button" onclick="payByCard(<%= invoice.id %>)">Pay by Card</button>
          <button class="btn btn-outline-primary" type="button" onclick="showBankTransfer(<%= invoice.id %>)">Bank Transfer</button>
        </div>
        <div id="bankTransfer" class="bank-transfer-box mt-3 d-none"></div>
      <% } %>
      <div class="mt-3">
        <a class="btn btn-primary" href="/api/invoices/<%= invoice.id %>/pdf" target="_blank">Download PDF</a>
        <a class="btn btn-outline-secondary" href="/api/invoices/<%= invoice.id %>/excel" target="_blank">Download CSV</a>
      </div>
    </div>
  </div>
  <script>
  async function payByCard(id){
    const res = await fetch(`/payment/checkout/${id}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.url) location = data.url;
    else alert(data.error || 'Unable to start card payment');
  }

  async function showBankTransfer(id){
    const res = await fetch(`/payment/bank-transfer/${id}`);
    const data = await res.json();
    if (!res.ok) return alert(data.error || 'Unable to load bank transfer instructions');
    const box = document.getElementById('bankTransfer');
    box.classList.remove('d-none');
    box.innerHTML = `
      <h5>Bank Transfer Instructions</h5>
      <p class="mb-1"><strong>Bank:</strong> ${data.bankName}</p>
      <p class="mb-1"><strong>Account name:</strong> ${data.accountName}</p>
      <p class="mb-1"><strong>Account number:</strong> ${data.accountNumber}</p>
      <p class="mb-1"><strong>Amount:</strong> ${data.currency} ${Number(data.amount).toFixed(2)}</p>
      <p class="mb-0"><strong>Reference:</strong> ${data.reference}</p>
    `;
  }
  </script>
<%- include('../partials/footer') %>
