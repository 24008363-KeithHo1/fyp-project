<%- include('../partials/header', { title }) %>
<%- include('../partials/navbar') %>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root { --pc-text:#102033; --pc-muted:#64748b; --pc-border:rgba(148,163,184,.18); --pc-blue:#2563eb; --pc-green:#0b8f3e; --pc-lime:#84cc16; --pc-radius:8px; --pc-shadow:0 14px 30px rgba(15,23,42,.08); }
  body:has(.partner-page) { background:linear-gradient(135deg,#f7faf8 0%,#e8f7ee 48%,#f8fbf9 100%)!important; color:var(--pc-text); font-family:'Sora',sans-serif; }
  .partner-page{max-width:1320px;margin:0 auto;padding:1.5rem;box-sizing:border-box;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(248,250,252,.94)),linear-gradient(90deg,rgba(6,182,212,.12),rgba(124,58,237,.12));animation:partner-in .4s cubic-bezier(.22,.8,.36,1) both}
  @keyframes partner-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
  .partner-hero{position:relative;overflow:hidden;padding:1.35rem;border:1px solid rgba(37,99,235,.18);border-radius:var(--pc-radius);background:linear-gradient(135deg,rgba(15,23,42,.94),rgba(37,99,235,.86) 46%,rgba(11,143,62,.82));box-shadow:0 18px 38px rgba(15,23,42,.16)}
  .partner-hero::after{position:absolute;right:-56px;bottom:-84px;width:260px;height:150px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.03));content:'';transform:rotate(-18deg)}
  .partner-hero > *{position:relative;z-index:1}.partner-eyebrow{display:inline-flex;align-items:center;min-height:24px;padding:.25rem .58rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-size:.72rem;letter-spacing:0}
  .partner-hero h1,.partner-hero p{color:#fff!important}.partner-hero p{opacity:.88}.partner-new-customer{border:0!important;border-radius:8px!important;background:#fff!important;color:#1d4ed8!important;box-shadow:0 14px 28px rgba(15,23,42,.24);font-size:.8rem;font-weight:700}.partner-new-customer:hover{background:#e0f2fe!important;color:#075985!important;transform:translateY(-2px) scale(1.02)}
  .partner-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1.15rem}.partner-stat{position:relative;display:flex;flex-direction:column;gap:.5rem;min-height:128px;padding:1.15rem 1.2rem 1.25rem;overflow:hidden;border:0;border-radius:var(--pc-radius);color:#fff;box-shadow:0 16px 30px rgba(15,23,42,.13);transition:transform .16s ease,box-shadow .16s ease,filter .16s ease}.partner-stat:hover{transform:translateY(-4px);filter:saturate(1.04);box-shadow:0 22px 38px rgba(15,23,42,.18)}.partner-stat::after{position:absolute;right:-24px;bottom:-36px;width:150px;height:84px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.04));content:'';transform:rotate(-18deg)}.partner-stat > *{position:relative;z-index:1}.partner-stat:nth-child(1){background:linear-gradient(135deg,#0f766e,#22c55e)}.partner-stat:nth-child(2){background:linear-gradient(135deg,#4f46e5,#8b5cf6)}.partner-stat:nth-child(3){background:linear-gradient(135deg,#0369a1,#06b6d4)}.partner-stat:nth-child(4){background:linear-gradient(135deg,#c2410c,#f59e0b)}.partner-stat-icon{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:8px;background:rgba(255,255,255,.16);font-size:.9rem}.partner-stat-label{font-size:.75rem;font-weight:800;letter-spacing:0;text-transform:uppercase;opacity:.82}.partner-stat strong{display:block;color:#fff;font-family:'DM Mono',monospace;font-size:1.45rem;line-height:1.15}.partner-stat small{margin-top:auto;font-size:.74rem;line-height:1.35;opacity:.82}
  .partner-panel{overflow:hidden;border:1px solid var(--pc-border);border-radius:var(--pc-radius);background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(240,249,255,.78));box-shadow:var(--pc-shadow);transition:border-color .16s ease,box-shadow .16s ease}.partner-panel:hover{border-color:rgba(6,182,212,.28);box-shadow:0 20px 36px rgba(15,23,42,.12)}.partner-filter-panel{padding:1.35rem 1.4rem;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(255,247,237,.82))}.partner-table-panel{padding:0}.partner-panel-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.2rem 1.35rem;border-bottom:1px solid rgba(148,163,184,.16)}.partner-panel-title{display:flex;align-items:center;gap:.52rem;margin:0 0 1.1rem;color:var(--pc-text);font-size:.95rem;font-weight:700}.partner-panel-head .partner-panel-title{margin:0}.partner-panel-title i{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,#0f766e,#22c55e);color:#fff;font-size:.8rem}.partner-filter-panel .form-label,.partner-editor-panel .form-label{margin-bottom:.42rem;color:#475569;font-size:.78rem;font-weight:700}.partner-filter-panel .form-control,.partner-filter-panel .form-select,.partner-editor-panel .form-control,.partner-editor-panel .form-select{border-color:rgba(148,163,184,.28);background:#fff}.partner-filter-panel .form-control:focus,.partner-filter-panel .form-select:focus,.partner-editor-panel .form-control:focus,.partner-editor-panel .form-select:focus{border-color:#06b6d4;box-shadow:0 0 0 .2rem rgba(6,182,212,.16)}
  .partner-table-panel .table-responsive{border:0;border-radius:0;box-shadow:none}.partner-table{min-width:1120px;margin:0;border-collapse:separate;border-spacing:0}.partner-table thead th{background:linear-gradient(135deg,#e0f2fe,#ecfdf3)!important;color:#0f172a;font-size:.76rem;font-weight:800;letter-spacing:0;text-transform:uppercase;white-space:nowrap}.partner-table th,.partner-table td{padding:1rem .95rem;vertical-align:middle;border-color:rgba(148,163,184,.13)}.partner-table td{line-height:1.45}.partner-table th:first-child,.partner-table td:first-child{padding-left:1.35rem}.partner-table th:last-child,.partner-table td:last-child{padding-right:1.35rem}.partner-table tbody tr{transition:background .14s ease,box-shadow .14s ease}.partner-table tbody tr:hover{box-shadow:inset 4px 0 0 #06b6d4}.partner-table tbody tr:hover>*{background:#f0f9ff}.status-pill{display:inline-flex;align-items:center;padding:.32rem .58rem;border-radius:999px;color:#fff;font-size:.72rem;font-weight:800}.status-Active{background:linear-gradient(135deg,#16a34a,#22c55e)}.status-Suspended{background:linear-gradient(135deg,#f59e0b,#facc15)}.status-Inactive{background:#e2e8f0;color:#475569}.partner-actions{display:grid;grid-template-columns:repeat(2,max-content);gap:.45rem}.partner-actions .btn{min-height:32px;padding:.38rem .62rem;border-radius:7px;font-size:.7rem;font-weight:800}.partner-actions .btn-outline-primary{border-color:#bae6fd;background:#e0f2fe;color:#075985}.partner-actions .btn-outline-warning{border-color:#fde68a;background:#fef3c7;color:#92400e}.partner-actions .btn-outline-success{border-color:#bbf7d0;background:#dcfce7;color:#166534}.partner-actions .btn-outline-secondary{border-color:#cbd5e1;background:#f1f5f9;color:#475569}
  .plan-pill{display:inline-flex;align-items:center;padding:.3rem .55rem;border-radius:999px;background:#ede9fe;color:#5b21b6;font-size:.72rem;font-weight:800}.plan-fee{margin-top:.2rem;color:#64748b;font-family:'DM Mono',monospace;font-size:.72rem}.plan-help{min-height:54px;padding:.7rem .8rem;border:1px solid #dbeafe;border-radius:8px;background:#eff6ff;color:#334155;font-size:.78rem}
  .billing-auto{display:inline-flex;align-items:center;gap:.32rem;color:#166534;font-size:.72rem;font-weight:800}.billing-manual{color:#64748b}.automation-box{height:100%;padding:.75rem .85rem;border:1px solid #d1fae5;border-radius:8px;background:#f0fdf4}.automation-box .form-check{margin:0}.automation-box .form-check-input:checked{border-color:#16a34a;background-color:#16a34a}
  .partner-editor-panel{padding:1.5rem}.partner-editor-panel[hidden]{display:none!important}.partner-editor-header{margin:-.2rem -.2rem 1.4rem;padding:.85rem 1rem;border:1px solid #dbeafe;border-radius:8px;background:linear-gradient(135deg,#eff6ff,#ecfdf5)}.partner-editor-header .partner-panel-title{margin:0;font-size:1.05rem}.partner-editor-header .partner-panel-title i{width:34px;height:34px;font-size:.9rem;box-shadow:0 8px 16px rgba(15,118,110,.18)}.partner-editor-close{display:inline-flex;align-items:center;justify-content:center;flex:0 0 34px;width:34px;height:34px;padding:0!important;border:1px solid #e2e8f0!important;border-radius:8px!important;background:#f8fafc!important;color:#64748b!important;box-shadow:none!important}.partner-editor-close:hover{border-color:#fecaca!important;background:#fef2f2!important;color:#dc2626!important;transform:none!important}.partner-editor-actions{display:flex;justify-content:flex-end;gap:.75rem;margin-top:1.5rem;padding-top:1.1rem;border-top:1px solid rgba(148,163,184,.18)}.partner-editor-actions #cancelEditor{border-color:#065f46!important;background:#065f46!important;color:#fff!important}.partner-editor-actions #cancelEditor:hover{border-color:#064e3b!important;background:#064e3b!important;color:#fff!important}.partner-editor-panel .btn-success{border:0;background:linear-gradient(135deg,var(--pc-green),var(--pc-lime));box-shadow:0 10px 20px rgba(11,143,62,.2)}.partner-editor-panel .btn-success:hover{background:linear-gradient(135deg,#087a34,#65a30d)}.required::after{content:' *';color:#dc2626}.partner-page .alert{border:0;border-radius:8px;box-shadow:0 12px 24px rgba(15,23,42,.08)}
  @media(max-width:900px){.partner-stats{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.partner-page{padding:.85rem}.partner-hero{padding:1rem;align-items:flex-start!important}.partner-new-customer{width:100%}.partner-stats{grid-template-columns:1fr}.partner-panel-head{padding:1rem}.partner-editor-panel{padding:1rem}}
</style>

<div class="partner-page">
  <section class="partner-hero d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div><div class="partner-eyebrow">Partner Subscription Billing</div><h1 class="h3 mb-1">Partner Customers</h1><p class="mb-0">Admin master-data workspace for fictional demonstration customers.</p></div>
    <button class="btn btn-light fw-bold partner-new-customer" id="newCustomer"><i class="fa-solid fa-plus me-1"></i> Add Customer</button>
  </section>

  <div id="alertBox"></div>
  <section class="partner-stats mb-4">
    <div class="partner-stat"><i class="fa-solid fa-building partner-stat-icon" aria-hidden="true"></i><span class="partner-stat-label">Total Customers</span><strong id="totalCount">0</strong><small>All subscription records</small></div>
    <div class="partner-stat"><i class="fa-solid fa-circle-check partner-stat-icon" aria-hidden="true"></i><span class="partner-stat-label">Active</span><strong id="activeCount">0</strong><small>Available for monthly billing</small></div>
    <div class="partner-stat"><i class="fa-solid fa-pause partner-stat-icon" aria-hidden="true"></i><span class="partner-stat-label">Suspended</span><strong id="suspendedCount">0</strong><small>Billing temporarily paused</small></div>
    <div class="partner-stat"><i class="fa-solid fa-circle-minus partner-stat-icon" aria-hidden="true"></i><span class="partner-stat-label">Inactive</span><strong id="inactiveCount">0</strong><small>No longer active</small></div>
  </section>

  <section class="partner-panel partner-filter-panel mb-4">
    <h2 class="partner-panel-title"><i class="fa-solid fa-filter" aria-hidden="true"></i> Search and Filter</h2>
    <div class="row g-2">
      <div class="col-md-8"><label class="form-label" for="search">Search</label><input class="form-control" id="search" placeholder="Customer code, business, contact, or email"></div>
      <div class="col-md-4"><label class="form-label" for="statusFilter">Status</label><select class="form-select" id="statusFilter"><option value="">All statuses</option><option>Active</option><option>Suspended</option><option>Inactive</option></select></div>
    </div>
  </section>

  <section class="partner-panel partner-table-panel mb-4">
    <div class="partner-panel-head"><h2 class="partner-panel-title"><i class="fa-solid fa-list-check" aria-hidden="true"></i> Customer Register</h2></div>
    <div class="table-responsive">
      <table class="table table-hover partner-table"><thead><tr><th>Customer</th><th>Business</th><th>Contact</th><th>Plan</th><th>Billing</th><th>Automation</th><th>Status</th><th>Actions</th></tr></thead><tbody id="customerRows"><tr><td colspan="8" class="text-center text-muted py-4">Loading…</td></tr></tbody></table>
    </div>
  </section>

  <section class="partner-panel partner-editor-panel" id="editorPanel" hidden>
    <div class="partner-editor-header d-flex justify-content-between align-items-center"><h2 class="partner-panel-title"><i class="fa-solid fa-pen-to-square" aria-hidden="true"></i><span id="editorTitle">Add Customer</span></h2><button type="button" class="partner-editor-close" id="closeEditor" aria-label="Close customer editor" title="Close"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></div>
    <form id="customerForm">
      <input type="hidden" id="customerId">
      <div class="row g-3">
        <div class="col-md-6"><label class="form-label required" for="businessName">Business name</label><input class="form-control" id="businessName" maxlength="255" placeholder="Customer 1" required></div>
        <div class="col-md-6"><label class="form-label required" for="businessType">Business type</label><select class="form-select" id="businessType" required><option value="">Select a type</option><% businessTypes.forEach(type => { %><option><%= type %></option><% }) %></select></div>
        <div class="col-md-6"><label class="form-label required" for="contactPerson">Contact person</label><input class="form-control" id="contactPerson" maxlength="255" placeholder="Contact Person 1" required></div>
        <div class="col-md-6"><label class="form-label required" for="billingEmail">Billing email</label><input class="form-control" id="billingEmail" type="email" maxlength="255" placeholder="customer1@example.com" required></div>
        <div class="col-md-4"><label class="form-label" for="phone">Phone</label><input class="form-control" id="phone" maxlength="30"></div>
        <div class="col-md-4"><label class="form-label" for="region">Region</label><select class="form-select" id="region"><option value="">Select region</option><option>Central Singapore</option><option>East Singapore</option><option>North Singapore</option><option>North-East Singapore</option><option>West Singapore</option></select></div>
        <div class="col-md-4"><label class="form-label required" for="subscriptionStartDate">Subscription start</label><input class="form-control" id="subscriptionStartDate" type="date" required></div>
        <div class="col-md-8"><label class="form-label" for="billingAddress">Billing address</label><input class="form-control" id="billingAddress" maxlength="500"></div>
        <div class="col-md-4"><label class="form-label required" for="subscriptionPlanId">Subscription plan</label><select class="form-select" id="subscriptionPlanId" required><option value="">Select a plan</option><% plans.forEach(plan => { %><option value="<%= plan.id %>" data-fee="<%= Number(plan.monthlyFee).toFixed(2) %>" data-features="<%= (plan.features || []).join(' • ') %>"><%= plan.name %> — SGD <%= Number(plan.monthlyFee).toFixed(2) %>/month</option><% }) %></select></div>
        <div class="col-md-3"><label class="form-label" for="paymentTermsDays">Payment terms</label><div class="input-group"><input class="form-control" id="paymentTermsDays" type="number" min="0" max="365" value="14"><span class="input-group-text">days</span></div></div>
        <div class="col-md-3"><label class="form-label" for="customerStatus">Status</label><select class="form-select" id="customerStatus"><option>Active</option><option>Suspended</option><option>Inactive</option></select></div>
        <div class="col-12"><div class="plan-help" id="planHelp">Choose Basic, Standard, or Premium to view its monthly fee and included features.</div></div>
        <div class="col-md-5"><div class="automation-box"><div class="form-check form-switch"><input class="form-check-input" id="autoBillingEnabled" type="checkbox" checked><label class="form-check-label fw-semibold" for="autoBillingEnabled">Generate subscription invoices automatically</label></div><div class="small text-muted mt-1">Only active customers with this enabled will be eligible.</div></div></div>
        <div class="col-md-4"><label class="form-label" for="nextBillingDate">Next billing date</label><input class="form-control" id="nextBillingDate" type="date" required></div>
        <div class="col-12"><label class="form-label" for="notes">Internal notes</label><textarea class="form-control" id="notes" rows="2"></textarea></div>
      </div>
      <div class="partner-editor-actions"><button type="button" class="btn btn-outline-secondary" id="cancelEditor">Cancel</button><button class="btn btn-success" id="saveCustomer">Save Customer</button></div>
    </form>
  </section>
</div>

<script>
const token = localStorage.getItem('token');
if (!token) location.href = '/login';
let customers = [];
const authHeaders = {'Authorization': `Bearer ${token}`};
const escapeHtml = value => String(value ?? '').replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));

function showAlert(message, type='danger') {
  document.getElementById('alertBox').innerHTML = `<div class="alert alert-${type}" role="alert">${escapeHtml(message)}</div>`;
}
async function api(url, options={}) {
  const headers = {...authHeaders, ...(options.headers || {})};
  const response = await fetch(url, {...options, headers});
  const data = await response.json().catch(() => ({}));
  if (!response.ok) throw new Error(data.details?.map(item => item.message).join(' ') || data.error || 'Request failed');
  return data;
}
function refreshStats() {
  document.getElementById('totalCount').textContent = customers.length;
  ['Active','Suspended','Inactive'].forEach(status => document.getElementById(status.toLowerCase() + 'Count').textContent = customers.filter(c => c.status === status).length);
}
function render() {
  const query = document.getElementById('search').value.trim().toLowerCase();
  const status = document.getElementById('statusFilter').value;
  const visible = customers.filter(c => (!status || c.status === status) && (!query || `${c.customerCode} ${c.businessName} ${c.contactPerson} ${c.billingEmail}`.toLowerCase().includes(query)));
  const rows = document.getElementById('customerRows');
  if (!visible.length) { rows.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">No partner customers found.</td></tr>'; return; }
  rows.innerHTML = visible.map(c => `<tr>
    <td><strong>${escapeHtml(c.customerCode)}</strong><div class="small text-muted">Started ${escapeHtml(c.subscriptionStartDate)}</div></td>
    <td><strong>${escapeHtml(c.businessName)}</strong><div class="small text-muted">${escapeHtml(c.businessType)}${c.region ? ' · ' + escapeHtml(c.region) : ''}</div></td>
    <td>${escapeHtml(c.contactPerson)}<div class="small text-muted">${escapeHtml(c.phone || 'No phone')}</div></td>
    <td><span class="plan-pill">${escapeHtml(c.subscriptionPlan?.name || 'Unassigned')}</span><div class="plan-fee">${c.subscriptionPlan ? `${escapeHtml(c.subscriptionPlan.currency)} ${Number(c.subscriptionPlan.monthlyFee).toFixed(2)}/month` : ''}</div></td>
    <td>${escapeHtml(c.billingEmail)}<div class="small text-muted">Monthly · ${Number(c.paymentTermsDays)} days</div></td>
    <td>${c.autoBillingEnabled ? `<span class="billing-auto"><i class="fa-solid fa-rotate"></i> Automatic</span><div class="small text-muted">Next: ${escapeHtml(c.nextBillingDate || 'Not set')}</div>` : '<span class="billing-auto billing-manual"><i class="fa-solid fa-hand"></i> Manual</span>'}</td>
    <td><span class="status-pill status-${escapeHtml(c.status)}">${escapeHtml(c.status)}</span></td>
    <td><div class="partner-actions"><button class="btn btn-sm btn-outline-primary" data-edit="${c.id}">Edit</button>${c.status === 'Active' ? `<button class="btn btn-sm btn-outline-warning" data-status-id="${c.id}" data-status="Suspended">Suspend</button>` : `<button class="btn btn-sm btn-outline-success" data-status-id="${c.id}" data-status="Active">Activate</button>`}<button class="btn btn-sm btn-outline-secondary" data-status-id="${c.id}" data-status="Inactive">Deactivate</button></div></td>
  </tr>`).join('');
}
async function loadCustomers() {
  customers = await api('/api/partner-customers');
  refreshStats(); render();
}
function openEditor(customer=null) {
  document.getElementById('customerForm').reset();
  document.getElementById('paymentTermsDays').value = 14;
  document.getElementById('customerStatus').value = 'Active';
  document.getElementById('subscriptionPlanId').value = customer?.subscriptionPlanId || '';
  document.getElementById('autoBillingEnabled').checked = customer ? Boolean(customer.autoBillingEnabled) : true;
  document.getElementById('nextBillingDate').value = customer?.nextBillingDate || '';
  document.getElementById('customerId').value = customer?.id || '';
  document.getElementById('editorTitle').textContent = customer ? `Edit ${customer.customerCode}` : 'Add Customer';
  ['businessName','businessType','contactPerson','billingEmail','phone','billingAddress','region','subscriptionStartDate','status','notes'].forEach(field => {
    const element = document.getElementById(field === 'status' ? 'customerStatus' : field);
    if (customer && element) element.value = customer[field] || '';
  });
  if (customer) document.getElementById('paymentTermsDays').value = customer.paymentTermsDays;
  updatePlanHelp();
  syncAutomationFields();
  document.getElementById('editorPanel').hidden = false;
  document.getElementById('editorPanel').scrollIntoView({behavior:'smooth'});
}
function closeEditor() { document.getElementById('editorPanel').hidden = true; }
document.getElementById('newCustomer').addEventListener('click', () => openEditor());
document.getElementById('closeEditor').addEventListener('click', closeEditor);
document.getElementById('cancelEditor').addEventListener('click', closeEditor);
function updatePlanHelp() {
  const select = document.getElementById('subscriptionPlanId');
  const option = select.options[select.selectedIndex];
  document.getElementById('planHelp').textContent = option && option.value
    ? `SGD ${option.dataset.fee} per month • ${option.dataset.features}`
    : 'Choose Basic, Standard, or Premium to view its monthly fee and included features.';
}
document.getElementById('subscriptionPlanId').addEventListener('change', updatePlanHelp);
function syncAutomationFields() {
  const enabled = document.getElementById('autoBillingEnabled').checked;
  const nextBillingDate = document.getElementById('nextBillingDate');
  nextBillingDate.disabled = !enabled;
  nextBillingDate.required = enabled;
  if (!enabled) nextBillingDate.value = '';
}
document.getElementById('autoBillingEnabled').addEventListener('change', syncAutomationFields);
['search','statusFilter'].forEach(id => document.getElementById(id).addEventListener('input', render));
document.getElementById('customerRows').addEventListener('click', async event => {
  const edit = event.target.closest('[data-edit]');
  if (edit) return openEditor(customers.find(c => Number(c.id) === Number(edit.dataset.edit)));
  const statusButton = event.target.closest('[data-status-id]');
  if (!statusButton) return;
  const customer = customers.find(c => Number(c.id) === Number(statusButton.dataset.statusId));
  if (!confirm(`${statusButton.dataset.status} ${customer?.businessName || 'this customer'}?`)) return;
  try { await api(`/api/partner-customers/${statusButton.dataset.statusId}/status`, {method:'PATCH', headers:{'Content-Type':'application/json'}, body:JSON.stringify({status:statusButton.dataset.status})}); await loadCustomers(); showAlert('Customer status updated.', 'success'); } catch(error) { showAlert(error.message); }
});
document.getElementById('customerForm').addEventListener('submit', async event => {
  event.preventDefault();
  const id = document.getElementById('customerId').value;
  const payload = {};
  ['businessName','businessType','contactPerson','billingEmail','phone','billingAddress','region','subscriptionStartDate','notes'].forEach(field => payload[field] = document.getElementById(field).value);
  payload.paymentTermsDays = Number(document.getElementById('paymentTermsDays').value);
  payload.subscriptionPlanId = Number(document.getElementById('subscriptionPlanId').value);
  payload.autoBillingEnabled = document.getElementById('autoBillingEnabled').checked;
  payload.nextBillingDate = document.getElementById('nextBillingDate').value || null;
  payload.status = document.getElementById('customerStatus').value;
  const button = document.getElementById('saveCustomer'); button.disabled = true;
  try {
    await api(id ? `/api/partner-customers/${id}` : '/api/partner-customers', {method:id ? 'PATCH' : 'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
    closeEditor(); await loadCustomers(); showAlert(id ? 'Customer updated.' : 'Customer created.', 'success');
  } catch(error) { showAlert(error.message); } finally { button.disabled = false; }
});
loadCustomers().catch(error => showAlert(error.message));
</script>

