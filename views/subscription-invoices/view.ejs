<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %></title>
  <style>
    :root{font-family:Inter,system-ui,sans-serif;color:#102033;background:#eef7f1}*{box-sizing:border-box}body{margin:0;padding:24px}.page{max-width:820px;margin:auto}.hero,.card{border:1px solid #d9e8df;border-radius:18px;background:#fff;box-shadow:0 14px 35px rgba(15,41,66,.08)}.hero{padding:28px;color:#fff;background:linear-gradient(125deg,#0f2942,#0f766e 58%,#22a85a)}.hero p{margin:.35rem 0 0;opacity:.8}.card{margin-top:16px;padding:24px}.meta{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.meta div{padding:12px;border-radius:10px;background:#f6faf7}.meta span{display:block;color:#66786e;font-size:.72rem;text-transform:uppercase}.meta strong{display:block;margin-top:4px}table{width:100%;margin-top:22px;border-collapse:collapse}th,td{padding:12px;border-bottom:1px solid #e6eee9;text-align:left}th:last-child,td:last-child{text-align:right}.totals{margin:18px 0 0 auto;width:min(100%,320px)}.totals div{display:flex;justify-content:space-between;padding:7px}.total{font-size:1.15rem;font-weight:800;color:#08743a}.notice{margin-top:18px;padding:13px;border-radius:10px;background:#e8f7ee;color:#17653a}@media(max-width:600px){body{padding:12px}.hero,.card{padding:18px}.meta{grid-template-columns:1fr}table{font-size:.85rem}}
  </style>
</head>
<body>
  <main class="page">
    <header class="hero"><div>Vaniday Singapore · Partner Subscription</div><h1>Invoice <%= invoice.number %></h1><p>This secure page displays your subscription billing record.</p></header>
    <section class="card">
      <div class="meta">
        <div><span>Customer</span><strong><%= invoice.businessNameSnapshot %></strong></div>
        <div><span>Status</span><strong><%= invoice.status.replace(/([a-z])([A-Z])/g, '$1 $2') %></strong></div>
        <div><span>Billing period</span><strong><%= invoice.billingPeriodStart %> to <%= invoice.billingPeriodEnd %></strong></div>
        <div><span>Payment due</span><strong><%= invoice.dueDate %> · Net <%= invoice.paymentTermsDaysSnapshot %></strong></div>
      </div>
      <table>
        <thead><tr><th>Description</th><th>Amount</th></tr></thead>
        <tbody><% invoice.items.forEach(item => { %><tr><td><%= item.description %></td><td><%= invoice.currency %> <%= Number(item.lineAmount).toFixed(2) %></td></tr><% }) %></tbody>
      </table>
      <div class="totals">
        <div><span>Subtotal</span><strong><%= invoice.currency %> <%= Number(invoice.subtotal).toFixed(2) %></strong></div>
        <div><span>Tax</span><strong><%= invoice.currency %> <%= Number(invoice.taxAmount).toFixed(2) %></strong></div>
        <div class="total"><span>Total</span><strong><%= invoice.currency %> <%= Number(invoice.totalAmount).toFixed(2) %></strong></div>
      </div>
      <div class="notice">Payment collection will be connected in the next workflow stage. Please retain the attached PDF invoice for your records.</div>
    </section>
  </main>
</body>
</html>
