<%- include('../partials/header', { title: typeof title !== 'undefined' ? title : 'Audit Logs' }) %>
<%- include('../partials/navbar') %>
<%- include('./_admin_nav') %>

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
:root {
  --al-bg: #f0fdf4;
  --al-surface: #ffffff;
  --al-surface2: #f8fdf9;
  --al-border: #d1fae5;
  --al-border2: #bbf7d0;
  --al-text: #0f1c14;
  --al-muted: #6b8c78;
  --al-accent: #16a34a;
  --al-accent2: #22c55e;
  --al-blue: #2563eb;
  --al-amber: #d97706;
  --al-red: #dc2626;
  --al-shadow-sm: 0 1px 3px rgba(6,78,39,.08), 0 1px 2px rgba(6,78,39,.04);
  --al-shadow-md: 0 4px 16px rgba(6,78,39,.1), 0 2px 6px rgba(6,78,39,.06);
  --al-radius: 18px;
  --al-radius-sm: 12px;
}

body {
  background: var(--al-bg) !important;
  color: var(--al-text);
  font-family: 'Sora', sans-serif;
}

.audit-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
  animation: audit-in .45s cubic-bezier(.22,.8,.36,1) both;
}

@keyframes audit-in {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: none; }
}

.audit-header,
.audit-filters,
.audit-table-wrap,
.no-results {
  background: var(--al-surface);
  border: 1px solid var(--al-border);
  border-radius: var(--al-radius);
  box-shadow: var(--al-shadow-sm);
}

.audit-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
  padding: 1.25rem 1.35rem;
}

.section-eyebrow {
  margin: 0 0 .35rem;
  color: #15803d;
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.audit-header h2 {
  margin: 0;
  font-size: 1.75rem;
  font-weight: 700;
  color: var(--al-text);
}

.audit-header .text-muted {
  color: var(--al-muted) !important;
  font-size: .92rem;
}

.audit-filters {
  margin-bottom: 1rem;
  padding: 1rem 1.1rem;
}

.audit-filter-form {
  display: grid;
  grid-template-columns: 1.2fr 1.2fr .9fr .9fr auto;
  gap: .9rem;
  align-items: end;
}

.filter-group {
  display: flex;
  flex-direction: column;
  gap: .35rem;
}

.filter-group label {
  color: var(--al-muted);
  font-size: .8rem;
  font-weight: 600;
}

.filter-group select,
.filter-group input {
  min-height: 42px;
  border: 1px solid var(--al-border);
  border-radius: var(--al-radius-sm);
  background: var(--al-surface2);
  color: var(--al-text);
  padding: .55rem .75rem;
  box-shadow: none;
}

.filter-group select:focus,
.filter-group input:focus {
  outline: none;
  border-color: var(--al-accent);
  box-shadow: 0 0 0 .15rem rgba(22,163,74,.12);
}

.filter-action button {
  min-height: 42px;
  padding: .55rem 1rem;
  border: 1px solid var(--al-accent);
  border-radius: var(--al-radius-sm);
  background: var(--al-accent);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--al-shadow-sm);
  transition: transform .15s ease, background .15s ease, border-color .15s ease;
}

.filter-action button:hover {
  transform: translateY(-1px);
  background: var(--al-accent2);
  border-color: var(--al-accent2);
}

.audit-table-wrap {
  overflow: hidden;
}

.audit-table {
  margin-bottom: 0;
  width: 100%;
}

.audit-table thead th {
  font-size: .72rem;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--al-muted);
  font-weight: 700;
  border-bottom: 1px solid var(--al-border);
  background: linear-gradient(180deg, #ffffff 0%, #f8fdf9 100%);
}

.audit-table td,
.audit-table th {
  padding: .9rem .85rem;
  border-color: var(--al-border);
  vertical-align: middle;
}

.audit-table tbody tr:hover td {
  background: var(--al-surface2);
}

.timestamp,
.meta,
.audit-table td:last-child,
.audit-table td:nth-child(5) {
  font-family: 'DM Mono', monospace;
  font-size: .85rem;
}

.user-info strong {
  color: var(--al-text);
  font-size: .9rem;
}

.user-info small {
  color: var(--al-muted);
}

.action-badge,
.entity-badge {
  display: inline-flex;
  align-items: center;
  gap: .35rem;
  padding: .25rem .7rem;
  border-radius: 999px;
  font-size: .75rem;
  font-weight: 600;
  line-height: 1.2;
}

.action-badge::before,
.entity-badge::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.action-badge {
  background: #eef6ff;
  color: #1d4ed8;
}

.action-badge::before {
  background: var(--al-blue);
}

.action-create {
  background: rgba(22,163,74,.12);
  color: #15803d;
}

.action-create::before {
  background: var(--al-accent);
}

.action-update {
  background: rgba(217,119,6,.12);
  color: #b45309;
}

.action-update::before {
  background: var(--al-amber);
}

.action-delete,
.action-failed {
  background: rgba(220,38,38,.12);
  color: #b91c1c;
}

.action-delete::before,
.action-failed::before {
  background: var(--al-red);
}

.action-login {
  background: rgba(37,99,235,.12);
  color: #1d4ed8;
}

.action-login::before {
  background: var(--al-blue);
}

.entity-badge {
  background: rgba(22,163,74,.08);
  color: #15803d;
}

.entity-badge::before {
  background: var(--al-accent);
}

.no-results {
  padding: 2rem 1rem;
  text-align: center;
  color: var(--al-muted);
}

.no-results p {
  margin: 0;
}

@media (max-width: 1100px) {
  .audit-filter-form {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .filter-action {
    grid-column: 1 / -1;
  }
}

@media (max-width: 640px) {
  .audit-page {
    padding: 1.25rem 1rem 3rem;
  }

  .audit-header {
    padding: 1.1rem;
  }

  .audit-header h2 {
    font-size: 1.45rem;
  }

  .audit-filter-form {
    grid-template-columns: 1fr;
  }
}

:root { --al-bg:#f8fafc; --al-surface:#fff; --al-border:rgba(148,163,184,.18); --al-border2:rgba(37,99,235,.28); --al-text:#102033; --al-muted:#64748b; --al-accent:#0b8f3e; --al-blue:#2563eb; --al-amber:#f59e0b; --al-red:#ef4444; --al-shadow-sm:0 14px 30px rgba(15,23,42,.08); --al-shadow-md:0 22px 38px rgba(15,23,42,.16); --al-radius:8px; --al-radius-sm:8px; }
body:has(.audit-page){background:linear-gradient(135deg,#f7faf8 0%,#e8f7ee 48%,#f8fbf9 100%)!important}
.audit-page{max-width:1220px;padding:1.1rem;box-sizing:border-box;background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(248,250,252,.94)),linear-gradient(90deg,rgba(6,182,212,.12),rgba(124,58,237,.12))}
.audit-header{position:relative;overflow:hidden;margin-bottom:1rem;padding:1.35rem;border:1px solid rgba(37,99,235,.18);border-radius:var(--al-radius);background:linear-gradient(135deg,rgba(15,23,42,.94),rgba(37,99,235,.86) 46%,rgba(11,143,62,.82));box-shadow:0 18px 38px rgba(15,23,42,.16)}
.audit-header::after{position:absolute;right:-56px;bottom:-84px;width:260px;height:150px;background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.03));content:'';transform:rotate(-18deg)}.audit-header>*{position:relative;z-index:1}.section-eyebrow{display:inline-flex;align-items:center;min-height:24px;padding:.25rem .58rem;border:1px solid rgba(255,255,255,.28);border-radius:999px;background:rgba(255,255,255,.12);color:#fff;font-size:.72rem;letter-spacing:0}.audit-header h2,.audit-header .text-muted{color:#fff!important}.audit-header .text-muted{opacity:.88}
.audit-filters{margin-bottom:1rem;padding:1rem 1.1rem;border:1px solid var(--al-border);border-radius:var(--al-radius);background:linear-gradient(135deg,rgba(255,255,255,.98),rgba(255,247,237,.82));box-shadow:var(--al-shadow-sm)}.filter-group label{color:var(--al-muted)}.filter-group select,.filter-group input{border-color:rgba(148,163,184,.28);border-radius:8px;background:#fff}.filter-group select:focus,.filter-group input:focus{border-color:#06b6d4;box-shadow:0 0 0 .2rem rgba(6,182,212,.16)}.filter-action button{border:0;border-radius:8px;background:linear-gradient(135deg,#0b8f3e,#84cc16);box-shadow:0 12px 24px rgba(11,143,62,.22)}.filter-action button:hover{background:linear-gradient(135deg,#087a34,#65a30d);transform:translateY(-2px)}
.audit-table-wrap{border:1px solid var(--al-border);border-radius:var(--al-radius);background:linear-gradient(180deg,rgba(255,255,255,.98),rgba(240,249,255,.78));box-shadow:var(--al-shadow-sm);overflow-x:auto}.audit-table{border-collapse:separate;border-spacing:0}.audit-table thead th{background:linear-gradient(135deg,#e0f2fe,#ecfdf3)!important;color:#0f172a;font-size:.76rem;font-weight:800;letter-spacing:0}.audit-table th,.audit-table td{border-color:rgba(148,163,184,.13)}.audit-table tbody tr{transition:background .14s ease,box-shadow .14s ease}.audit-table tbody tr:hover{box-shadow:inset 4px 0 0 #06b6d4}.audit-table tbody tr:hover td{background:#f0f9ff}.action-badge,.entity-badge{font-weight:800}.action-create{background:linear-gradient(135deg,#16a34a,#22c55e);color:#fff}.action-update{background:linear-gradient(135deg,#f59e0b,#facc15);color:#fff}.action-delete,.action-failed{background:linear-gradient(135deg,#dc2626,#fb7185);color:#fff}.action-login,.action-badge:not(.action-create):not(.action-update):not(.action-delete):not(.action-failed){background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff}.entity-badge{background:#e2e8f0;color:#475569}.no-results{border:1px dashed rgba(37,99,235,.26);border-radius:8px;background:linear-gradient(135deg,#fff,#f0f9ff)}
@media(max-width:640px){.audit-page{padding:.85rem}.audit-header{padding:1rem}}
</style>

<section class="admin-page audit-page">
  <div class="audit-header">
    <div>
      <p class="section-eyebrow">Administration</p>
      <h1>Audit Logs</h1>
      <p class="text-muted mb-0">Review authentication, user, payment, and system activity in one control center.</p>
    </div>
  </div>

  <div class="audit-filters">
    <form method="GET" action="/admin/audit-logs" class="audit-filter-form">
      <div class="filter-group">
        <label for="action">Action</label>
        <select name="action" id="action">
          <option value="">All Actions</option>
          <option value="register" <%= (filters?.action === 'register') ? 'selected' : '' %>>Register</option>
          <option value="login_success" <%= (filters?.action === 'login_success') ? 'selected' : '' %>>Login Success</option>
          <option value="login_failed" <%= (filters?.action === 'login_failed') ? 'selected' : '' %>>Login Failed</option>
          <option value="mfa_enabled" <%= (filters?.action === 'mfa_enabled') ? 'selected' : '' %>>MFA Enabled</option>
          <option value="password_reset" <%= (filters?.action === 'password_reset') ? 'selected' : '' %>>Password Reset</option>
          <option value="create" <%= (filters?.action === 'create') ? 'selected' : '' %>>Create</option>
          <option value="update" <%= (filters?.action === 'update') ? 'selected' : '' %>>Update</option>
          <option value="delete" <%= (filters?.action === 'delete') ? 'selected' : '' %>>Delete</option>
          <option value="payment_received" <%= (filters?.action === 'payment_received') ? 'selected' : '' %>>Payment Received</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="entity">Entity</label>
        <select name="entity" id="entity">
          <option value="">All Entities</option>
          <option value="User" <%= (filters?.entity === 'User') ? 'selected' : '' %>>User</option>
          <option value="Invoice" <%= (filters?.entity === 'Invoice') ? 'selected' : '' %>>Invoice</option>
          <option value="Payment" <%= (filters?.entity === 'Payment') ? 'selected' : '' %>>Payment</option>
          <option value="Payroll" <%= (filters?.entity === 'Payroll') ? 'selected' : '' %>>Payroll</option>
        </select>
      </div>

      <div class="filter-group">
        <label for="startDate">From</label>
        <input type="date" name="startDate" id="startDate" value="<%= filters?.startDate || '' %>">
      </div>

      <div class="filter-group">
        <label for="endDate">To</label>
        <input type="date" name="endDate" id="endDate" value="<%= filters?.endDate || '' %>">
      </div>

      <div class="filter-group filter-action">
        <button type="submit">Filter</button>
      </div>
    </form>
  </div>

  <% if (logs && logs.length > 0) { %>
    <div class="audit-table-wrap">
      <table class="table table-hover align-middle mb-0 audit-table">
        <thead>
          <tr>
            <th>Timestamp</th>
            <th>User</th>
            <th>Action</th>
            <th>Entity</th>
            <th>Entity ID</th>
            <th>Metadata</th>
            <th>IP Address</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(log => { %>
            <tr>
              <td class="timestamp">
                <%= new Date(log.createdAt).toLocaleString() %>
              </td>
              <td class="user-info">
                <% if (log.user) { %>
                  <strong><%= log.user.name %></strong><br>
                  <small><%= log.user.email %></small>
                <% } else { %>
                  <small>System / Anonymous</small>
                <% } %>
              </td>
              <td>
                <span class="action-badge <%= 
                  log.action.includes('login_failed') || log.action.includes('failed') ? 'action-failed' :
                  log.action === 'register' ? 'action-login' :
                  log.action.includes('create') || log.action.includes('_sent') || log.action.includes('_enabled') ? 'action-create' :
                  log.action.includes('update') || log.action.includes('_confirmed') ? 'action-update' :
                  log.action.includes('delete') ? 'action-delete' : ''
                %>">
                  <%= log.action %>
                </span>
              </td>
              <td>
                <span class="entity-badge"><%= log.entity %></span>
              </td>
              <td><%= log.entityId || '-' %></td>
              <td class="meta" title="<%= JSON.stringify(log.meta) %>">
                <% 
                  try {
                    const meta = typeof log.meta === 'string' ? JSON.parse(log.meta) : log.meta;
                    let metaStr = '';
                    if (meta) {
                      const keys = Object.keys(meta).slice(0, 3);
                      metaStr = keys.map(k => `${k}: ${typeof meta[k] === 'object' ? JSON.stringify(meta[k]) : meta[k]}`).join(', ');
                    }
                %>
                  <%= metaStr || '-' %>
                <% } catch(e) { %>
                  <%= '-' %>
                <% } %>
              </td>
              <td><%= log.ip || '-' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="audit-pagination d-flex justify-content-between align-items-center mt-3">
      <span class="text-muted small">Showing <%= logs.length %> result<%= logs.length === 1 ? '' : 's' %></span>
      <div class="d-flex gap-2">
        <% 
          const currentOffset = parseInt(filters?.offset, 10) || 0;
          const currentLimit = parseInt(filters?.limit, 10) || 200;
          const prevOffset = Math.max(0, currentOffset - currentLimit);
          const nextOffset = currentOffset + currentLimit;
        %>
        <a class="btn btn-sm btn-outline-secondary <%= currentOffset === 0 ? 'disabled' : '' %>"
           href="?action=<%= filters?.action || '' %>&entity=<%= filters?.entity || '' %>&startDate=<%= filters?.startDate || '' %>&endDate=<%= filters?.endDate || '' %>&offset=<%= prevOffset %>">Previous</a>
        <a class="btn btn-sm btn-outline-secondary <%= logs.length < currentLimit ? 'disabled' : '' %>"
           href="?action=<%= filters?.action || '' %>&entity=<%= filters?.entity || '' %>&startDate=<%= filters?.startDate || '' %>&endDate=<%= filters?.endDate || '' %>&offset=<%= nextOffset %>">Next</a>
      </div>
    </div>
  <% } else { %>
    <div class="no-results">
      <p>No audit logs found matching the filters.</p>
    </div>
  <% } %>
</section>

<%- include('../partials/footer', { title: typeof title !== 'undefined' ? title : 'Audit Logs' }) %>
