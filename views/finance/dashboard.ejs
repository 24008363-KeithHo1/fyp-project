        <div class="fd-action-label">Payments</div>
        <div class="fd-action-desc">Record and reconcile payments.</div>
      </a>
      <a href="/finance/bank-reconcile" class="fd-action-card">
        <div class="fd-action-icon"><i class="fa-solid fa-building-columns"></i></div>
        <div class="fd-action-label">Bank Reconciliation</div>
