<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
try{
  const payload = JSON.parse(atob(token.split('.')[1]));
  if (payload.role !== 'Finance' && payload.role !== 'Admin') location = '/dashboard';
}catch(e){ location = '/login'; }
</script>

<style>
/* Sticky in-page section navigation, matching the Finance Dashboard's pattern. */
html { scroll-behavior: smooth; }
.pmt-section-nav { position: sticky; top: 0; z-index: 20; display: flex; gap: .4rem; overflow-x: auto; margin-bottom: 1rem; padding: .6rem .7rem; border-radius: 8px; border: 1px solid rgba(148,163,184,.18); background: rgba(255,255,255,.92); backdrop-filter: blur(6px); box-shadow: 0 8px 20px rgba(15,23,42,.06); scrollbar-width: thin; }
.pmt-section-nav a { flex-shrink: 0; padding: .4rem .85rem; border-radius: 999px; font-size: .78rem; font-weight: 600; color: #475569; text-decoration: none; white-space: nowrap; transition: background .15s, color .15s; }
.pmt-section-nav a:hover { background: #f0fdf4; color: #0b8f3e; }
.pmt-section-nav a.pmt-section-active { background: linear-gradient(135deg,#0f766e,#22c55e); color: #fff; }
.pmt-section-nav a i { margin-right: .35rem; }

/* Spin feedback + last-updated timestamp for the existing Refresh button. */
.payment-refresh-btn i { transition: transform .5s ease; }
.payment-refresh-btn.pmt-spinning i { animation: pmt-spin .6s linear; }
@keyframes pmt-spin { to { transform: rotate(360deg); } }
.pmt-last-updated { display: block; margin-top: .2rem; font-size: .68rem; color: #64748b; font-weight: 500; }

/* Skeleton shimmer for loading states — replaces plain "Loading..." text. */
.pmt-skeleton-bar { height: 14px; border-radius: 6px; background: linear-gradient(90deg, #eef2f5 25%, #f8fafc 37%, #eef2f5 63%); background-size: 400% 100%; animation: pmt-shimmer 1.4s ease infinite; }
@keyframes pmt-shimmer { 0% { background-position: 100% 50%; } 100% { background-position: 0 50%; } }
</style>

