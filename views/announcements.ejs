<%- include('partials/header', { title: 'Announcements' }) %>
<%- include('partials/navbar') %>

<style>
.announcements-page { max-width:1100px; margin: 1.5rem auto; }
.post-card { border-radius:12px; border:1px solid rgba(0,0,0,.04); box-shadow:0 6px 18px rgba(2,6,23,0.06); }
.ann-card { border-radius:16px; overflow:hidden; box-shadow:0 6px 18px rgba(15,23,42,0.06); border:1px solid rgba(0,0,0,0.04); }
.ann-card .card-body { padding:1.2rem; }
.ann-card-title { margin:0 0 .15rem; font-size:1.05rem; font-weight:700; color:#0f172a; }
.ann-card-subtitle { color:#6b7280; font-size:.85rem; }
.ann-card-body { white-space:pre-line; color:#374151; margin-top:.6rem; font-size:.95rem; }
.ann-attachments a { display:inline-flex; align-items:center; gap:.5rem; padding:.35rem .6rem; margin-right:.5rem; margin-bottom:.5rem; background:#fbfcfd; border-radius:8px; border:1px solid #e6edf3; color:#111827; text-decoration:none; font-size:.86rem; }
.ann-meta { display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
.ann-author { color:#6b7280; font-size:.85rem; }
.btn-post { min-width:160px; }
@media (max-width:680px) { .ann-meta { flex-direction:column; align-items:flex-start; } }
</style>

<script>const token = localStorage.getItem('token'); if (!token) location = '/login';</script>

<div class="announcements-page container-fluid">
  <div class="d-flex align-items-center justify-content-between mb-3 mt-2">
    <h2 class="mb-0">Announcements</h2>
    <% if (user && (user.role === 'Admin' || user.role === 'HR')) { %>
      <a href="/announcements/new" class="btn btn-success btn-post"><button>Create Announcement</button></a>
    <% } %>
  </div><br>

  <div class="row">
    <div class="col-lg-9">
      <div class="announcements-list">
        <% if (announcements && announcements.length) { %>
          <% announcements.forEach(function(a){ %>
            <% let attachments = a.attachments;
               if (attachments && typeof attachments === 'string') {
                 try { attachments = JSON.parse(attachments); } catch (e) { attachments = [attachments]; }
               }
            %>
            <div class="card ann-card mb-3">
              <div class="card-body">
                <div class="d-flex justify-content-between align-items-start">
                  <div>
                    <h5 class="ann-card-title"><%= a.title %></h5>
                    <div class="ann-card-subtitle"><%= a.author ? a.author.name : 'System' %></div>
                  </div>
                  <div class="text-muted small"><%= new Date(a.createdAt).toLocaleString() %></div>
                </div>
                <div class="ann-card-body mt-2"><%= a.body %></div>
                <% if (attachments && attachments.length) { %>
                  <div class="ann-attachments mt-3">
                    <% attachments.forEach(function(att){ %>
                      <a href="<%= att %>" target="_blank"><i class="fa-solid fa-file"></i> <%= att.split('/').pop() %></a>
                    <% }) %>
                  </div>
                <% } %>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="alert alert-info">No announcements yet.</div>
        <% } %>
      </div>
    </div>

    <div class="col-lg-3">
      <div class="card mb-3" style="border-radius:12px; border:1px solid rgba(0,0,0,.04); box-shadow:0 6px 18px rgba(2,6,23,0.04);">
        <div class="card-body">
          <h6 class="mb-2">About</h6>
          <p class="small text-muted">Announcements are posted by HR and Admin and are visible to all roles. Use the button above to send a new announcement.</p>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('partials/footer') %>
