<%- include('../partials/header') -%>
<%- include('../partials/navbar') -%>
<%- include('./_admin_nav') -%>

<section class="admin-page">
  <h2>Password Reset Tokens</h2>
  <p class="text-muted">Recent password reset requests</p>

  <% if (!tokens || tokens.length === 0) { %>
    <div class="alert alert-info">No password reset tokens found.</div>
  <% } else { %>
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>User</th>
          <th>Expires</th>
          <th>Used</th>
        </tr>
      </thead>
      <tbody>
        <% tokens.forEach(function(t){ %>
          <tr>
            <td><%= t.id %></td>
            <td><%= t.user ? t.user.name : (t.userId || '') %></td>
            <td><%= t.expiresAt ? new Date(t.expiresAt).toISOString().slice(0,19).replace('T',' ') : '' %></td>
            <td><%= t.used ? 'Yes' : 'No' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>

<%- include('../partials/footer') -%>
