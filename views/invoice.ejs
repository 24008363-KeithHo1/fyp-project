<%- include('partials/header', { title: 'Invoices' }) %>
<%- include('partials/navbar') %>

<main>
  <h2>Invoices</h2>
  <form id="create">
    <input placeholder="Customer name" id="customer"><br>
    <input placeholder="Amount" id="amount"><br>
    <input type="date" id="due"><br>
    <button>Create</button>
  </form>
  <ul id="list"></ul>
</main>

<script>
const token = localStorage.getItem('token');
if (!token) location = '/login';
async function load(){
  const res = await fetch('/api/invoices',{headers:{authorization:'Bearer '+token}});
  const items = await res.json();
  const ul = document.getElementById('list'); ul.innerHTML='';
  items.forEach(i=>{ const li=document.createElement('li'); li.innerHTML=`${i.number} - ${i.customer_name} - ${i.amount} - <a href='/api/invoices/${i.id}/pdf' target='_blank'>PDF</a>`; ul.appendChild(li); });
}
document.getElementById('create').addEventListener('submit', async e=>{
  e.preventDefault();
  await fetch('/api/invoices',{method:'POST',headers:{authorization:'Bearer '+token,'content-type':'application/json'},body:JSON.stringify({customer_name:document.getElementById('customer').value,amount:document.getElementById('amount').value,due_date:document.getElementById('due').value})});
  load();
});
load();
</script>

<%- include('partials/footer') %>
