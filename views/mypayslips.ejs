<%- include('partials/header', { title: 'My Payslips' }) %>
<%- include('partials/navbar') %>
  <script>const token = localStorage.getItem('token'); if (!token) location = '/login';</script>

  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title">My Payslips</h5>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>Period</th>
              <th>Bank Number</th>
              <th class="text-end">Gross</th>
              <th class="text-end">Net</th>
              <th>Payroll Status</th>
              <th>Salary Release</th>
              <th class="text-center">Download</th>
            </tr>
          </thead>
          <tbody>
            <% payrolls.forEach(p => { %>
              <tr>
                <td><%= p.period %></td>
                <td><%= p.bank_number || '-' %></td>
                <td class="text-end">$<%= p.gross %></td>
                <td class="text-end">$<%= p.net %></td>
                <td>
                  <% const status = p.payment_status || 'Pending'; %>
                  <% if (status === 'Paid') { %>
                    <span class="badge bg-success">Paid</span>
                  <% } else if (status === 'Approved') { %>
                    <span class="badge bg-primary">Approved</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Pending</span>
                  <% } %>
                </td>
                <td>
                  <% if (status === 'Paid') { %>
                    <div class="fw-semibold text-success">Salary Released</div>
                    <small class="text-muted d-block">Release Date: <%= p.paid_at ? new Date(p.paid_at).toLocaleString() : '-' %></small>
                    <small class="text-muted d-block">Payment Method: <%= p.payment_method || 'Simulated Bank Transfer' %></small>
                    <% const release = p.data && p.data.salaryRelease; %>
                    <% if (release) { %>
                      <small class="text-muted d-block">Test Bank Account: <%= release.testBankAccountNumber || '-' %></small>
                      <small class="text-muted d-block">Bank Reference: <%= release.testBankReference || '-' %></small>
                    <% } %>
                  <% } else { %>
                    <span class="text-muted">Not released yet</span>
                  <% } %>
                </td>
                <td class="text-center">
                  <a href="/api/payroll/<%= p.id %>/payslip" target="_blank" class="btn btn-sm btn-outline-primary">PDF</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
