<%- include('../partials/header', { title: 'Request' }) %>
<%- include('../partials/navbar') %>

<div class="container mt-4">
  <div class="content-card requests-card">
    <h2><%= request.title %></h2>
    <p><strong>From:</strong> <%= request.senderName || request.senderId %></p>
    <p><strong>Recipient:</strong> <%= request.recipient %></p>
    <p><strong>Status:</strong> <%= request.status %></p>
    <p><strong>Message:</strong></p>
    <div class="request-message p-3 mb-3"><pre><%= request.message %></pre></div>

  <% if (request.data && Array.isArray(request.data.attachments) && request.data.attachments.length) { %>
    <div>
      <h5>Attachments</h5>
      <% request.data.attachments.forEach(a => { %>
        <div><a href="<%= a.path %>" target="_blank"><%= a.originalname %></a></div>
      <% }) %>
    </div>
  <% } %>

    <div class="mt-3">
      <a href="/requests" class="btn btn-link">Back</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
