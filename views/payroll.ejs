<%- include('partials/header', { title: 'Payroll' }) %>
<%- include('partials/navbar') %>
  <script>const token = localStorage.getItem('token'); if (!token) location = '/login';</script>

  <div class="row mb-4 payroll-page-hero">
    <div class="col-md-8">
      <h2 class="mb-0">Payroll Management</h2>
      <p class="text-muted mb-0">Manage employee payroll records and generate payslips</p>
    </div>
    
  </div>

  <div class="row mb-4 payroll-summary-row">
    <div class="col-md-6">
      <div class="card shadow-sm h-100 payroll-upload-card">
        <div class="card-body">
          <div class="payroll-panel-heading">
            <div>
              <h5 class="card-title"><span class="payroll-upload-heading-icon"><i class="fas fa-file-arrow-up" aria-hidden="true"></i></span> Upload Payroll Data</h5>
              <p class="text-muted mb-0">Import payroll records from a prepared file.</p>
            </div>
            <span class="payroll-upload-format">CSV / XLSX</span>
          </div>
          <p class="payroll-upload-instructions">
            Required fields: ID, name, email, bank number, period, gross, deductions, and net.
          </p>
          <div id="payrollImportState" class="alert alert-secondary py-2" role="status">
            Checking the active payroll period…
          </div>
          <form id="upload" enctype="multipart/form-data" class="payroll-upload-form">
            <input type="file" id="file" accept=".xlsx,.xls,.csv" required class="payroll-file-input">
            <label class="payroll-file-dropzone" for="file">
              <span class="payroll-file-icon"><i class="fas fa-cloud-arrow-up" aria-hidden="true"></i></span>
              <span class="payroll-file-copy">
                <strong>Select payroll file</strong>
                <span class="payroll-selected-file" id="selectedFileName" aria-live="polite">No file selected</span>
              </span>
              <span class="payroll-file-browse">Browse</span>
            </label>
            <button type="submit" id="importPayrollButton" class="btn btn-primary payroll-upload-submit">
              <i class="fas fa-upload" aria-hidden="true"></i> Import Payroll
            </button>
          </form>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm h-100 payroll-quick-stats-card">
        <div class="card-body">
          <div class="payroll-panel-heading">
            <div>
              <h5 class="card-title"><i class="fas fa-chart-line text-info"></i> Quick Stats</h5>
              <p class="text-muted mb-0">Current payroll snapshot</p>
            </div>
          </div>
          <div class="payroll-stats-grid">
            <div class="payroll-stat-card payroll-stat-records">
              <span class="payroll-stat-icon"><i class="fas fa-users"></i></span>
              <span class="payroll-stat-label">Total Records</span>
              <strong class="payroll-stat-value" id="totalRecords">0</strong>
              <span class="payroll-stat-detail">Payroll entries</span>
            </div>
            <div class="payroll-stat-card payroll-stat-gross">
              <span class="payroll-stat-icon"><i class="fas fa-coins"></i></span>
              <span class="payroll-stat-label">Total Gross</span>
              <strong class="payroll-stat-value" id="totalGross">$0</strong>
              <span class="payroll-stat-detail">Before deductions</span>
            </div>
            <div class="payroll-stat-card payroll-stat-net">
              <span class="payroll-stat-icon"><i class="fas fa-wallet"></i></span>
              <span class="payroll-stat-label">Total Net</span>
              <strong class="payroll-stat-value" id="totalNet">$0</strong>
              <span class="payroll-stat-detail">Payable amount</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm payroll-records-card">
    <div class="card-body p-0">
      <div class="card-header bg-white border-bottom-0 payroll-records-header">
        <div>
          <h5 class="card-title mb-1">
            <i class="fas fa-list text-secondary"></i> Payroll Records
          </h5>
          <p class="text-muted mb-0">Review compensation, release status, and payroll actions.</p>
        </div>
      </div>
      <div class="table-responsive payroll-table-wrap">
        <table class="table table-hover align-middle mb-0 payroll-table" id="payrollTable">
          <thead class="table-light">
            <tr>
              <th class="border-0">Employee</th>
              <th class="border-0">Pay Period</th>
              <th class="border-0">Amount</th>
              <th class="border-0">Payment</th>
              <th class="border-0">Activity</th>
              <th class="text-end border-0">Actions</th>
            </tr>
          </thead>
          <tbody id="list"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Edit Payroll Modal -->
  <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg payroll-edit-dialog">
      <div class="modal-content payroll-edit-modal">
        <div class="modal-header payroll-edit-modal-header">
          <div class="payroll-edit-modal-title">
            <span class="payroll-edit-modal-icon"><i class="fas fa-pen-to-square" aria-hidden="true"></i></span>
            <div>
              <h5 class="modal-title" id="editModalLabel">Update Payroll</h5>
              <p>Review employee details and compensation before saving.</p>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="editForm" class="payroll-edit-form">
            <input type="hidden" id="editId">
            <section class="payroll-edit-section">
              <div class="payroll-edit-section-heading"><i class="fas fa-user" aria-hidden="true"></i> Employee Details</div>
              <div class="row g-3">
                <div class="col-md-6">
                  <label for="editEmployeeName" class="form-label">Employee Name</label>
                  <input type="text" class="form-control" id="editEmployeeName" required>
                </div>
                <div class="col-md-6">
                  <label for="editEmployeeEmail" class="form-label">Employee Email</label>
                  <input type="email" class="form-control" id="editEmployeeEmail" required>
                </div>
                <div class="col-md-6">
                  <label for="editBankNumber" class="form-label">Bank Number</label>
                  <input type="text" class="form-control" id="editBankNumber">
                </div>
                <div class="col-md-6">
                  <label for="editPeriod" class="form-label">Period</label>
                  <input type="text" class="form-control" id="editPeriod" required>
                </div>
              </div>
            </section>
            <section class="payroll-edit-section">
              <div class="payroll-edit-section-heading"><i class="fas fa-coins" aria-hidden="true"></i> Amount</div>
              <div class="row g-3">
                <div class="col-md-4">
                  <label for="editGross" class="form-label">Gross Amount</label>
                  <input type="number" class="form-control" id="editGross" step="0.01" min="0" required>
                </div>
                <div class="col-md-4">
                  <label for="editDeductions" class="form-label">Deductions</label>
                  <input type="number" class="form-control" id="editDeductions" step="0.01" min="0" required>
                </div>
                <div class="col-md-4">
                  <label for="editNet" class="form-label">Net Amount</label>
                  <input type="number" class="form-control" id="editNet" step="0.01" min="0" required>
                </div>
              </div>
            </section>
          </form>
        </div>
        <div class="modal-footer payroll-edit-modal-footer">
          <button type="button" class="btn btn-secondary payroll-edit-cancel" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary payroll-edit-save" id="saveEdit"><i class="fas fa-check" aria-hidden="true"></i> Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <script>
  const payrollFileInput = document.getElementById('file');
  const selectedFileName = document.getElementById('selectedFileName');
  const importPayrollButton = document.getElementById('importPayrollButton');
  const payrollImportState = document.getElementById('payrollImportState');
  let payrollImportAllowed = false;

  function payrollPeriodGuidance(period) {
    if (!period) return 'Create an active payroll period before importing payroll data.';
    if (period.status === 'PendingApproval') return 'Payroll has been submitted to Finance. Importing is locked until Finance requests changes.';
    if (period.status === 'Approved') return 'Payroll is approved. Release every salary, close this period, and then create the next payroll schedule.';
    if (period.status === 'Released') return 'All salaries are released. Close this period before creating the next payroll schedule.';
    if (period.status === 'Closed') return 'This payroll period is closed. Create a new active period before importing.';
    return `Payroll importing is unavailable while this period is ${period.status}.`;
  }

  async function loadActivePeriod() {
    try {
      const res = await fetch('/api/payroll/active-period', {
        headers: { authorization: 'Bearer ' + token }
      });
      const data = await readResponse(res);
      if (!res.ok) throw new Error(data.error || 'Unable to load the active payroll period');

      payrollImportAllowed = Boolean(data.canImport);
      payrollFileInput.disabled = !payrollImportAllowed;
      importPayrollButton.disabled = !payrollImportAllowed;

      const period = data.period;
      const periodLabel = period ? `${period.name} (${period.status})` : 'No active payroll period';
      if (payrollImportAllowed) {
        payrollImportState.className = 'alert alert-success py-2';
        payrollImportState.textContent = `${periodLabel}: payroll importing is open.`;
      } else {
        payrollImportState.className = 'alert alert-warning py-2';
        payrollImportState.textContent = data.roleCanImport
          ? `${periodLabel}: ${payrollPeriodGuidance(period)}`
          : `${periodLabel}: only HR or Admin can import payroll files. Finance can review, approve and release payroll.`;
      }
    } catch (err) {
      payrollImportAllowed = false;
      payrollFileInput.disabled = true;
      importPayrollButton.disabled = true;
      payrollImportState.className = 'alert alert-danger py-2';
      payrollImportState.textContent = err.message;
    }
  }

  payrollFileInput.addEventListener('change', () => {
    const selectedFile = payrollFileInput.files[0];
    selectedFileName.textContent = selectedFile ? selectedFile.name : 'No file selected';
  });

  document.getElementById('upload').addEventListener('submit', async e => {
    e.preventDefault();
    if (!payrollImportAllowed) {
      await loadActivePeriod();
      return;
    }
    const file = document.getElementById('file').files[0];
    if (!file) {
      alert('Please select a file');
      return;
    }
    const fd = new FormData(); fd.append('file', file);
    try {
      const res = await fetch('/api/payroll/upload', { method: 'POST', headers: { authorization: 'Bearer ' + token }, body: fd });
      const data = await res.json();
      
      if (!res.ok) {
        alert(`Error: ${data.error}\n${data.details ? data.details.join('\n') : ''}`);
        return;
      }
      
      let msg = `✓ Imported ${data.imported || 0} new records, updated ${data.updated || 0} existing records`;
      if (data.warnings) {
        msg += `\n⚠ ${data.warnings}`;
      }
      alert(msg);
      payrollFileInput.value = '';
      selectedFileName.textContent = 'No file selected';
      await loadActivePeriod();
      load();
    } catch (err) { alert('Upload failed: ' + err.message); }
  });

  function formatDate(dateString) {
    if (!dateString) return '-';
    return new Date(dateString).toLocaleString();
  }

  function formatDeductionValue(value) {
    if (value === null || value === undefined) return 0;
    if (typeof value === 'object') {
      const amount = value.amount ?? Object.values(value)[0] ?? 0;
      return parseFloat(amount) || 0;
    }
    return parseFloat(value) || 0;
  }

  async function readResponse(res) {
    const text = await res.text();
    try {
      return text ? JSON.parse(text) : {};
    } catch (err) {
      return {
        error: text && text.trim().startsWith('<!DOCTYPE')
          ? `Server returned an HTML page instead of JSON (HTTP ${res.status}). Restart the server and try again.`
          : text
      };
    }
  }

  async function load() {
    try {
      const res = await fetch('/api/payroll', { headers: { authorization: 'Bearer ' + token } });
      if (!res.ok) return;
      const items = await res.json();
      const tbody = document.getElementById('list'); tbody.innerHTML = '';
      
      if (!items || items.length === 0) { 
        tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No payroll records found</td></tr>';
        updateStats(0, 0, 0);
        return; 
      }
      
      let totalGross = 0;
      let totalNet = 0;
      
      items.forEach(p => {
        totalGross += parseFloat(p.gross || 0);
        totalNet += parseFloat(p.net || 0);
        const deductionValue = formatDeductionValue(p.deductions);
        const status = p.payment_status || 'Pending';
        const actionHtml = payrollActionHtml(p);
        
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="payroll-employee-cell" data-label="Employee">
            <div class="payroll-employee-name"><span>${p.name || ''}</span><span class="payroll-record-id">#${p.id}</span></div>
            <small class="text-muted d-block">${p.email || ''}</small>
            <small class="payroll-bank-number"><i class="fas fa-building-columns" aria-hidden="true"></i> ${p.bank_number || '-'}</small>
          </td>
          <td class="payroll-period-cell" data-label="Pay period"><span class="payroll-period-pill">${p.period || ''}</span></td>
          <td class="payroll-amounts-cell" data-label="Compensation">
            <div class="payroll-money-row"><span>Gross</span><strong>${parseFloat(p.gross||0).toFixed(2)}</strong></div>
            <div class="payroll-money-row payroll-deduction-row"><span>Deductions</span><strong>${deductionValue.toFixed(2)}</strong></div>
            <div class="payroll-money-row payroll-net-row"><span>Net</span><strong>${parseFloat(p.net||0).toFixed(2)}</strong></div>
          </td>
          <td class="payroll-payment-cell" data-label="Payment">
            <div class="payroll-payment-status">${paymentStatusBadge(status)}</div>
            <small class="payroll-payment-meta"><span>Released</span>${p.paid_at ? formatDate(p.paid_at) : '-'}</small>
            <small class="payroll-payment-meta"><span>Method</span>${paymentMethodDetails(p)}</small>
          </td>
          <td class="payroll-activity-cell" data-label="Activity">
            <small class="payroll-activity-meta"><span>Created</span>${formatDate(p.createdAt)}</small>
            <small class="payroll-activity-meta"><span>Updated</span>${formatDate(p.updatedAt)}</small>
          </td>
          <td class="payroll-actions-cell" data-label="Actions">
            <div class="payroll-record-actions">
              <button class="payroll-action-btn payroll-action-edit" type="button" onclick="editPayroll(${p.id})" title="Edit record">
                <i class="fas fa-edit" aria-hidden="true"></i><span>Edit</span>
              </button>
              <a class="payroll-action-btn payroll-action-payslip" href="/api/payroll/${p.id}/payslip" target="_blank" title="Open payslip PDF">
                <i class="fas fa-file-pdf" aria-hidden="true"></i><span>Payslip</span>
              </a>
              <button class="payroll-action-btn payroll-action-delete" type="button" onclick="deletePayroll(${p.id})" title="Delete record">
                <i class="fas fa-trash" aria-hidden="true"></i><span>Delete</span>
              </button>
              ${actionHtml}
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
      
      updateStats(items.length, totalGross, totalNet);
    } catch (err) { console.error('Load error:', err); }
  }

  function updateStats(records, gross, net) {
    document.getElementById('totalRecords').textContent = records;
    document.getElementById('totalGross').textContent = '$' + gross.toFixed(2);
    document.getElementById('totalNet').textContent = '$' + net.toFixed(2);
  }

  function paymentStatusBadge(status) {
    if (status === 'Paid') return '<span class="badge bg-success">Paid</span>';
    if (status === 'Approved') return '<span class="badge payroll-status-approved">Approved</span>';
    return '<span class="badge bg-warning text-dark">Pending</span>';
  }

  function payrollActionHtml(p) {
    const status = p.payment_status || 'Pending';
    if (status === 'Paid') {
      return '<span class="payroll-action-state"><i class="fas fa-circle-check" aria-hidden="true"></i><span>Released</span></span>';
    }
    if (status === 'Approved') {
      return `<button class="payroll-action-btn payroll-action-release" type="button" onclick="releaseSalary(${p.id}, this)"><i class="fas fa-money-check-dollar" aria-hidden="true"></i><span>Release</span></button>`;
    }
    return `<button class="payroll-action-btn payroll-action-approve" type="button" onclick="approvePayroll(${p.id}, this)"><i class="fas fa-circle-check" aria-hidden="true"></i><span>Approve</span></button>`;
  }

  function paymentMethodDetails(p) {
    const release = p.data && p.data.salaryRelease;
    if (!p.payment_method) return '-';
    if (!release) return p.payment_method;
    return `${p.payment_method}<br><span class="text-muted">To: ${release.testBankAccountNumber || '-'}</span>`;
  }

  async function postPayrollAction(id, action, button) {
    const originalText = button ? button.textContent : '';
    try {
      if (button) {
        button.disabled = true;
        button.textContent = action === 'approve' ? 'Approving...' : 'Releasing...';
      }
      const res = await fetch(`/api/payroll/${id}/${action}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          authorization: 'Bearer ' + token
        }
      });
      const data = await res.json();
      if (!res.ok) return alert(data.error || 'Payroll action failed');
      alert(data.message || 'Payroll updated successfully');
      await load();
    } catch (err) {
      alert('Payroll action failed: ' + err.message);
    } finally {
      if (button) {
        button.disabled = false;
        button.textContent = originalText;
      }
    }
  }

  function approvePayroll(id, button) {
    postPayrollAction(id, 'approve', button);
  }

  function releaseSalary(id, button) {
    postPayrollAction(id, 'release', button);
  }

  async function editPayroll(id) {
    try {
      const res = await fetch(`/api/payroll/${id}`, { headers: { authorization: 'Bearer ' + token } });
      if (!res.ok) return alert('Failed to load payroll data');
      
      const payroll = await res.json();
      
      const deductionsValue = formatDeductionValue(payroll.deductions);
      // Populate modal
      document.getElementById('editId').value = payroll.id;
      document.getElementById('editEmployeeName').value = payroll.name || '';
      document.getElementById('editEmployeeEmail').value = payroll.email || '';
      document.getElementById('editBankNumber').value = payroll.bank_number || '';
      document.getElementById('editPeriod').value = payroll.period || '';
      document.getElementById('editGross').value = payroll.gross || 0;
      document.getElementById('editDeductions').value = deductionsValue;
      document.getElementById('editNet').value = payroll.net || 0;
      
      // Show modal
      const modal = new bootstrap.Modal(document.getElementById('editModal'));
      modal.show();
    } catch (err) {
      
    }
  }

  async function deletePayroll(id) {
    if (!confirm(`Delete payroll record #${id}? This cannot be undone.`)) return;

    try {
      const res = await fetch(`/api/payroll/${id}`, {
        method: 'DELETE',
        headers: { authorization: 'Bearer ' + token }
      });
      const result = await readResponse(res);

      if (!res.ok) {
        return alert('Delete failed: ' + (result.error || 'Unknown error'));
      }

      alert('Payroll record deleted successfully!');
      load();
    } catch (err) {
      alert('Delete failed: ' + err.message);
    }
  }

  // Save edit
  document.getElementById('saveEdit').addEventListener('click', async () => {
    const id = document.getElementById('editId').value;
    const data = {
      name: document.getElementById('editEmployeeName').value.trim(),
      email: document.getElementById('editEmployeeEmail').value.trim(),
      bank_number: document.getElementById('editBankNumber').value.trim(),
      period: document.getElementById('editPeriod').value.trim(),
      gross: parseFloat(document.getElementById('editGross').value) || 0,
      deductions: parseFloat(document.getElementById('editDeductions').value) || 0,
      net: parseFloat(document.getElementById('editNet').value) || 0
    };

    try {
      const res = await fetch(`/api/payroll/${id}`, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          authorization: 'Bearer ' + token
        },
        body: JSON.stringify(data)
      });

      if (!res.ok) {
        const error = await res.json();
        return alert('Update failed: ' + (error.error || 'Unknown error'));
      }

      alert('Payroll record updated successfully!');
      bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
      load(); // Refresh table
    } catch (err) {
      
      
    }
  });

  loadActivePeriod();
  load();
  </script>

 

<%- include('partials/footer') %>
