<%- include('../partials/header', { title }) %>
<%- include('../partials/navbar') %>

<div class="container py-4 payroll-automation-page">
  <div class="automation-hero">
    <div>
      <span class="automation-eyebrow"><i class="fa-solid fa-clock-rotate-left"></i> Delivery activity</span>
      <h2>Payroll Reminder History</h2>
      <p>Review the latest 200 reminder delivery records and troubleshoot unsuccessful attempts.</p>
    </div>
    <a class="automation-btn automation-btn-secondary" href="<%= automationBasePath %>"><i class="fa-solid fa-arrow-left"></i> Back to Settings</a>
  </div>

  <% if (bounceSyncError) { %>
    <div class="alert alert-warning"><%= bounceSyncError %></div>
  <% } %>

  <form method="get" action="<%= automationBasePath %>/history" class="automation-card automation-filter-card">
    <div class="automation-filter-grid">
      <div class="automation-field">
        <label class="form-label" for="reminderKey">Reminder type</label>
        <select class="form-select" id="reminderKey" name="reminderKey">
          <option value="">All reminder types</option>
          <option value="payrollUploadDeadline" <%= filters.reminderKey === 'payrollUploadDeadline' ? 'selected' : '' %>>Payroll upload</option>
          <option value="financeApprovalDeadline" <%= filters.reminderKey === 'financeApprovalDeadline' ? 'selected' : '' %>>Finance approval</option>
          <option value="salaryReleaseDate" <%= filters.reminderKey === 'salaryReleaseDate' ? 'selected' : '' %>>Salary release</option>
        </select>
      </div>
      <div class="automation-field">
        <label class="form-label" for="status">Delivery status</label>
        <select class="form-select" id="status" name="status">
          <option value="">All statuses</option>
          <option value="sent" <%= filters.status === 'sent' ? 'selected' : '' %>>Sent</option>
          <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
          <option value="skipped" <%= filters.status === 'skipped' ? 'selected' : '' %>>Not sent</option>
        </select>
      </div>
      <div class="automation-filter-actions">
        <button class="automation-btn automation-btn-primary" type="submit"><i class="fa-solid fa-filter"></i> Apply Filters</button>
        <a class="automation-btn automation-btn-ghost" href="<%= automationBasePath %>/history">Clear</a>
      </div>
    </div>
  </form>

  <div class="automation-card automation-table-card">
    <div class="table-responsive">
      <table class="table table-striped table-hover mb-0 align-middle">
        <thead>
          <tr>
            <th>Reminder</th>
            <th>Payroll period</th>
            <th>Deadline</th>
            <th>Recipient</th>
            <th>Status</th>
            <th>Source</th>
            <th>Last attempt</th>
            <th>Details</th>
          </tr>
        </thead>
        <tbody>
          <% if (!deliveries.length) { %>
            <tr><td colspan="8"><div class="automation-empty"><i class="fa-solid fa-inbox"></i><p>No reminder deliveries found.</p><span>Run the scheduler to create the first delivery record.</span></div></td></tr>
          <% } %>
          <% deliveries.forEach((delivery) => { %>
            <% const labels = {
              payrollUploadDeadline: 'Payroll upload',
              financeApprovalDeadline: 'Finance approval',
              salaryReleaseDate: 'Salary release'
            }; %>
            <% const statusLabels = {
              sent: 'Sent',
              failed: 'Failed',
              skipped: 'Not sent'
            }; %>
            <tr>
              <td><%= labels[delivery.reminderKey] || delivery.reminderKey %></td>
              <td><%= delivery.payrollPeriodId ? (periodNames[delivery.payrollPeriodId] || `Period #${delivery.payrollPeriodId}`) : 'Legacy' %></td>
              <td><%= delivery.deadline %></td>
              <td><%= delivery.recipient %></td>
              <td>
                <span class="badge <%= delivery.status === 'sent' ? 'bg-success' : delivery.status === 'failed' ? 'bg-danger' : 'bg-warning text-dark' %>">
                  <%= statusLabels[delivery.status] || delivery.status %>
                </span>
              </td>
              <td><%= delivery.source %></td>
              <td><%= new Date(delivery.updatedAt).toLocaleString('en-SG', { timeZone: 'Asia/Singapore' }) %></td>
              <td class="text-danger"><%= delivery.error || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
