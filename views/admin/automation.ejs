<%- include('../partials/header', { title: 'Automation Settings' }) %>
<%- include('../partials/navbar') %>
<% const isHrAutomation = true; %>
<% if (isHrAutomation) { %>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --hra-bg: #f0fdf4;
      --hra-surface: #ffffff;
      --hra-border: #d1fae5;
      --hra-border-strong: #bbf7d0;
      --hra-text: #0f1c14;
      --hra-muted: #6b8c78;
      --hra-green: #15803d;
      --hra-green-dark: #065f32;
      --hra-blue: #2563eb;
      --hra-amber: #d97706;
      --hra-shadow-sm: 0 1px 3px rgba(6, 78, 39, .08), 0 1px 2px rgba(6, 78, 39, .04);
      --hra-shadow-md: 0 4px 16px rgba(6, 78, 39, .1), 0 2px 6px rgba(6, 78, 39, .06);
      --hra-radius: 16px;
      --hra-radius-sm: 10px;
    }

    body:has(.hr-automation-workspace) {
      background: var(--hra-bg) !important;
      color: var(--hra-text);
      font-family: 'Sora', sans-serif;
    }

    .hr-automation-nav {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .hr-automation-nav a {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .42rem .7rem;
      border: 1px solid transparent;
      border-radius: 999px;
      color: var(--hra-muted);
      font-size: .76rem;
      font-weight: 600;
      text-decoration: none;
    }

    .hr-automation-nav a:hover {
      background: #dcfce7;
      color: var(--hra-green);
    }

    .hr-automation-nav a[aria-current='page'] {
      border-color: var(--hra-border-strong);
      background: var(--hra-surface);
      box-shadow: var(--hra-shadow-sm);
      color: var(--hra-green);
    }

    .hr-automation-workspace {
      max-width: 1280px;
      margin: 0 auto;
      padding: 2rem 1.5rem 4rem;
      animation: hr-automation-in .4s cubic-bezier(.22, .8, .36, 1) both;
    }

    @keyframes hr-automation-in {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .hr-automation-workspace .automation-hero {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 1rem;
      margin: 0 0 1.5rem;
      padding: 0 0 1.25rem;
      border-bottom: 1px solid var(--hra-border);
    }

    .hr-automation-workspace .automation-eyebrow {
      display: block;
      margin: 0 0 .3rem;
      color: var(--hra-green);
      font-size: .75rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
    }

    .hr-automation-workspace .automation-hero h2 {
      margin: 0;
      color: var(--hra-text);
      font-size: 1.75rem;
      font-weight: 700;
      letter-spacing: 0;
      line-height: 1.2;
    }

    .hr-automation-workspace .automation-hero p {
      max-width: 62ch;
      margin: .35rem 0 0;
      color: var(--hra-muted);
      font-size: .875rem;
      line-height: 1.5;
    }

    .hr-automation-workspace .alert {
      margin-bottom: 1rem;
      border-radius: var(--hra-radius-sm);
      font-size: .84rem;
      font-weight: 500;
    }

    .hr-automation-workspace .automation-card {
      position: relative;
      overflow: hidden;
      margin-bottom: 1rem;
      padding: 1.3rem;
      border: 1px solid var(--hra-border);
      border-radius: var(--hra-radius);
      background: var(--hra-surface);
      box-shadow: var(--hra-shadow-sm);
    }

    .hr-automation-workspace .automation-card::before {
      position: absolute;
      top: 0;
      right: 0;
      left: 0;
      height: 3px;
      content: '';
      background: linear-gradient(90deg, var(--hra-green), #4ade80);
    }

    .hr-automation-workspace .automation-run-card::before { background: linear-gradient(90deg, var(--hra-blue), #60a5fa); }
    .hr-automation-workspace .automation-preview-card::before { background: linear-gradient(90deg, var(--hra-amber), #fbbf24); }

    .hr-automation-workspace .automation-card-heading {
      align-items: flex-start;
      gap: .75rem;
      margin-bottom: 1.15rem;
    }

    .hr-automation-workspace .automation-icon {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: 9px;
      background: #dcfce7;
      color: var(--hra-green);
      font-size: .82rem;
    }

    .hr-automation-workspace .automation-run-card .automation-icon { background: #dbeafe; color: #1d4ed8; }
    .hr-automation-workspace .automation-preview-card .automation-icon { background: #fef3c7; color: #b45309; }

    .hr-automation-workspace .automation-card-heading h3 {
      margin: 0 0 .18rem;
      color: var(--hra-text);
      font-size: .98rem;
      font-weight: 700;
    }

    .hr-automation-workspace .automation-card-heading p,
    .hr-automation-workspace .automation-field small {
      color: var(--hra-muted);
      font-size: .8rem;
      line-height: 1.45;
    }

    .hr-automation-workspace .automation-card-heading > .badge {
      padding: .32rem .55rem;
      border-radius: 999px;
      background: #dbeafe !important;
      color: #1d4ed8;
      font-family: 'DM Mono', monospace;
      font-size: .7rem;
      font-weight: 600;
    }

    .hr-automation-workspace .automation-form-grid {
      gap: .85rem 1rem;
      margin-bottom: 1.1rem;
    }

    .hr-automation-workspace .automation-field .form-label {
      margin-bottom: .2rem;
      color: var(--hra-muted);
      font-size: .78rem;
      font-weight: 600;
    }

    .hr-automation-workspace .automation-field .form-control {
      min-height: 42px;
      margin: 0;
      padding: .58rem .72rem;
      border: 1px solid var(--hra-border);
      border-radius: var(--hra-radius-sm);
      background: #f8fdf9;
      box-shadow: none;
      color: var(--hra-text);
      font-size: .86rem;
    }

    .hr-automation-workspace .automation-field .form-control:focus {
      border-color: var(--hra-green);
      box-shadow: 0 0 0 .15rem rgba(22, 163, 74, .12);
    }

    .hr-automation-workspace .automation-field .form-control[readonly] {
      background: #f1f5f9;
      color: #64748b;
    }

    .hr-automation-workspace .automation-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .45rem;
      min-height: 38px;
      padding: .5rem .85rem;
      border: 1px solid transparent;
      border-radius: 999px;
      box-shadow: none;
      font-size: .8rem;
      font-weight: 600;
    }

    .hr-automation-workspace .automation-btn-primary {
      background: var(--hra-green-dark) !important;
      color: #fff !important;
    }

    .hr-automation-workspace .automation-btn-primary:hover { background: var(--hra-green) !important; }

    .hr-automation-workspace .automation-btn-secondary {
      border-color: var(--hra-border-strong) !important;
      background: var(--hra-surface) !important;
      color: var(--hra-green) !important;
    }

    .hr-automation-workspace .automation-btn-secondary:hover {
      border-color: var(--hra-green) !important;
      background: #f0fdf4 !important;
    }

    .hr-automation-workspace .automation-btn:disabled {
      cursor: not-allowed;
      opacity: .55;
      transform: none;
    }

    .hr-automation-workspace .automation-run-card {
      align-items: center;
      min-height: 104px;
    }

    .hr-automation-workspace .automation-run-card .automation-card-heading { margin: 0; }

    .hr-automation-workspace .automation-preview-card ul {
      display: grid;
      gap: .5rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .hr-automation-workspace .automation-preview-card li {
      padding: .7rem .8rem;
      border: 1px solid var(--hra-border);
      border-radius: var(--hra-radius-sm);
      background: #f8fdf9;
      color: var(--hra-muted);
      font-size: .82rem;
    }

    .hr-automation-workspace .automation-preview-card li strong { color: var(--hra-text); }

    .hr-automation-workspace .automation-empty {
      min-height: 112px;
      border: 1px dashed var(--hra-border-strong);
      border-radius: var(--hra-radius-sm);
      background: #f8fdf9;
    }

    .hr-automation-workspace .automation-empty i { color: var(--hra-amber); }
    .hr-automation-workspace .automation-empty p { color: var(--hra-muted); font-size: .84rem; }

    @media (max-width: 720px) {
      .hr-automation-nav { padding: 0 1rem; }
      .hr-automation-workspace { padding: 1.25rem 1rem 3rem; }
      .hr-automation-workspace .automation-hero { align-items: flex-start; }
      .hr-automation-workspace .automation-hero .automation-btn { width: 100%; }
      .hr-automation-workspace .automation-run-card { align-items: flex-start; }
      .hr-automation-workspace .automation-run-card .automation-btn { width: 100%; }
    }

    :root {
      --hra-bg: #f8fafc;
      --hra-surface: #ffffff;
      --hra-border: rgba(148, 163, 184, .18);
      --hra-border-strong: rgba(37, 99, 235, .28);
      --hra-text: #102033;
      --hra-muted: #64748b;
      --hra-green: #0b8f3e;
      --hra-green-dark: #087a34;
      --hra-blue: #2563eb;
      --hra-amber: #f59e0b;
      --hra-shadow-sm: 0 14px 30px rgba(15, 23, 42, .08);
      --hra-shadow-md: 0 22px 38px rgba(15, 23, 42, .16);
      --hra-radius: 8px;
      --hra-radius-sm: 8px;
    }

    body:has(.hr-automation-workspace) {
      background: linear-gradient(135deg, #f7faf8 0%, #e8f7ee 48%, #f8fbf9 100%) !important;
    }

    .hr-automation-nav {
      max-width: 1220px;
      padding: 0 1.1rem;
    }

    .hr-automation-nav a {
      min-height: 36px;
      border: 1px solid rgba(148, 163, 184, .22);
      border-radius: 999px;
      background: #ffffff;
      box-shadow: 0 8px 18px rgba(15, 23, 42, .06);
      color: var(--hra-text);
      font-weight: 700;
    }

    .hr-automation-nav a:hover {
      border-color: rgba(37, 99, 235, .28);
      background: #eff6ff;
      color: #1d4ed8;
      transform: translateY(-1px);
    }

    .hr-automation-nav a[aria-current='page'] {
      border-color: transparent;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      box-shadow: 0 14px 26px rgba(37, 99, 235, .22);
      color: #ffffff;
    }

    .hr-automation-workspace {
      max-width: 1220px;
      padding: 1.1rem;
      box-sizing: border-box;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, .98), rgba(248, 250, 252, .94)),
        linear-gradient(90deg, rgba(6, 182, 212, .12), rgba(124, 58, 237, .12));
    }

    .hr-automation-workspace .automation-hero {
      position: relative;
      overflow: hidden;
      margin-bottom: 1rem;
      padding: 1.35rem;
      border: 1px solid rgba(37, 99, 235, .18);
      border-radius: var(--hra-radius);
      background: linear-gradient(135deg, rgba(15, 23, 42, .94), rgba(37, 99, 235, .86) 46%, rgba(11, 143, 62, .82));
      box-shadow: 0 18px 38px rgba(15, 23, 42, .16);
    }

    .hr-automation-workspace .automation-hero::after {
      position: absolute;
      right: -56px;
      bottom: -84px;
      width: 260px;
      height: 150px;
      background: linear-gradient(135deg, rgba(255, 255, 255, .18), rgba(255, 255, 255, .03));
      content: '';
      transform: rotate(-18deg);
    }

    .hr-automation-workspace .automation-hero > * {
      position: relative;
      z-index: 1;
    }

    .hr-automation-workspace .automation-eyebrow {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: .25rem .58rem;
      border: 1px solid rgba(255, 255, 255, .28);
      border-radius: 999px;
      background: rgba(255, 255, 255, .12);
      color: #ffffff;
    }

    .hr-automation-workspace .automation-hero h2,
    .hr-automation-workspace .automation-hero p {
      color: #ffffff;
    }

    .hr-automation-workspace .automation-hero p { opacity: .88; }

    .hr-automation-workspace .automation-hero .automation-btn-secondary {
      border: 0 !important;
      border-radius: var(--hra-radius-sm);
      background: #ffffff !important;
      box-shadow: 0 14px 28px rgba(15, 23, 42, .24);
      color: #1d4ed8 !important;
    }

    .hr-automation-workspace .automation-hero .automation-btn-secondary:hover {
      background: #e0f2fe !important;
      color: #075985 !important;
      transform: translateY(-2px) scale(1.02);
    }

    .hr-automation-workspace .alert {
      border: 0;
      border-radius: var(--hra-radius-sm);
      box-shadow: 0 12px 24px rgba(15, 23, 42, .08);
    }

    .hr-automation-workspace .automation-card {
      border-color: rgba(148, 163, 184, .18);
      border-radius: var(--hra-radius);
      background: linear-gradient(180deg, rgba(255, 255, 255, .98), rgba(240, 249, 255, .78));
      box-shadow: var(--hra-shadow-sm);
      transition: border-color .16s ease, box-shadow .16s ease, transform .16s ease;
    }

    .hr-automation-workspace .automation-card:hover {
      border-color: rgba(6, 182, 212, .28);
      box-shadow: 0 20px 36px rgba(15, 23, 42, .12);
    }

    .hr-automation-workspace .automation-card::before {
      height: 3px;
      background: linear-gradient(90deg, #0f766e, #22c55e);
    }

    .hr-automation-workspace .automation-run-card::before { background: linear-gradient(90deg, #2563eb, #8b5cf6); }
    .hr-automation-workspace .automation-preview-card::before { background: linear-gradient(90deg, #c2410c, #f59e0b); }

    .hr-automation-workspace .automation-icon {
      border-radius: 8px;
      background: linear-gradient(135deg, #0f766e, #22c55e);
      color: #ffffff;
    }

    .hr-automation-workspace .automation-run-card .automation-icon { background: linear-gradient(135deg, #2563eb, #7c3aed); color: #ffffff; }
    .hr-automation-workspace .automation-preview-card .automation-icon { background: linear-gradient(135deg, #c2410c, #f59e0b); color: #ffffff; }

    .hr-automation-workspace .automation-card-heading > .badge {
      border: 0;
      background: linear-gradient(135deg, #2563eb, #7c3aed) !important;
      color: #ffffff;
      box-shadow: 0 6px 14px rgba(37, 99, 235, .18);
    }

    .hr-automation-workspace .automation-field .form-control {
      border-color: rgba(148, 163, 184, .28);
      border-radius: 8px;
      background: #ffffff;
    }

    .hr-automation-workspace .automation-field .form-control:focus {
      border-color: #06b6d4;
      box-shadow: 0 0 0 .2rem rgba(6, 182, 212, .16);
      transform: translateY(-1px);
    }

    .hr-automation-workspace .automation-field .form-control[readonly] {
      background: #f1f5f9;
    }

    .hr-automation-workspace .automation-btn-primary {
      border: 0;
      border-radius: 8px;
      background: linear-gradient(135deg, #0b8f3e, #84cc16) !important;
      box-shadow: 0 12px 24px rgba(11, 143, 62, .22);
    }

    .hr-automation-workspace .automation-btn-primary:hover {
      background: linear-gradient(135deg, #087a34, #65a30d) !important;
      transform: translateY(-2px);
    }

    .hr-automation-workspace .automation-run-card .automation-btn-secondary {
      border-color: rgba(37, 99, 235, .28) !important;
      border-radius: 8px;
      background: #ffffff !important;
      color: #1d4ed8 !important;
    }

    .hr-automation-workspace .automation-run-card .automation-btn-secondary:hover {
      border-color: transparent !important;
      background: linear-gradient(135deg, #2563eb, #7c3aed) !important;
      color: #ffffff !important;
    }

    .hr-automation-workspace .automation-preview-card li {
      border-color: rgba(148, 163, 184, .15);
      border-radius: 8px;
      background: #ffffff;
      box-shadow: 0 8px 18px rgba(15, 23, 42, .05);
    }

    .hr-automation-workspace .automation-empty {
      border-color: rgba(37, 99, 235, .26);
      border-radius: 8px;
      background: linear-gradient(135deg, #ffffff, #f0f9ff);
    }

    @media (max-width: 720px) {
      .hr-automation-nav { padding: 0 .85rem; }
      .hr-automation-workspace { padding: .85rem; }
      .hr-automation-workspace .automation-hero { padding: 1rem; }
    }
  </style>
<% } %>
<div class="container py-4 payroll-automation-page hr-automation-workspace">
  <div class="automation-hero">
    <div>
      <span class="automation-eyebrow"><i class="fa-solid fa-bell"></i> Payroll automation</span>
      <h2>Payroll Reminder Settings</h2>
      <p>Configure important payroll dates and notify the right teams at the right time.</p>
    </div>
    <a class="automation-btn automation-btn-secondary" href="<%= automationBasePath %>/history">
      <i class="fa-solid fa-clock-rotate-left"></i> View Delivery History
    </a>
  </div>

  <% if (message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <% const period = settings.activePeriod; %>
  <form method="post" action="<%= automationBasePath %>/period" class="automation-card automation-settings-card">
    <div class="automation-card-heading">
      <span class="automation-icon"><i class="fa-solid fa-calendar-check"></i></span>
      <div>
        <h3><%= period ? period.name : 'Create payroll period' %></h3>
        <p>All payroll milestones and reminder deliveries belong to this active period.</p>
      </div>
      <% if (period) { %><span class="badge bg-primary ms-auto"><%= period.status.replace(/([a-z])([A-Z])/g, '$1 $2') %></span><% } %>
    </div>
    <div class="automation-form-grid">
      <div class="automation-field automation-field-wide">
        <label class="form-label">Period name</label>
        <input class="form-control" name="name" required <%= period && period.status !== 'Draft' ? 'readonly' : '' %> value="<%= period ? period.name : '' %>" placeholder="e.g. July 2026 Payroll">
      </div>
      <div class="automation-field"><label class="form-label">Period start</label><input class="form-control" type="date" name="periodStart" required <%= period && period.status !== 'Draft' ? 'readonly' : '' %> value="<%= period ? period.periodStart : '' %>"></div>
      <div class="automation-field"><label class="form-label">Period end</label><input class="form-control" type="date" name="periodEnd" required <%= period && period.status !== 'Draft' ? 'readonly' : '' %> value="<%= period ? period.periodEnd : '' %>"></div>
      <div class="automation-field"><label class="form-label">Payroll upload deadline</label><input class="form-control" type="date" name="payrollUploadDeadline" required <%= period && period.status !== 'Draft' ? 'readonly' : '' %> value="<%= period ? period.payrollUploadDeadline : settings.payrollUploadDeadline %>"></div>
      <div class="automation-field"><label class="form-label">Finance approval deadline</label><input class="form-control" type="date" name="financeApprovalDeadline" required <%= period && period.status !== 'Draft' ? 'readonly' : '' %> value="<%= period ? period.financeApprovalDeadline : settings.financeApprovalDeadline %>"></div>
      <div class="automation-field automation-field-wide"><label class="form-label">Salary release date</label><input class="form-control" type="date" name="salaryReleaseDate" required <%= period && period.status !== 'Draft' ? 'readonly' : '' %> value="<%= period ? period.salaryReleaseDate : settings.salaryReleaseDate %>"></div>
    </div>
    <% if (!period || period.status === 'Draft') { %>
      <button class="automation-btn automation-btn-primary" type="submit"><i class="fa-solid fa-check"></i> <%= period ? 'Save Period' : 'Create Period' %></button>
    <% } %>
  </form>

  <% if (period && period.status === 'PayrollUploaded') { %>
    <form method="post" action="<%= automationBasePath %>/period/<%= period.id %>/submit" class="automation-card automation-submit-card">
      <div class="automation-card-heading mb-0">
        <span class="automation-icon"><i class="fa-solid fa-paper-plane"></i></span>
        <div><h3>Submit payroll to Finance</h3><p>The imported records will be validated and locked while Finance reviews the payroll batch.</p></div>
      </div>
      <% if (period.rejectionReason) { %>
        <div class="alert alert-danger"><strong>Finance requested changes:</strong> <%= period.rejectionReason %></div>
      <% } %>
      <div class="automation-field automation-submit-notes">
        <label class="form-label" for="submissionNotes">Notes for Finance (optional)</label>
        <textarea class="form-control" id="submissionNotes" name="notes" rows="3" maxlength="2000" placeholder="Add any context Finance should know before reviewing this payroll."></textarea>
      </div>
      <button class="automation-btn automation-btn-primary" type="submit"><i class="fa-solid fa-paper-plane"></i> Submit to Finance</button>
    </form>
  <% } else if (period && period.status === 'Draft') { %>
    <div class="automation-card automation-workflow-notice">
      <span class="automation-icon"><i class="fa-solid fa-file-arrow-up"></i></span>
      <div><h3>Import payroll records</h3><p>Upload the prepared payroll spreadsheet from Payroll Management. A successful import will move this period to <strong>Payroll Uploaded</strong>.</p></div>
      <a class="automation-btn automation-btn-secondary" href="/payroll">Open Payroll Management</a>
    </div>
  <% } else if (period && period.status === 'PendingApproval') { %>
    <div class="automation-card automation-workflow-notice">
      <span class="automation-icon"><i class="fa-solid fa-hourglass-half"></i></span>
      <div><h3>Awaiting Finance approval</h3><p>This payroll was submitted on <%= period.submittedAt ? new Date(period.submittedAt).toLocaleString('en-SG', { timeZone: 'Asia/Singapore' }) : '—' %>. Payroll records are locked until Finance approves or requests changes.</p></div>
    </div>
  <% } else if (period && period.status === 'Approved') { %>
    <div class="automation-card automation-workflow-notice">
      <span class="automation-icon"><i class="fa-solid fa-money-check-dollar"></i></span>
      <div><h3>Approved for salary release</h3><p>Finance approved this payroll. The period will move to Released automatically after every linked salary is paid.</p></div>
    </div>
  <% } else if (period && period.status === 'Released') { %>
    <form method="post" action="<%= automationBasePath %>/period/<%= period.id %>/close" class="automation-card automation-workflow-notice">
      <span class="automation-icon"><i class="fa-solid fa-circle-check"></i></span>
      <div><h3>Payroll cycle completed</h3><p>All linked salaries have been released. Close this period to archive it and create the next payroll cycle.</p></div>
      <button class="automation-btn automation-btn-primary" type="submit" onclick="return confirm('Close this payroll period? This action cannot be reversed from the normal workflow.')"><i class="fa-solid fa-lock"></i> Close Period</button>
    </form>
  <% } %>

  <form method="post" action="<%= automationBasePath %>/settings" class="automation-card automation-settings-card">
    <div class="automation-card-heading">
      <span class="automation-icon"><i class="fa-solid fa-calendar-days"></i></span>
      <div><h3>Reminder policy</h3><p>Choose how early reminders begin for the active period.</p></div>
    </div>
    <div class="automation-form-grid">
    <div class="automation-field automation-field-wide">
      <label class="form-label">Reminder lead window (days)</label>
      <input class="form-control" type="number" min="0" name="payrollUploadReminderOffsetDays" value="<%= settings.payrollUploadReminderOffsetDays %>">
      <small>Reminders are included when a deadline falls within this window.</small>
    </div>

    </div>

    <button class="automation-btn automation-btn-primary" type="submit"><i class="fa-solid fa-check"></i> Save Settings</button>
  </form>

  <form method="post" action="<%= automationBasePath %>/run" class="automation-card automation-run-card">
    <div class="automation-card-heading mb-0">
      <span class="automation-icon"><i class="fa-solid fa-paper-plane"></i></span>
      <div><h3>Run Reminder Scheduler</h3><p>Trigger the daily reminder process now. Duplicate deliveries will be skipped.</p></div>
    </div>
    <button class="automation-btn automation-btn-primary" type="submit" <%= period ? '' : 'disabled' %>><i class="fa-solid fa-play"></i> Run Scheduler</button>
  </form>

  <div class="automation-card automation-preview-card">
    <div class="automation-card-heading">
      <span class="automation-icon"><i class="fa-solid fa-eye"></i></span>
      <div><h3>Reminder Preview</h3><p>Deadlines currently inside the lead window.</p></div>
    </div>
    <% if (reminderPreview.length) { %>
      <ul>
        <% reminderPreview.forEach((item) => { %>
          <li><strong><%= item.label %></strong>: <%= item.value %> (<%= item.daysUntil %> day(s) away)</li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="automation-empty"><i class="fa-regular fa-calendar-check"></i><p>No reminders are due in the current lead window.</p></div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
